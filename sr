#!/bin/bash
# Host-side entrypoint for building supported versions in one persistent container.
# Select version-specific thirdparty mounts and GCC paths instead of recreating
# the container and interrupting the scheduler or farm. The shared digest cache
# is mounted at /tp; STARROCKS_THIRDPARTY and STARROCKS_GCC_HOME select each build's inputs.
# Users choose dependency versions with -v; their tags follow the latest digest.
# A digest change may require rebasing source code to match updated dependencies.
set -uo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# Keep registry, base-image, apt-mirror, cache-directory, and node settings in the
# untracked srdev.conf; see srdev.conf.example. Synchronize it to /farm for helpers.
# Nonempty per-invocation concurrency overrides take precedence without changing
# site configuration or container/farm identity.
SR_BUILD_OVERRIDES=()
for sr_build_var in SR_LOCAL_JOBS SR_FE_UT_JOBS SR_LINK_JOBS SR_LINK_MEM_GB; do
  [ -z "${!sr_build_var:-}" ] || SR_BUILD_OVERRIDES+=("$sr_build_var=${!sr_build_var}")
done
CONF_FILE=${SR_CONF:-$HERE/srdev.conf}; [ -f "$CONF_FILE" ] && . "$CONF_FILE"
for sr_build_override in ${SR_BUILD_OVERRIDES[@]+"${SR_BUILD_OVERRIDES[@]}"}; do export "$sr_build_override"; done
unset SR_BUILD_OVERRIDES sr_build_var sr_build_override
CONF=${SR_REGISTRIES:-$HERE/registries.conf}
BASE=${BASE:-$HOME}
WORK=${WORK:-$HOME}
CPUS=${CPUS:-16}
MEM=${MEM:-64g}
SR_USER=${SR_USER:-$(id -un)}
SLICE=${SLICE:-srfarm_${SR_USER}.slice}   # Use underscores: systemd interprets a-b.slice as a child of a.slice.
NAME=${SR_USER}_farm
IMG=${IMG:-}   # Default to the build-input content identity; see image_identity.
# Dependency contents are immutable and keyed by digest, so users can share one
# host-wide cache. Fall back to the user's home directory when it is not writable.
SHARED_TP=${SR_TPDIR:-/srv/srdev/thirdparty}
if [ -z "${SR_TPDIR:-}" ] && [ ! -e "$SHARED_TP" ]; then
  ( umask 000; mkdir -p "$SHARED_TP" && chmod 1777 "$SHARED_TP" ) 2>/dev/null || true
else
  mkdir -p "$SHARED_TP" 2>/dev/null || true
fi
TP_FALLBACK_NOTE=""
if [ -d "$SHARED_TP" ] && [ -w "$SHARED_TP" ]; then
  TPDIR=$SHARED_TP
else
  TPDIR=$BASE/thirdparty
  if [ -d "$SHARED_TP" ] && [ ! -w "$SHARED_TP" ]; then
    TP_FALLBACK_NOTE="   (提示：公共依赖目录 $SHARED_TP 不可写，已退回个人目录 ${TPDIR}；多用户共享请由管理员设为 1777 或组可写)"
  fi
fi

# Parse global version options only before the subcommand. After it, -v belongs
# to sr-build's verbose option. Report missing values explicitly instead of
# triggering an unbound-variable error under set -u.
SPEC=""
while [ $# -gt 0 ]; do
  case "$1" in
    -v|--version|-p|--profile)
      [ $# -ge 2 ] || { echo "!! $1 需要一个版本参数" >&2; exit 2; }
      SPEC=$2; shift 2;;
    *) break;;
  esac
done

# A nonempty SR_TP_REPO bypasses registry namespaces and selects this dependency
# repository directly, for example during a publishing outage. Remove the override
# to restore the unchanged registries.conf lookup order.
ns_list(){ if [ -n "${SR_TP_REPO:-}" ]; then echo override; else awk '!/^#/&&NF{print $1}' "$CONF"; fi; }
ns_url(){ [ -n "${SR_TP_REPO:-}" ] && { echo "$SR_TP_REPO"; return 0; }
  [ -f "$CONF" ] || { echo "!! 缺少 $CONF：cp registries.conf.example registries.conf 并填上你的 registry" >&2; return 1; }
  awk -v n="$1" '!/^#/&&$1==n{print $2}' "$CONF"; }
tags_of(){ local ns=$1 u c; u=$(ns_url "$ns"); [ -n "$u" ] || return 1
  c=$BASE/farm/tagcache/$ns-$(printf %s "$u" | md5sum | cut -c1-8).txt; mkdir -p "$(dirname "$c")" 2>/dev/null
  if [ ! -f "$c" ] || [ $(( $(date +%s) - $(stat -c %Y "$c" 2>/dev/null || echo 0) )) -gt 3600 ]; then
    curl -s --max-time 10 "http://${u%%/*}/v2/${u#*/}/tags/list" 2>/dev/null \
      | tr ',' '\n' | grep -oE '"[^"]+"' | tr -d '"' | grep -vE '^(name|tags)$' > "$c.tmp" 2>/dev/null
    [ -s "$c.tmp" ] && mv "$c.tmp" "$c" || rm -f "$c.tmp"
  fi
  cat "$c" 2>/dev/null; }
# Resolve main to latest first, then try X.Y, X.Y-latest, X.Y-ee, X.Y-ee-latest,
# and the newest X.Y-YYYYMMDD tag. Finally, fall back to the highest X.Y.Z patch.
# An optional third argument reuses an already-fetched tag list.
pick_tag(){ local ns=$1 v=$2 t c ve; t=${3:-$(tags_of "$ns")} || return 1; ve=${v//./\\.}
  for c in $([ "$v" = main ] && echo latest) "$v" "$v-latest" "$v-ee" "$v-ee-latest"; do
    grep -qx -- "$c" <<<"$t" && { echo "$c"; return 0; }; done
  c=$(printf '%s\n' "$t" | grep -E "^${ve}-[0-9]{8}$" | sort -r | head -1)
  [ -n "$c" ] && { echo "$c"; return 0; }
  c=$(printf '%s\n' "$t" | grep -E "^${ve}\.[0-9]+$" | sort -V | tail -1)
  [ -n "$c" ] && { echo "$c"; return 0; }; return 1; }
resolve(){ local v=$1 n
  case "$v" in *:*) n=${v%%:*}; v=${v#*:}
      TAG=$(pick_tag "$n" "$v") || return 1; NS=$n; PBASE="$(ns_url "$n"):$TAG"; return 0 ;; esac
  for n in $(ns_list); do
    TAG=$(pick_tag "$n" "$v" 2>/dev/null) && { NS=$n; PBASE="$(ns_url "$n"):$TAG"; return 0; }
  done; return 1; }
# Offer only versions that pick_tag can resolve. Put main first, followed by up
# to eight minor versions in descending order, deduplicated across namespaces.
candidate_versions(){ local n t c
  for n in $(ns_list); do t=$(tags_of "$n" 2>/dev/null) || continue
    for c in main $(printf '%s\n' "$t" | grep -oE '^[0-9]+\.[0-9]+' | sort -Vr | uniq); do
      pick_tag "$n" "$c" "$t" >/dev/null 2>&1 && echo "$c"; done
  done | awk '!seen[$0]++' | sort -Vr | awk '/^main$/{m=1; next} {a[++k]=$0} END{if(m) print "main"; for(i=1; i<=k && i<=8; i++) print a[i]}'; }
# Read the content digest without pulling the image; digest-based directories detect republished tags.
digest_of(){ local img=$1 h repo tag
  h=${img%%/*}; repo=$(echo "${img#*/}" | cut -d: -f1); tag=${img##*:}
  # Advertise Docker and OCI manifest/index types; Docker-only Accept headers can return 404 for OCI images.
  curl -sI --max-time 10 -H "Accept: application/vnd.docker.distribution.manifest.v2+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.oci.image.index.v1+json" \
    "http://$h/v2/$repo/manifests/$tag" 2>/dev/null \
    | grep -i '^docker-content-digest:' | tr -d '\r' | awk '{print $2}'; }   # Return the full sha256 digest; shorten it only for display.

running(){ [ "$(docker inspect -f '{{.State.Running}}' $NAME 2>/dev/null)" = true ]; }
# Determine interactivity from host stdin, forwarding it with -i and SR_TTY=1.
# Container stdin is not itself a TTY with -i alone. Add -t only when stdout is
# also a terminal, so pipelines such as tee receive clean output.
TTY=(); if [ -t 0 ]; then TTY=(-i -e SR_TTY=1); [ -t 1 ] && TTY=(-it -e SR_TTY=1); fi

image_identity(){
  IMAGE_ID=$(python3 "$HERE/files/sr-image-id.py" "$HERE" "${SR_BASE_IMAGE:-}" "${SR_APT_MIRROR:-}") || return 1
  IMG=${IMG:-sr-dev:${IMAGE_ID:0:24}}
}
check_container_version(){
  image_identity || return 1
  local actual
  actual=$(docker exec "$NAME" cat /usr/local/share/sr/image-id 2>/dev/null)
  [ "$actual" = "$IMAGE_ID" ] && return 0
  if [ "${1:-check}" = allow-old ]; then
    echo "   (容器工具版本较旧，本次仅执行状态、停止或维护命令)" >&2
    return 0
  fi
  echo "!! 容器 $NAME 的工具版本与当前 srdev 不一致。为避免混用，已停止本次操作。" >&2
  echo "   先 sr image 构建对应镜像；待构建和服务空闲后 sr down && sr up 切换。" >&2
  return 1
}
build_image(){
  image_identity || return 1
  echo "== 构建单镜像 $IMG（base=${SR_BASE_IMAGE:-Dockerfile 默认}，装 gcc 11/12/13 + 各自的 icecc 工具链包）…"
  BA=(--build-arg APT_MIRROR="${SR_APT_MIRROR:-}" --build-arg SR_IMAGE_ID="$IMAGE_ID"); [ -n "${SR_BASE_IMAGE:-}" ] && BA+=(--build-arg BASE="$SR_BASE_IMAGE")
  docker build -f "$HERE/Dockerfile" "${BA[@]}" -t $IMG "$HERE"; }
# Build a missing image automatically for sr up/build; sr image remains the explicit rebuild command.
ensure_image(){
  image_identity || return 1
  local metadata actual
  metadata=$(docker image inspect -f '{{index .Config.Labels "org.srdev.image-id"}} {{.Id}}' "$IMG" 2>/dev/null)
  read -r actual IMAGE_REF <<< "$metadata"
  if [ "$actual" != "$IMAGE_ID" ]; then
    echo "== 构建匹配当前工具版本的镜像 $IMG"
    build_image || return 1
    metadata=$(docker image inspect -f '{{index .Config.Labels "org.srdev.image-id"}} {{.Id}}' "$IMG") || return 1
    read -r actual IMAGE_REF <<< "$metadata"
    [ "$actual" = "$IMAGE_ID" ] || { echo '!! 镜像标签被其他构建更改，请重试' >&2; return 1; }
  fi
  [ -n "$IMAGE_REF" ]
}
# Synchronize configuration into the directory-mounted /farm on every invocation.
# Single-file bind mounts retain the old inode after an editor replaces a file.
# Publish atomically through a unique mktemp file, avoiding partial concurrent
# writes and precreated symlink attacks. The old /etc/srdev.conf mount is retained
# only for compatibility. Callers must abort if synchronization fails.
sync_conf(){
  if [ ! -f "$CONF_FILE" ]; then
    [ -f "$BASE/farm/srdev.conf" ] && echo "   (提示：$CONF_FILE 不存在，容器仍在用上次同步的 $BASE/farm/srdev.conf)" >&2
    return 0
  fi
  local tmp; tmp=$(mktemp "$BASE/farm/.srdev.conf.XXXXXX" 2>/dev/null) || return 1
  cp -f "$CONF_FILE" "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$BASE/farm/srdev.conf" || { rm -f "$tmp" 2>/dev/null; return 1; }; }
# Convert Docker memory sizes such as 64g to bytes; return empty for unsupported values.
mem_bytes(){ local v=${1:-} n u; n=${v%[a-zA-Z]}; u=${v#"$n"}
  case "$n" in ''|*[!0-9]*) return 1;; esac
  case "$(printf %s "$u" | tr A-Z a-z)" in
    g) echo $(( n * 1073741824 ));; m) echo $(( n * 1048576 ));; k) echo $(( n * 1024 ));; b|'') echo "$n";; *) return 1;; esac; }

# Use docker update to increase configured resource limits without interrupting
# builds or deployed services. Automatic shrinking is unsafe and requires an
# explicit container restart when idle. iceccd -m is a startup setting, so a
# mismatch is reported rather than silently restarting the daemon.
# Convert CPU values such as 16 or 1.5 to nanocpus; invalid values return empty.
cpu_nanos(){ case "${1:-}" in ''|*[!0-9.]*|.*|*.) return 1;; *.*.*) return 1;; esac
  awk -v c="$1" 'BEGIN{ n=c*1000000000; if (n<1) exit 1; printf "%d", n }' 2>/dev/null; }

# Represent cgroup limits as a number, inf for unlimited, or ? for unavailable.
# Unlimited is positive infinity, not an unknown value; replacing it with a finite
# limit is a reduction and must not be mistaken for an automatic increase.
norm_mem(){ case "${1:-}" in max) echo inf;; ''|*[!0-9]*) echo '?';; *) echo "$1";; esac; }
norm_cpu(){ case "${1:-}" in max) echo inf; return;; ''|*[!0-9]*) echo '?'; return;; esac
  case "${2:-}" in ''|*[!0-9]*) echo '?'; return;; esac
  awk -v q="$1" -v p="$2" 'BEGIN{printf "%d", q*1000000000/p}'; }
min_lim(){ { [ "$1" = '?' ] || [ "$2" = '?' ]; } && { echo '?'; return; }
  [ "$1" = inf ] && { echo "$2"; return; }; [ "$2" = inf ] && { echo "$1"; return; }
  [ "$1" -lt "$2" ] && echo "$1" || echo "$2"; }
is_shrink(){ [ "$1" = '?' ] && return 1; [ "$1" = inf ] && return 0; [ "$1" -gt "$2" ]; }
show_g(){ case "$1" in inf) echo 无限制;; '?') echo 读不到;; *) awk -v n="$1" 'BEGIN{printf "%.4g", n/1073741824}';; esac; }
show_c(){ case "$1" in inf) echo 无限制;; '?') echo 读不到;; *) awk -v n="$1" 'BEGIN{printf "%g", n/1000000000}';; esac; }

# Effective limits are the minimum of container and parent-slice cgroup values.
# Read both CPU and memory directly: Docker's HostConfig can already match the
# request even when updating the parent slice failed.
eff_limits(){ local out cm cc cq cp sm sc sq sp
  # Use explicit separators and ? for missing fields; whitespace splitting could
  # otherwise shift a CPU quota into the missing memory-limit field.
  out=$(docker exec $NAME sh -c 'm=$(cat /sys/fs/cgroup/memory.max 2>/dev/null); c=$(cat /sys/fs/cgroup/cpu.max 2>/dev/null); printf "%s|%s\n" "${m:-?}" "${c:-?}"' 2>/dev/null)
  case "$out" in *'|'*) cm=${out%%|*}; cc=${out#*|};; *) cm='?'; cc='?';; esac
  cq=${cc%% *}; cp=${cc#* }
  # Read before assigning a value; an unreadable cpu.max must remain unknown,
  # not inherit an initial max value and be mistaken for unlimited.
  if [ -n "${SLICE:-}" ] && [ -d "/sys/fs/cgroup/$SLICE" ]; then
    sm=$(cat "/sys/fs/cgroup/$SLICE/memory.max" 2>/dev/null); sm=${sm:-?}
    sc=$(cat "/sys/fs/cgroup/$SLICE/cpu.max" 2>/dev/null); sc=${sc:-?}
    sq=${sc%% *}; sp=${sc#* }
  else
    # A missing parent slice imposes no additional limit; treat it as unlimited.
    sm=max; sq=max; sp=""
  fi
  printf '%s %s\n' "$(min_lim "$(norm_mem "$cm")" "$(norm_mem "$sm")")" \
                    "$(min_lim "$(norm_cpu "$cq" "$cp")" "$(norm_cpu "$sq" "$sp")")"; }

resize_if_needed(){
  local wm wc em ec need_m=0 need_c=0
  wm=$(mem_bytes "$MEM") || { echo "!! srdev.conf 里的 MEM=$MEM 认不出来（要像 64g / 4096m），配额未改"; return 0; }
  wc=$(cpu_nanos "$CPUS") || { echo "!! srdev.conf 里的 CPUS=$CPUS 认不出来（要像 16 或 1.5），本次只看内存"; wc=""; }
  read -r em ec < <(eff_limits)
  [ "$em" = '?' ] && { echo "   (读不到容器的有效内存上限，本次不动配额)"; return 0; }
  [ "$em" != "$wm" ] && need_m=1
  [ -n "$wc" ] && [ "$ec" != '?' ] && [ "$ec" != "$wc" ] && need_c=1
  if [ $need_m = 0 ] && [ $need_c = 0 ]; then
    # Report unavailable CPU readings rather than implying that the quota was checked.
    [ -n "$wc" ] && [ "$ec" = '?' ] && echo "   (读不到 CPU 的有效上限，本次没有核对 CPU 配额)"
    return 0
  fi
  # Only increase limits automatically. Shrinking can OOM active builds or services,
  # and a check-then-act idle probe races with new work starting.
  if is_shrink "$em" "$wm" || { [ -n "$wc" ] && [ "$ec" != '?' ] && is_shrink "$ec" "$wc"; }; then
    echo "!! srdev.conf 里的配额比容器当前有效值小（内存 $(show_g "$em")G -> $MEM，CPU $(show_c "$ec") -> ${CPUS} 核）。"
    echo "   调小不会自动执行：它会立刻作用到正在跑的构建和容器里常驻的 FE/BE，可能直接把它们压到 OOM。"
    echo "   确认空闲后用 sr down && sr up 重建容器，那条路径是干净的。"
    return 0
  fi
  # Do not modify an unknown CPU limit: passing --cpus could unknowingly reduce it.
  local cpu_arg=""; [ -n "$wc" ] && [ "$ec" != '?' ] && cpu_arg=1
  [ -n "$wc" ] && [ "$ec" = '?' ] && echo "   (读不到 CPU 的有效上限，本次只改内存，不动 CPU)"
  echo "== 容器配额比 srdev.conf 小，放大（docker update，不重建容器）"
  [ $need_m = 1 ] && echo "   内存 $(show_g "$em")G -> $MEM"
  [ $need_c = 1 ] && echo "   CPU  $(show_c "$ec") 核 -> $CPUS 核"
  if [ -n "$SLICE" ] && command -v systemctl >/dev/null; then
    sudo -n systemctl set-property --runtime "$SLICE" \
      ${cpu_arg:+"CPUQuota=$(awk -v c="$CPUS" 'BEGIN{printf "%d", c*100}')%"} \
      "MemoryMax=$(echo "$MEM" | tr 'gmk' 'GMK')" >/dev/null 2>&1 \
      || echo "   (提示：sudo -n systemctl set-property 没成功；父 slice 上限可能还是旧值，下面回读会看出来)"
  fi
  docker update ${cpu_arg:+--cpus="$CPUS"} --memory="$MEM" --memory-swap="$(( wm * 2 ))" $NAME 2>&1 | sed 's/^/   docker: /'
  # Verify the effective container/parent limits directly, not Docker's recorded settings.
  read -r em ec < <(eff_limits)
  if [ "$em" = "$wm" ]; then echo "   内存已生效（回读有效上限 $(show_g "$wm")G）"
  else echo "   !! 内存没改成：期望 $(show_g "$wm")G，实际有效 $(show_g "$em")G。下次 sr up 还会再试；要彻底解决请 sr down && sr up。"; fi
  if [ -n "$cpu_arg" ]; then
    if [ "$ec" = "$wc" ]; then echo "   CPU 已生效（回读有效 $CPUS 核）"
    else echo "   !! CPU 没改成：期望 $CPUS 核，实际有效 $(show_c "$ec") 核。下次 sr up 还会再试。"; fi
  fi
  # Do not automatically kill iceccd: an idle probe races with new work, and killing
  # the daemon can bypass concurrency limits. Report a stale -m and require an
  # explicit sr down/up when the user can safely restart.
  [ $need_c = 1 ] && echo "   (本机 iceccd 的 -m 是启动参数，仍是旧核数；下次构建会提示，空闲时 sr down && sr up 刷新)"
  return 0; }

# Without an argument, search upward from PWD for the StarRocks root. An explicit
# path must itself be the root. Build dispatch has a separate equivalent helper
# that also distinguishes source paths from option values.
tree_root(){ local d
  if [ -n "${1:-}" ]; then
    [ -f "$1/build.sh" ] && [ -d "$1/be/src" ] && { (cd "$1" && pwd -P); return 0; }; return 1; fi
  d=$(pwd -P); while [ "$d" != / ]; do
    [ -f "$d/build.sh" ] && [ -d "$d/be/src" ] && { echo "$d"; return 0; }; d=$(dirname "$d"); done; return 1; }

# Bind mounts pin directory objects, not path strings. Renaming a host cache
# therefore leaves the container using the original directory even if docker
# inspect still shows the old path. Compare device/inode pairs with the current
# host paths. Cache drift warrants a warning; farm or dependency drift must abort
# because host and container would otherwise use different state or inputs.
# Changing a mount requires explicit container recreation.
check_mounts(){
  local out hi ci p hp fatal=0
  out=$(docker exec $NAME sh -c 'for d in /ccache /farm /tp; do printf "%s %s\n" "$d" "$(stat -c %d:%i "$d" 2>/dev/null || echo -)"; done' 2>/dev/null) || return 0
  while read -r p ci; do
    case "$p" in /ccache) hp=$BASE/ccache;; /farm) hp=$BASE/farm;; /tp) hp=$TPDIR;; *) continue;; esac
    [ "$ci" = - ] && continue
    hi=$(stat -L -c %d:%i "$hp" 2>/dev/null)   # Follow symlinks: Docker mounts their targets.
    [ "$hi" = "$ci" ] && continue
    if [ -z "$hi" ]; then
      echo "!! 容器里的 $p 挂的目录，在宿主机上已经不在 $hp 了（被改名或删了？）。"
    else
      echo "!! 容器里的 $p 不是现在的 $hp（设备:inode $ci vs $hi）——多半是把原目录改名后又新建了一个同名的。"
    fi
    echo "   bind mount 钉的是目录本身，容器仍在用创建时那个目录；要换请空闲时 sr down && sr up 重建容器。"
    case "$p" in /farm|/tp) fatal=1; echo "   $p 关系到配置、农场状态与依赖，两边不一致会让宿主机和容器各说各话，已中止。";; esac
  done <<EOF
$out
EOF
  return $fatal; }

tp_register(){
  mkdir -p "$TPDIR" || return 1
  python3 "$HERE/files/sr-tp-prune.py" register --root "$TPDIR" --farm "$BASE/farm"
}

tp_read_lock(){
  mkdir -p "$TPDIR" || return 1
  { exec 6<"$TPDIR"; } && flock -s 6 || return 1
  python3 "$HERE/files/sr-tp-prune.py" register --root "$TPDIR" --farm "$BASE/farm"
}

ensure_container(){
  local version_policy=${1:-check}
  # Restrict the farm directory to 0700 before writing configuration and before
  # the running-container shortcut. Otherwise another user could precreate a
  # symlink or replace state; refuse to continue if the permission change fails.
  mkdir -p "$BASE/farm" 2>/dev/null
  if [ -d "$BASE/farm" ] && [ "$(stat -L -c %a "$BASE/farm" 2>/dev/null)" != 700 ]; then
    chmod 700 "$BASE/farm" 2>/dev/null || { echo "!! 无法把 $BASE/farm 设为 0700（其他用户可替换 state.env 提权），请先手动 chmod 700 后重试"; return 1; }
    echo "   (已把 $BASE/farm 收紧为 0700)"
  fi
  # Check mounts before sync_conf. If /farm drifted, writing host configuration
  # would update a different directory from the one the container reads.
  if running; then
    check_container_version "$version_policy" || return 1
    check_mounts || return 1
    sync_conf || { echo "!! 同步站点配置到 $BASE/farm/srdev.conf 失败（磁盘满/不可写？）。继续下去容器会按上一次的旧配置干活，已中止。"; return 1; }
    resize_if_needed
    return 0
  fi
  sync_conf || { echo "!! 同步站点配置到 $BASE/farm/srdev.conf 失败（磁盘满/不可写？）。继续下去容器会按上一次的旧配置干活，已中止。"; return 1; }
  ensure_image || { echo "!! 镜像构建失败"; return 1; }
  mkdir -p $BASE/ccache $BASE/m2 $BASE/farm $BASE/.tsp $BASE/iceccrun $TPDIR
  # Use 0700 for farm state so other users cannot replace files later read by
  # container root. The owner can still delete root-created files through directory
  # permissions. Keep iceccrun accessible to the daemon for socket creation; its
  # non-writable directory prevents replacement, while socket access also depends
  # on the enclosing home-directory permissions.
  chmod 700 $BASE/farm 2>/dev/null || echo "!! 无法把 $BASE/farm 设为 0700，请手动 chmod 700（否则其他用户可替换 state.env）"
  # Serialize first startup by container name and recheck under the lock, so a
  # second caller cannot remove a container already doing work. Scope redirection
  # around exec with braces so later stderr output is not permanently suppressed.
  { exec 8>"$BASE/farm/.container.lock"; } 2>/dev/null || { echo "!! 无法打开 $BASE/farm/.container.lock（目录权限？），拒绝在无互斥下起容器"; return 1; }
  flock -w 120 8 || { echo "!! 等待容器启动锁超时（另一个 sr 正在起容器？）"; return 1; }
  if running; then exec 8>&-; check_container_version "$version_policy"; return $?; fi
  local CGP=() CONF_MOUNT=()
  [ -f "$CONF_FILE" ] && CONF_MOUNT=(-v "$CONF_FILE":/etc/srdev.conf:ro)
  if [ -n "$SLICE" ] && command -v systemctl >/dev/null; then
    sudo -n systemctl set-property --runtime "$SLICE" "CPUQuota=$((CPUS*100))%" \
      "MemoryMax=$(echo "$MEM" | tr 'gmk' 'GMK')" >/dev/null 2>&1 && CGP=(--cgroup-parent "$SLICE")
  fi
  docker rm -f $NAME >/dev/null 2>&1
  # --init reaps orphaned children so zombie iceccd processes cannot fool liveness
  # checks and bypass concurrency limits. Set nofile high enough for BE's storage
  # engine and unit tests, which require at least 60000 descriptors.
  docker run -d --name $NAME --init --network host --privileged \
    ${CGP[@]+"${CGP[@]}"} --cpus=$CPUS --memory=$MEM --ulimit nofile=655350:655350 \
    -v $WORK:$WORK -v $BASE/ccache:/ccache -v $BASE/m2:/root/.m2 \
    -v $BASE/farm:/farm -v $BASE/.tsp:/root/.tsp -v $BASE/iceccrun:/var/run/icecc \
    -v $TPDIR:/tp $([ "${TPDIR#$WORK/}" = "$TPDIR" ] && echo "-v $TPDIR:$TPDIR") ${CONF_MOUNT[@]+"${CONF_MOUNT[@]}"} \
    -e SR_USER="$SR_USER" -e SR_UID="$(id -u)" -e SR_OSSCFG="$HOME/.ossutilconfig" -w $WORK "$IMAGE_REF" sleep infinity >/dev/null
  local drc=$?; exec 8>&-   # Release the startup lock as soon as container creation finishes, on success or failure.
  [ $drc = 0 ] || { echo "!! 容器启动失败（docker run 返回非零）"; return 1; }
  echo "== 容器 $NAME 已启动（单容器，编所有版本；限额 ${CPUS}核/${MEM}）"
  # The watchdog dies with its container. Restart it immediately for an existing
  # farm after container recreation, or the unrenewed lease will expire.
  [ -f "$BASE/farm/state.env" ] && docker exec $NAME sr-farm _wd >/dev/null 2>&1 && echo "   看门狗已重新拉起（农场续约恢复）"
  return 0   # Return success even when no farm exists; the preceding conditional chain can otherwise return 1.
}

# Extract an image's thirdparty directory into $TPDIR/<digest> and record its GCC major.
# $1 is repo@sha256:...; every Docker operation uses the digest to avoid moving tags.
# $2 is the full 64-hex directory digest, whose contents are immutable once ready.
# $3 is the resolved tag reference, recorded only as metadata.
ensure_tp(){
  local img=$1 dg=$2 tagname=${3:-$1}
  local d=$TPDIR/$dg
  if [ -f "$d/.ready" ]; then echo "$dg"; return 0; fi
  [ -n "${TP_FALLBACK_NOTE:-}" ] && echo "$TP_FALLBACK_NOTE" >&2
  echo "== 首次使用该镜像的依赖，拉取中（约 7 秒，6~8G）…" >&2
  docker image inspect "$img" >/dev/null 2>&1 || { echo "   拉镜像 $img …" >&2; docker pull -q "$img" >/dev/null 2>&1; }
  # Serialize extraction of the same digest and publish a complete temporary
  # directory atomically. Open shared lock files read-only: O_CREAT on another
  # user's file can fail in a sticky directory under protected_regular.
  local lk="$TPDIR/.lock.$dg"
  [ -e "$lk" ] || ( umask 000; : >>"$lk" ) 2>/dev/null
  chmod 666 "$lk" 2>/dev/null || true
  [ ! -L "$lk" ] || { echo "!! 依赖锁文件异常（符号链接）：$lk" >&2; return 1; }
  # Hold the extraction lock in a subshell so it is released before compilation.
  # Never publish after an extraction, metadata, or compiler-detection failure.
  (
    flock 9 || exit 1
    [ -f "$d/.ready" ] && exit 0   # Another user may have completed extraction while this caller waited for the lock.
    t="$d.tmp.$$"; rm -rf "$t" 2>/dev/null; mkdir -p "$t/installed"
    # Do not remove the destination here: root-owned extracted contents may survive
    # an unprivileged rm, making mv nest the temporary directory inside it. Rename
    # the old destination out of the way during publication instead.
    # Preserve <dir>/installed/... so build.sh finds prebuilt dependencies rather
    # than attempting a thirdparty build. docker run avoids docker cp's large tar stream.
    docker run --rm -v "$t/installed":/dst "$img" cp -a /var/local/thirdparty/installed/. /dst/ >/dev/null 2>&1 \
      || { echo "!! 依赖拉取失败" >&2; rm -rf "$t"; exit 1; }
    # Detect the required GCC major; abort if detection fails rather than guessing 14.
    gv=$(docker run --rm "$img" bash -c 'G=$(ls -d /opt/gcc-toolset-*/bin/gcc 2>/dev/null|sort -V|tail -1); [ -n "$G" ]||G=$(command -v gcc); $G -dumpversion' 2>/dev/null)
    gv=${gv%%.*}; gv=${gv//[!0-9]/}
    [ -n "$gv" ] || { echo "!! 探测不到 $img 的 gcc 版本，不敢默认 14，已中止（检查镜像或重试）" >&2; rm -rf "$t"; exit 1; }
    docker run --rm -v "$t":/dst "$img" bash -c "echo $gv > /dst/.gccmajor; echo $tagname > /dst/.image; echo $img > /dst/.ref; echo sha256:$dg > /dst/.digest; chmod -R a+rX /dst; touch /dst/.ready" >/dev/null 2>&1 \
      || { echo "!! 依赖元数据写入失败，不发布半成品目录，已中止" >&2; rm -rf "$t"; exit 1; }
    # Require both .ready and a numeric .gccmajor before publication.
    { [ -f "$t/.ready" ] && grep -qE '^[0-9]+$' "$t/.gccmajor" 2>/dev/null; } \
      || { echo "!! 依赖目录完整性检查未过（缺 .ready 或 .gccmajor 非数字），已中止" >&2; rm -rf "$t"; exit 1; }
    # Rename an existing destination before moving the new directory into place.
    # In sticky directories, use container root if ownership prevents the rename,
    # ensuring mv cannot accidentally create a nested dependency directory.
    if [ -e "$d" ]; then
      mv -f "$d" "$d.stale.$$" 2>/dev/null \
        || docker run --rm -v "$TPDIR":/tp "$img" sh -c 'mv -f "/tp/$1" "/tp/$1.stale.$2"' _ "$dg" "$$" >/dev/null 2>&1
      [ -e "$d" ] && { echo "!! 无法移开旧依赖目录 $d，中止，不做嵌套发布" >&2; rm -rf "$t"; exit 1; }
    fi
    mv "$t" "$d" || { echo "!! 发布依赖目录失败" >&2; rm -rf "$t"; exit 1; }
    # Use container root to remove stale root-owned contents. Cleanup is optional:
    # report failure but explicitly return success after publication, including when
    # no stale directory exists.
    if [ -d "$d.stale.$$" ]; then
      docker run --rm -v "$TPDIR":/tp "$img" sh -c "rm -rf /tp/$dg.stale.$$" >/dev/null 2>&1 \
        || echo "   (提示：旧目录残留 $d.stale.$$ 未能清理，可稍后手工删；不影响本次依赖)" >&2
    fi
    exit 0
  ) 9<"$lk"
  local rc=$?
  [ $rc = 0 ] && [ -f "$d/.ready" ] && { echo "$dg"; return 0; }
  return 1; }

case "${1:-}" in
image)   build_image ;;   # Explicit image rebuild; normal up/build creates the image only when missing.
ide)     python3 "$HERE/files/sr-vscode.py" "$PWD" "$HERE" /farm/deploy --ide-only ;;
up)      ensure_container && tp_register ;;
down)    docker rm -f $NAME >/dev/null 2>&1; echo "容器已删除（挂载卷保留）" ;;
shell)   ensure_container allow-old && docker exec -it $NAME bash -l ;;
history|log)
  F=$BASE/farm/builds.tsv
  # History is optional before the first completed build; running-build sidecars
  # may already exist. Column 7 records build.sh's exit code, displayed as success
  # or failure; the log path contains details.
  # Align by terminal display width rather than UTF-8 byte count, and choose widths
  # from both headers and data so source/branch names are not truncated.
  # A running build writes /farm/sr-build.<md5>.run with history fields, start time,
  # and temporary log/sample paths. Check its source lock, not its PID: an available
  # lock identifies a stale sidecar left by SIGKILL. Fetch progress and memory data
  # from container /tmp through docker exec; omit running rows if the container is absent.
  RUNNING=$(docker exec $NAME sh -c '
    T=$(printf "\t")
    for f in /farm/sr-build.*.run; do
      [ -f "$f" ] || continue
      lk=${f%.run}.lock
      # Check liveness and remove stale sidecars while holding the lock. Releasing
      # it first could let a new build publish a sidecar that this cleanup then deletes.
      if flock -n 9 -c "rm -f \"$f\"" 9<>"$lk" 2>/dev/null; then continue; fi
      IFS=$T read -r st user tree ver mode n tgt s outf anonf phase < "$f" || continue
      case "$s" in ""|*[!0-9]*) continue;; esac
      el=$(( $(date +%s) - s ))
      prog=$(grep -oE "^\[[0-9]+/[0-9]+\]" "$outf" 2>/dev/null | tail -1 | tr -d "[]"); [ -n "$prog" ] && n=$prog
      pk=$(cat "$anonf" 2>/dev/null); case "$pk" in ""|*[!0-9]*) pk="?";; *) pk=$(awk -v n="$pk" "BEGIN{printf \"%.1fG\", n/1073741824}");; esac
      printf "%s\t%s\t%s\t%s\t%s\t%s\tR\t%dm%02ds\t%s\t-\t%s\t%s\t%s\n" "$st" "$user" "$tree" "$ver" "$mode" "$n" $((el/60)) $((el%60)) "$pk" "$outf" "$tgt" "${phase:-}"
    done' 2>/dev/null)
  [ -s "$F" ] || [ -n "$RUNNING" ] || { echo "还没有编译记录"; exit 0; }
  { [ -f "$F" ] && tail -n "${2:-20}" "$F"; [ -n "$RUNNING" ] && printf '%s\n' "$RUNNING"; } | LC_ALL=C awk -F'\t' '
    function dw(s,  n,t){ n=length(s)
      t=s; n-=gsub(/[\xc0-\xdf]/,"",t)
      t=s; n-=gsub(/[\xe0-\xef]/,"",t)
      t=s; n-=2*gsub(/[\xf0-\xf7]/,"",t)
      return n }
    function pad(s,w,  k){ k=w-dw(s); if(k<=0) return s; return s sprintf("%" k "s","") }
    BEGIN{ h[1]="时间"; h[2]="用户"; h[3]="源码树@分支"; h[4]="版本"; h[5]="目标"; h[6]="模式"
           h[7]="边数"; h[8]="结果"; h[9]="用时"; h[10]="anon峰"; h[11]="命中/编译"
           NC=11
           cap[3]=64 }   # Only this column may be very long; short names still use their actual width.
                          # Mark truncation with .. and truncate ASCII only to avoid splitting UTF-8 characters.
    { n++
      # Target is field 12; infer it from legacy UT*/FEUT mode prefixes when absent.
      tgt=$12
      if(tgt==""){ if($5 ~ /^UT/) tgt="be-ut"; else if($5=="FEUT") tgt="fe-ut"; else tgt="?" }
      md=$5; sub(/^UT/,"",md); if(md=="FEUT") md="本地"
      v[1]=$1; v[2]=$2; v[3]=$3; v[4]=$4; v[5]=tgt; v[6]=md
      v[7]=$6; v[8]=($7=="R"?("运行中" ($13!=""?"·" $13:"")):($7==0?"成功":"失败")); v[9]=$8; v[10]=$9; v[11]=$10
      run[n]=($7=="R")
      for(i=1;i<=NC;i++){ c=v[i]
        if((i in cap) && dw(c)>cap[i] && length(c)==dw(c)) c=substr(c,1,cap[i]-2) ".."
        cell[n,i]=c; if(dw(c)>w[i]) w[i]=dw(c) } }
    END{ for(i=1;i<=NC;i++) if(dw(h[i])>w[i]) w[i]=dw(h[i])
         line=""; for(i=1;i<=NC;i++) line=line (i>1?" ":"") (i==NC?h[i]:pad(h[i],w[i])); print line
         sep=0
         for(j=1;j<=n;j++){ if(run[j] && !sep){ print "── 运行中（时间=本阶段开始时刻，用时=已运行）──"; sep=1 }
           line=""
           for(i=1;i<=NC;i++) line=line (i>1?" ":"") (i==NC?cell[j,i]:pad(cell[j,i],w[i])); print line } }' ;;
pack)
  # Package output/ in the official layout: a top-level tree-shortsha[-dirty]
  # directory containing BE/FE, optional broker files, and LICENSE/NOTICE.
  # Uploading large objects requires explicit --upload; bucket/prefix come only
  # from site configuration.
  shift
  P_UP=0; P_FORCE=0; P_NAME=""; P_OUT=${SR_PKG_DIR:-$BASE/pkg}; P_SRC=""; P_LEVEL=${SR_PKG_LEVEL:-6}; P_JOBS=${SR_PKG_JOBS:-16}
  while [ $# -gt 0 ]; do case "$1" in
    --upload) P_UP=1; shift;;
    --force)  P_FORCE=1; shift;;
    --name)   [ $# -ge 2 ] || { echo "!! --name 需要一个包名" >&2; exit 2; }; P_NAME=$2; shift 2;;
    --out)    [ $# -ge 2 ] || { echo "!! --out 需要一个目录" >&2; exit 2; }; P_OUT=$2; shift 2;;
    -h|--help) cat <<'PU'
用法: sr pack [源码目录] [选项]      （不给目录就从当前目录上溯找源码树）
  把该树的 output/ 打成 <树名>-<短sha>[-dirty].tar.gz，布局与官方日构建包一致
  --upload        打完上传到 srdev.conf 里配的 SR_PKG_BUCKET/SR_PKG_PREFIX（不给就只打包）
  --force         允许覆盖同名的本地文件与远端对象
  --name NAME     自定义包名（同时决定包内顶层目录名）
  --out DIR       本地输出目录（默认 $SR_PKG_DIR 或 ~/pkg）
PU
      exit 0;;
    *) if [ -d "$1" ] && [ -z "$P_SRC" ]; then P_SRC=$1; shift
       else echo "未知参数: $1"; exit 1; fi;;
  esac; done
  PSR=$(tree_root ${P_SRC:+"$P_SRC"}) || { echo "!! 当前目录不在任何 StarRocks 源码树里，也没给出有效的源码目录"; exit 1; }
  POUTD=$PSR/output
  [ -d "$POUTD" ] || { echo "!! $POUTD 不存在。先 sr build 产出 be/ 与 fe/ 再来打包。"; exit 1; }
  { [ -d "$POUTD/be" ] || [ -d "$POUTD/fe" ]; } || { echo "!! $POUTD 下既没有 be/ 也没有 fe/，不像编译产物"; exit 1; }
  if [ -z "$P_NAME" ]; then
    PSHA=$(git -C "$PSR" rev-parse --short HEAD 2>/dev/null || echo nogit)
    # Mark uncommitted source changes in the package name so deployed artifacts are not mistaken for clean CI builds.
    [ -n "$(git -C "$PSR" status --porcelain 2>/dev/null)" ] && PDIRTY=-dirty || PDIRTY=""
    P_NAME="$(basename "$PSR")-${PSHA}${PDIRTY}"
  fi
  # Restrict names used in tar's sed replacement: '&' expands to the matched text
  # and '|' terminates the delimiter, so accepting them would corrupt the archive layout.
  case "$P_NAME" in
    ''|.|..) echo "!! 包名不能为空，也不能是 . 或 ..：$P_NAME"; exit 1;;
    -*) echo "!! 包名不能以 - 开头：$P_NAME"; exit 1;;
    *[!A-Za-z0-9._-]*) echo "!! 包名只允许字母数字和 . _ -（它要当 tar 替换串和目录名）：$P_NAME"; exit 1;;
  esac
  # Validate upload prerequisites before spending time compressing the package.
  PURL=""
  if [ $P_UP = 1 ]; then
    [ -n "${SR_PKG_BUCKET:-}" ] || { echo "!! 没配 SR_PKG_BUCKET，不知道往哪个桶传。在 srdev.conf 里配上桶名与前缀再试。"; exit 1; }
    command -v ossutil >/dev/null || { echo "!! 宿主机上没有 ossutil，装好并 ossutil config 之后再试"; exit 1; }
    case "${SR_PKG_PREFIX:-}" in ''|*/) ;; *) echo "!! SR_PKG_PREFIX 要以 / 结尾：${SR_PKG_PREFIX}"; exit 1;; esac
    PURL="oss://$SR_PKG_BUCKET/${SR_PKG_PREFIX:-}$P_NAME.tar.gz"
    if ossutil stat "$PURL" >/dev/null 2>&1; then
      [ $P_FORCE = 1 ] || { echo "!! 远端已有同名对象 $PURL（--force 覆盖）"; exit 1; }
      echo "   远端已有同名对象，--force 覆盖"
    fi
  fi
  mkdir -p "$P_OUT" 2>/dev/null || { echo "!! 建不了输出目录 $P_OUT"; exit 1; }
  PTGZ=$P_OUT/$P_NAME.tar.gz
  # Hold the same source-tree lock as sr-build for the entire packaging operation;
  # ninja install copies files incrementally, so output may otherwise be incomplete.
  # Always create the lock file, require flock, and scope exec redirection with
  # braces to preserve subsequent diagnostics.
  PLOCK=$BASE/farm/sr-build.$(printf %s "$PSR" | md5sum | cut -c1-12).lock
  command -v flock >/dev/null || { echo "!! 没有 flock，无法与构建互斥；这时候打包可能得到半装好的 output/，已拒绝。"; exit 1; }
  : > "$PLOCK" 2>/dev/null || [ -e "$PLOCK" ] || { echo "!! 建不了源码树锁 $PLOCK"; exit 1; }
  chmod 666 "$PLOCK" 2>/dev/null
  { exec 9>>"$PLOCK"; } 2>/dev/null || { echo "!! 打不开源码树锁 $PLOCK"; exit 1; }
  flock -n 9 || { echo "!! 这棵源码树正在编译：$PSR"
    echo "   ninja install 是逐文件拷贝，这时候打包会得到半装好的 output/。等它编完再来。"; exit 1; }
  # Lock each destination across existence checks and publication. Use a unique
  # temporary file so concurrent pack commands cannot truncate each other's data.
  { exec 7>>"$PTGZ.lock"; } 2>/dev/null || { echo "!! 建不了 $PTGZ.lock（输出目录不可写？）"; exit 1; }
  flock -n 7 || { echo "!! 另一个 sr pack 正在生成同名包 $PTGZ"; exit 1; }
  [ -e "$PTGZ" ] && [ $P_FORCE = 0 ] && { echo "!! $PTGZ 已存在（--force 覆盖）"; exit 1; }
  PNEED=$(du -sk "$POUTD" 2>/dev/null | cut -f1); PFREE=$(df -Pk "$P_OUT" | awk 'NR==2{print $4}')
  [ "${PFREE:-0}" -lt "${PNEED:-0}" ] && { echo "!! $P_OUT 所在盘剩余 $((PFREE/1048576))G，产物 $((PNEED/1048576))G，空间可能不够，已中止（--out 换个盘）"; exit 1; }
  PPART=$(mktemp "$P_OUT/.$P_NAME.XXXXXX.part") || { echo "!! 建不了临时文件"; exit 1; }
  PERR=$(mktemp /tmp/sr-pack-tarerr.XXXXXX)
  trap 'rm -f "$PPART" "$PERR" 2>/dev/null' EXIT
  echo "== 打包 $PSR/output -> $PTGZ"
  echo "   包内顶层目录: $P_NAME/    内容: $(ls "$POUTD" | tr '\n' ' ')"
  [ -n "$PURL" ] && echo "   上传目标: $PURL"
  echo "   压缩: pigz -$P_LEVEL -p$P_JOBS（产物 $(du -sh "$POUTD" | cut -f1)，需要几分钟）"
  PS0=$(date +%s)
  # flags=r transforms archive member names without rewriting symlink targets.
  # Check both tar and pigz exit codes before publishing, and retain tar's error
  # output so truncated archives or compression failures cannot appear successful.
  tar -C "$PSR" --transform "flags=r;s|^output|$P_NAME|" -cf - output 2>"$PERR" | pigz -"$P_LEVEL" -p"$P_JOBS" > "$PPART"
  PRC=("${PIPESTATUS[@]}")
  if [ "${PRC[0]}" != 0 ] || [ "${PRC[1]}" != 0 ]; then
    echo "!! 打包失败：tar rc=${PRC[0]}  pigz rc=${PRC[1]}"
    [ -s "$PERR" ] && sed 's/^/   tar: /' "$PERR" | head -10
    exit 1
  fi
  mv -f "$PPART" "$PTGZ" || { echo "!! 发布 $PTGZ 失败"; exit 1; }
  PSIZE=$(stat -c %s "$PTGZ" 2>/dev/null)
  echo "   完成: $(du -h "$PTGZ" | cut -f1)  用时 $(( ($(date +%s)-PS0)/60 ))m$(( ($(date +%s)-PS0)%60 ))s"
  [ $P_UP = 0 ] && { echo "   （只打包。要上传加 --upload）"; exit 0; }
  echo "== 上传 -> $PURL"
  # Check ossutil's own exit status before comparing remote and local sizes;
  # a pipeline ending in tail or an old same-name object must not mask upload failure.
  ossutil cp "$PTGZ" "$PURL" 2>&1 | tail -3; URC=${PIPESTATUS[0]}
  [ "$URC" = 0 ] || { echo "!! 上传失败（ossutil rc=$URC），远端对象未更新或不完整"; exit 1; }
  RSIZE=$(ossutil stat "$PURL" 2>/dev/null | awk -F': *' '/Content-Length/{print $2; exit}' | tr -d ' \r')
  if [ -n "$PSIZE" ] && [ "$RSIZE" = "$PSIZE" ]; then
    echo "   已上传并核对：远端 Content-Length = 本地 $PSIZE 字节"
  else
    echo "!! 上传后核对不上：本地 ${PSIZE:-?} 字节，远端 ${RSIZE:-读不到}。请重传。"; exit 1
  fi
  ;;
