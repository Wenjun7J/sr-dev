        printf "%-14s %-8s %-7s %-6s %s\n" "${n:0:12}" "$(cat "$d/.gccmajor" 2>/dev/null || echo ?)" \
          "$(du -sh "$d" 2>/dev/null|cut -f1)" "$([ -f "$d/.ready" ] && echo 就绪 || echo 不完整)" \
          "$([ ${#n} -lt 64 ] && echo '(旧格式目录，确认无人使用后可删)' || cat "$d/.image" 2>/dev/null)"
      done ;;
    *) echo "!! 未知 tp 子命令：$1（用 sr tp --help 查看）" >&2; exit 2 ;;
  esac ;;
versions)
  [ -n "${SR_TP_REPO:-}" ] && echo "(SR_TP_REPO 生效：忽略 registries.conf，一律用 $SR_TP_REPO)"
  for n in $(ns_list); do
    echo "[$n] $(ns_url "$n")"
    tags_of "$n" | grep -E '^(latest$|main|[0-9]+\.[0-9]+)' | sort -Vr | head -12 | paste -sd' ' - | fold -sw 110 | sed 's/^/  /'
  done ;;
""|-h|--help|help) cat <<U
用法: sr [-v <版本>] <子命令>
  首次: cp srdev.conf.example srdev.conf; cp registries.conf.example registries.conf; 然后直接 sr -v main build

  up                 起容器（没镜像会先自动构建；单个容器编所有版本）。
                     改完 srdev.conf 里的 CPUS/MEM 后跑一次 sr up 即可热更新配额，不用重建容器
  image              强制重建镜像（改了 Dockerfile 之后用）
  ide                为当前 worktree 配置用户自己的 clangd 入口（保留已有自定义设置）
  build [目录] [选项] 编译（默认 BE+FE；--be / --fe 单选）。首次会询问依赖版本（或用 -v 指定），之后记住；换版本再 -v
  be-ut [选项]        编 BE 单测（默认 ASAN，走农场+ccache）并接着跑；sr 不认识的参数原样交给 run-be-ut.sh，
                     如 sr be-ut --test CompactionUtilsTest / --gtest_filter 'A*:B*' / --module storage
                     （只编不跑加 --no-run）
  fe-ut [选项]        跑 FE 单测（run-fe-ut.sh，纯 maven，农场/ccache 不参与）；参数同样原样透传，
                     如 sr fe-ut --test com.starrocks.utframe.Demo / --filter X / --dry-run
  compdb [目录]       只生成 compile_commands.json 给 clangd 用，不编译（实测 14 秒）。用独立构建树，
                     不影响真实产物；完事把源码树根的软链接指过去。默认 Release，--debug/--asan 可改
  farm {init|status|usage [--watch [秒]]|rebalance|resume|suspend|down}
  tp                 列出已拉下来的各版本依赖（全机共享目录）
  tp prune           预览旧依赖缓存；空闲时加 --yes 删除（需 sudo），详见 sr tp --help
  deploy [选项]      在项目下执行：用该项目的产物部署/替换唯一一套单节点集群（FE+BE，跑在容器里）
                     自动开启 FE JDWP、建立 BE LLDB 入口并补齐 FE/BE 调试配置
                     已有集群在跑就先停再换。--status 看状态，--stop 停，--clean-data 连数据一起重建，--fe-heap 改 FE 堆（默认 2g）
  pack [目录] [选项]  把该树 output/ 打成与官方日构建同构的 tar.gz；--upload 传到 srdev.conf 配的 OSS 桶
  history [N]        最近 N 次编译概况（默认 20）
  versions           列出 registry 里可用的版本
  shell / down

版本用 -v 显式指定，例：sr -v main build   sr -v 4.1 build   sr -v 3.5.20 build
指定一次后这棵源码树的这个分支会记住，并自动跟随该版本的最新依赖镜像；
digest 变了会提示（若报依赖相关错误，先 rebase 代码）。换版本用 -v 重新指定。
U
;;
*)
  # Help and default explanations need no container, registry, or thirdparty, even
  # outside a source tree or offline. Honor -- and option values so forwarded
  # arguments such as -- --help are not intercepted.
  case "$1" in
    build|be-ut|fe-ut|compdb|ccdb)
      PREVIEW_ARGS=("$@")
      case "$1" in
        build) PREVIEW_ARGS=("${PREVIEW_ARGS[@]:1}");;
        be-ut) PREVIEW_ARGS=(--be-ut "${PREVIEW_ARGS[@]:1}");;
        fe-ut) PREVIEW_ARGS=(--fe-ut "${PREVIEW_ARGS[@]:1}");;
        compdb|ccdb) PREVIEW_ARGS=(--compdb "${PREVIEW_ARGS[@]:1}");;
      esac
      skipv=0
      for a in "${PREVIEW_ARGS[@]}"; do
        [ $skipv = 1 ] && { skipv=0; continue; }
        case "$a" in
          --) break;;
          --build-prefix|--dist) skipv=1;;
          -h|--help|--why) exec "$HERE/files/sr-build" "${PREVIEW_ARGS[@]}";;
        esac
      done
      ;;
  esac
  VERSION_POLICY=check
  case "$1:${2:-}" in deploy:--status|deploy:--stop|deploy:--help|deploy:-h|farm:status|farm:down|farm:suspend|farm:--help|farm:-h|farm:help) VERSION_POLICY=allow-old;; esac
  ensure_container "$VERSION_POLICY" || exit 1
  sub=$1; shift
  # sr be-ut forwards to sr build --be-ut and runs tests after compilation by
  # default. Do not inject --run; use --no-run for compilation only.
  case "$sub" in be-ut) sub=build; set -- --be-ut "$@";; esac
  # sr fe-ut forwards to sr build --fe-ut: Maven only, without farm or ccache usage.
  [ "$sub" = fe-ut ] && { sub=build; set -- --fe-ut "$@"; }
  # sr compdb forwards to sr build --compdb and generates compile_commands.json without compiling.
  case "$sub" in compdb|ccdb) sub=build; set -- --compdb "$@";; esac
  case "$sub" in
    build)
      # Pure FE targets (--fe/--fe-ut) must not read, resolve, or lock BE thirdparty dependencies.
      HOST_TARGET=all; skipv=0
      for a in "$@"; do
        [ $skipv = 1 ] && { skipv=0; continue; }
        case "$a" in
          --) break;;
          --build-prefix|--dist) skipv=1;;
          --be) HOST_TARGET=be;;
          --fe|--fe-ut) HOST_TARGET=fe;;
          --all) HOST_TARGET=all;;
          --be-ut) HOST_TARGET=ut;;
          --compdb) HOST_TARGET=compdb;;
        esac
      done
      NEED_TP=1; [ "$HOST_TARGET" = fe ] && NEED_TP=0
      # Remember versions per physical source tree and branch. Match sr-build's path
      # parser: stop at --, skip option values, and require an explicit path to be a
      # source root; otherwise search upward from PWD.
      # Do not mistake forwarded directories or unit-test option values such as
      # --module storage for source roots. In test mode, a positional directory must
      # contain build.sh to qualify.
      UTM=0; for a in "$@"; do [ "$a" = -- ] && break
        case "$a" in --be-ut|--fe-ut) UTM=1; break;; esac; done
      TSTART=""; skipv=0
      for a in "$@"; do
        [ $skipv = 1 ] && { skipv=0; continue; }
        case "$a" in --) break;; --dist|--build-prefix) skipv=1;; -*) ;;
          *) if [ -d "$a" ] && { [ "$UTM" = 0 ] || [ -f "$a/build.sh" ]; }; then TSTART=$(cd "$a" && pwd -P); break; fi;;   # Use physical paths so symlinks and their targets share one key.
        esac
      done
      root_of(){ local d
          if [ -n "$TSTART" ]; then [ -f "$TSTART/build.sh" ] && [ -d "$TSTART/be/src" ] && { echo "$TSTART"; return 0; }; return 1; fi
          d=$(pwd -P); while [ "$d" != / ]; do   # Resolve symlinks to the same physical source tree.
          [ -f "$d/build.sh" ] && [ -d "$d/be/src" ] && { echo "$d"; return 0; }; d=$(dirname "$d"); done; return 1; }
      WROOT=$(root_of || true); PDIR=$BASE/farm/versions; KEY=""; BR="?"
      if [ -n "$WROOT" ]; then
        BR=$(git -C "$WROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo ?)
        [ "$BR" = HEAD ] && BR=$(git -C "$WROOT" describe --tags --abbrev=0 2>/dev/null || echo HEAD)
        KEY=$(printf %s "$WROOT@$BR" | md5sum | cut -c1-12)
      fi
      if [ "$NEED_TP" = 0 ]; then
        XENV=(); for v in CCACHE_REMOTE_STORAGE SR_CCACHE_DIR SR_EXPLAIN MAVEN_OPTS SR_LOCAL_OK SR_DRYRUN FARM_STATE SR_FE_UT_JOBS SR_LOCAL_JOBS SR_LINK_JOBS SR_LINK_MEM_GB SR_BUILD_PREFIX SR_EXTRA_CMAKE_ARGS SR_DYNLIB_PCH; do [ -n "${!v:-}" ] && XENV+=(-e "$v"); done
        exec docker exec -w "$PWD" -e SR_TPDIGEST=- -e SR_VER=- -e SR_BRANCH="${BR:-?}" \
          ${XENV[@]+"${XENV[@]}"} ${TTY[@]+"${TTY[@]}"} $NAME sr-build "$@"
      fi
      tp_read_lock || exit 1
      if [ -z "$SPEC" ] && [ -n "$KEY" ] && [ -f "$PDIR/$KEY" ]; then
        SPEC=$(cut -d' ' -f1 "$PDIR/$KEY")
        echo "(依赖=$SPEC · $(basename "${WROOT:-?}")@${BR:-?}，你之前指定过；换用 -v)" >&2
      fi
      # For an interactive first build without -v, ask for a dependency version and
      # remember a successful resolution. Show available versions only after invalid
      # input. Never infer dependencies from branch names; noninteractive calls require -v.
      if [ -z "$SPEC" ]; then
        if [ -t 0 ]; then   # Check stdin only so piped stdout still permits input; send prompts to stderr.
          echo "首次编译 $(basename "${WROOT:-?}")@${BR:-?}：需要指定依赖版本（对应官方 dev-env 镜像；之后会记住，换版本用 sr -v <版本> build）" >&2
          while :; do
            read -r -p "请输入依赖版本（如 main 或 4.0）: " ans
            [ -n "$ans" ] || { echo "!! 未输入版本，已取消" >&2; exit 1; }
            resolve "$ans" 2>/dev/null && { SPEC=$ans; break; }
            echo "!! 找不到 $ans 对应的依赖镜像。当前能解析的有：$(candidate_versions | paste -sd' ' -)；也可输入 3.5.20 这样的具体版本" >&2
          done
          echo "   已选 $SPEC（记住到这棵树的这个分支；换版本: sr -v <版本> build）"
        else
          echo "!! 首次编译需指定依赖版本，例: sr -v main build（sr versions 看可选项；交互终端下会弹出选择）"; exit 1
        fi
      fi
      resolve "$SPEC" || { echo "!! 找不到版本 $SPEC，sr versions 看可选项"; exit 1; }
      DGFULL=$(digest_of "$PBASE"); [ -n "$DGFULL" ] || { echo "!! 拿不到 $PBASE 的 digest"; exit 1; }
      DG=${DGFULL#sha256:}; DGS=${DG:0:12}       # Use the full digest for directory names and 12 characters for display.
      REF="${PBASE%:*}@$DGFULL"                 # Address images by digest; %:* removes the final tag without stripping a registry port.
      echo "   依赖镜像 $PBASE  digest=$DGS$([ -n "${SR_TP_REPO:-}" ] && echo "  (SR_TP_REPO 强制，忽略 ee/os 命名空间)")"
      # Follow the selected upstream tag, but report digest changes so users can
      # rebase source code if updated dependencies require matching source changes.
      if [ -n "$KEY" ] && [ -f "$PDIR/$KEY" ]; then
        OLD_DG=$(cut -d' ' -f2 "$PDIR/$KEY" 2>/dev/null)
        if [ -n "$OLD_DG" ] && [ "${OLD_DG:0:12}" != "${DG:0:12}" ]; then   # Older records may contain 12-character digests; compare prefixes.
          echo "   注意：上游 $SPEC 的依赖镜像已更新（${OLD_DG:0:12} -> $DGS），本次用新的。"
          echo "         若编译报依赖相关错误，先把代码 rebase 到最新再试。"
        fi
      fi
      ensure_tp "$REF" "$DG" "$PBASE" >/dev/null || exit 1
      GMAJ=$(cat "$TPDIR/$DG/.gccmajor" 2>/dev/null | cut -d. -f1); GMAJ=${GMAJ:-14}
      GHOME=/opt/gcc$GMAJ
      # GCC 14 lives at /opt/gcc-toolset-14. Refuse a missing required compiler rather
      # than substituting GCC 13: matching a compiler to its icecc archive would not
      # detect that both differ from the dependency image's requirement.
      [ "$GMAJ" = 14 ] && GHOME=$(docker exec $NAME sh -c 'ls -d /opt/gcc-toolset-14 2>/dev/null' || true)
      [ -n "$GHOME" ] || { echo "!! 镜像里找不到 gcc$GMAJ（依赖 $DGS 要求 gcc$GMAJ）。请 sr image 重建镜像后重试。"; exit 1; }
      # Verify the compiler's actual major version, not just its directory name.
      GREAL=$(docker exec $NAME sh -c "$GHOME/bin/gcc -dumpversion 2>/dev/null" | cut -d. -f1)
      [ "$GREAL" = "$GMAJ" ] || { echo "!! $GHOME 里的 gcc 实际是 ${GREAL:-未知} 版，依赖 $DGS 要求 $GMAJ 版。"
                                  echo "   用错编译器的产物 ABI 不一致且不会报错，已中止。请 sr image 重建镜像。"; exit 1; }
      # Bind selected dependencies to /var/local/thirdparty in a private mount namespace.
      # CMakeCache stores absolute FILEPATH values from initial configuration, so actual
      # builds require a stable canonical path even when their digest changes.
      # Forward optional cache, Maven, interactivity, and test settings explicitly.
      # Concurrency settings normally come from /farm/srdev.conf; the environment
      # allowlist also permits temporary per-build overrides such as SR_FE_UT_JOBS=6.
      XENV=(-e "SR_VERSION_KEY=$KEY" -e "SR_TPDIGEST_FULL=$DG"); for v in CCACHE_REMOTE_STORAGE SR_CCACHE_DIR SR_EXPLAIN MAVEN_OPTS SR_LOCAL_OK SR_DRYRUN FARM_STATE SR_FE_UT_JOBS SR_LOCAL_JOBS SR_LINK_JOBS SR_LINK_MEM_GB SR_BUILD_PREFIX SR_EXTRA_CMAKE_ARGS SR_DYNLIB_PCH; do [ -n "${!v:-}" ] && XENV+=(-e "$v"); done
      # For compdb, use the dependency's real host path at $TPDIR/<digest> instead of
      # a bind mount. clangd resolves absolute paths from the compilation database, and
      # VS Code opens those files on the host; both sides must address the same digest.
      # Real builds still use the canonical bind path because CMake caches absolute
      # paths across subsequent configurations.
      CDB=0; for a in "$@"; do [ "$a" = -- ] && break; [ "$a" = --compdb ] && { CDB=1; break; }; done
      if [ "$CDB" = 1 ] && docker exec $NAME test -d "$TPDIR/$DG/installed" 2>/dev/null; then
        exec docker exec -w "$PWD" \
          -e STARROCKS_THIRDPARTY="$TPDIR/$DG" -e STARROCKS_GCC_HOME="$GHOME" -e SR_TPDIGEST="$DGS" -e SR_VER="$SPEC" -e SR_BRANCH="${BR:-?}" \
          ${XENV[@]+"${XENV[@]}"} ${TTY[@]+"${TTY[@]}"} $NAME sr-build "$@"
      fi
      [ "$CDB" = 1 ] && echo "   (容器里看不到 $TPDIR，compdb 退回 bind 挂载：跳转到第三方头文件时 VSCode 会打开宿主机上那份旧拷贝。空闲时 sr down && sr up 重建容器即可修好)"
      docker exec -w "$PWD" \
        -e STARROCKS_THIRDPARTY=/var/local/thirdparty -e STARROCKS_GCC_HOME="$GHOME" -e SR_TPDIGEST="$DGS" -e SR_VER="$SPEC" -e SR_BRANCH="${BR:-?}" \
        ${XENV[@]+"${XENV[@]}"} ${TTY[@]+"${TTY[@]}"} $NAME unshare -m --propagation private sh -c \
          'mount --bind "/tp/$0/installed" /var/local/thirdparty/installed && exec sr-build "$@"' "$DG" "$@" ;;
    farm) docker exec ${TTY[@]+"${TTY[@]}"} $NAME sr-farm "$@" ;;
    # Pass the host cwd to deploy so it finds the intended source tree and its build outputs.
    deploy)
      docker exec -w "$PWD" -e SR_UID="$(id -u)" -e SR_DEPLOY_DIR="${SR_DEPLOY_DIR:-/farm/deploy}" \
        -e SR_FE_DEBUG_PORT="${SR_FE_DEBUG_PORT:-}" -e SR_PORT_BASE="${SR_PORT_BASE:-}" \
        ${TTY[@]+"${TTY[@]}"} $NAME sr-deploy "$@"
      DRC=$?; [ "$DRC" = 0 ] || exit "$DRC"
      # Write IDE configuration and entrypoints as the host user, avoiding root-owned files or the container HOME.
      VSCODE=1; VBE=1; VFE=1; VARGS=()
      for a in "$@"; do
        case "$a" in
          --status|--stop|-h|--help) VSCODE=0;;
          --fe-only) VBE=0;; --be-only) VFE=0;;
        esac
      done
      if [ "$VSCODE" = 1 ]; then
        [ "$VBE" = 0 ] && VARGS+=(--no-be)
        if [ "$VFE" = 1 ]; then
          VPORT=$(docker exec "$NAME" cat "${SR_DEPLOY_DIR:-/farm/deploy}/.fe-debug-port" 2>/dev/null) || VPORT=""
          [[ "$VPORT" =~ ^[1-9][0-9]{0,4}$ ]] && VARGS+=(--fe-port "$VPORT")
        fi
        python3 "$HERE/files/sr-vscode.py" "$PWD" "$HERE" "${SR_DEPLOY_DIR:-/farm/deploy}" ${VARGS[@]+"${VARGS[@]}"} \
          || echo '!! 产物部署已完成，但 VS Code 调试配置未就绪，请检查上方错误。' >&2
      fi ;;
    *) if docker exec $NAME sh -c "command -v \"\$1\"" _ "$sub" >/dev/null 2>&1; then
         docker exec ${TTY[@]+"${TTY[@]}"} $NAME "$sub" "$@"
       else echo "未知子命令: $sub"; exec "$0" --help; fi ;;
  esac ;;
esac
