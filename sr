#!/bin/bash
# sr —— 宿主机唯一入口。单容器编所有版本：
#   版本差异全靠"指路"，容器永不重建（重建会杀掉 scheduler，农场就断了）：
#     thirdparty  公共目录 $SR_TPDIR/<digest>/ 整体挂成 /tp，编译时 bind 到规范路径，用哪个由 STARROCKS_THIRDPARTY 指
#     编译器      镜像里备齐 gcc 11/12/13/14，用哪个由 STARROCKS_GCC_HOME 指
#   依赖镜像的版本由用户显式指定（-v），不自动推断；指定后自动跟随该版本 tag 的最新 digest，
#   digest 变了会提示"若报依赖错误先 rebase"（加依赖不破坏老代码；依赖升级时你的代码可能还没跟上）。
set -uo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# 站点相关的东西（registry、base 镜像、apt 源、公共依赖目录、节点账号）全在 srdev.conf 里，
# 该文件不进仓库；容器内挂成 /etc/srdev.conf 给 sr-farm 用。模板见 srdev.conf.example。
CONF_FILE=${SR_CONF:-$HERE/srdev.conf}; [ -f "$CONF_FILE" ] && . "$CONF_FILE"
CONF=${SR_REGISTRIES:-$HERE/registries.conf}
BASE=${BASE:-$HOME}
WORK=${WORK:-$HOME}
CPUS=${CPUS:-16}
MEM=${MEM:-48g}
SR_USER=${SR_USER:-$(id -un)}
SLICE=${SLICE:-srfarm_${SR_USER}.slice}   # 名字必须用下划线：systemd 把 a-b.slice 当成 a.slice 的子节点
NAME=${SR_USER}_farm
IMG=${IMG:-sr-dev:single}
# 依赖按 digest 存，内容不可变、与用户无关——放公共目录全机共享，别人拉过的你不用再拉。
# 公共目录不可写时退回自己 $HOME 下。
SHARED_TP=${SR_TPDIR:-/srv/srdev/thirdparty}
if mkdir -p "$SHARED_TP" 2>/dev/null && [ -w "$SHARED_TP" ]; then TPDIR=$SHARED_TP; else TPDIR=$BASE/thirdparty; fi

SPEC=""; ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in -v|--version|-p|--profile) SPEC=$2; shift 2;; *) ARGS+=("$1"); shift;; esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

# SR_TP_REPO（srdev.conf）非空时：忽略 registries.conf 的命名空间，一律用它解析依赖镜像。
# 用途：某个命名空间的发布断了（例如某个来源暂时没有所需的依赖更新），先临时切到别处；
# 撤销就是删掉那一行，registries.conf 原样保留。
ns_list(){ if [ -n "${SR_TP_REPO:-}" ]; then echo override; else awk '!/^#/&&NF{print $1}' "$CONF"; fi; }
ns_url(){ [ -n "${SR_TP_REPO:-}" ] && { echo "$SR_TP_REPO"; return 0; }
  [ -f "$CONF" ] || { echo "!! 缺少 $CONF：cp registries.conf.example registries.conf 并填上你的 registry" >&2; return 1; }
  awk -v n="$1" '!/^#/&&$1==n{print $2}' "$CONF"; }
tags_of(){ local ns=$1 u c; u=$(ns_url "$ns"); [ -n "$u" ] || return 1
  c=$BASE/farm/tagcache/$ns-$(printf %s "$u" | md5sum | cut -c1-8).txt; mkdir -p "$(dirname "$c")" 2>/dev/null
  if [ ! -f "$c" ] || [ $(( $(date +%s) - $(stat -c %Y "$c" 2>/dev/null || echo 0) )) -gt 3600 ]; then
    curl -s --max-time 10 "http://${u%%/*}/v2/${u#*/}/tags/list" 2>/dev/null \
      | tr ',' '\n' | grep -oE '"[^"]+"' | tr -d '"' | grep -vE '^(name|tags)$' > "$c.tmp" 2>/dev/null
    [ -s "$c.tmp" ] && mv "$c.tmp" "$c" || rm -f "$c.tmp"
  fi
  cat "$c" 2>/dev/null; }
# 解析规则（按序）：main 先看 latest（用户指定：main 对应 tag 以 latest 匹配优先）；再 X.Y / X.Y-latest / X.Y-ee / X.Y-ee-latest；再最新的 X.Y-YYYYMMDD；
# 最后兜底取该 minor 最高的补丁版 X.Y.Z（review：菜单从 3.5.20 抠出 3.5，镜像源没有 3.5-latest 时原来解析不了）。
# 第三个参数可传已取到的 tag 列表，省一次请求
pick_tag(){ local ns=$1 v=$2 t c ve; t=${3:-$(tags_of "$ns")} || return 1; ve=${v//./\\.}
  for c in $([ "$v" = main ] && echo latest) "$v" "$v-latest" "$v-ee" "$v-ee-latest"; do
    grep -qx -- "$c" <<<"$t" && { echo "$c"; return 0; }; done
  c=$(printf '%s\n' "$t" | grep -E "^${ve}-[0-9]{8}$" | sort -r | head -1)
  [ -n "$c" ] && { echo "$c"; return 0; }
  c=$(printf '%s\n' "$t" | grep -E "^${ve}\.[0-9]+$" | sort -V | tail -1)
  [ -n "$c" ] && { echo "$c"; return 0; }; return 1; }
resolve(){ local v=$1 n
  case "$v" in *:*) n=${v%%:*}; v=${v#*:}
      TAG=$(pick_tag "$n" "$v") || return 1; NS=$n; PBASE="$(ns_url "$n"):$TAG"; return 0 ;; esac
  for n in $(ns_list); do
    TAG=$(pick_tag "$n" "$v" 2>/dev/null) && { NS=$n; PBASE="$(ns_url "$n"):$TAG"; return 0; }
  done; return 1; }
# 可选版本：main + 各 minor，只列 pick_tag 真能解析的（review：原来从 X.Y.Z 抠出 X.Y 就列，解析规则却可能不认）；
# main 置顶，其余按版本号降序取 8 个，跨命名空间去重
candidate_versions(){ local n t c
  for n in $(ns_list); do t=$(tags_of "$n" 2>/dev/null) || continue
    for c in main $(printf '%s\n' "$t" | grep -oE '^[0-9]+\.[0-9]+' | sort -Vr | uniq); do
      pick_tag "$n" "$c" "$t" >/dev/null 2>&1 && echo "$c"; done
  done | awk '!seen[$0]++' | sort -Vr | awk '/^main$/{m=1; next} {a[++k]=$0} END{if(m) print "main"; for(i=1; i<=k && i<=8; i++) print a[i]}'; }
# 不 pull 就能拿到内容指纹（实测 ~50ms）。用 digest 当目录名：上游重推同名 tag 也认得出来。
digest_of(){ local img=$1 h repo tag
  h=${img%%/*}; repo=$(echo "${img#*/}" | cut -d: -f1); tag=${img##*:}
  # Accept 必须覆盖四种类型：registry 按 Accept 挑 manifest，只写 docker v2 时 OCI index（starrocks/dev-env-ubuntu 就是）返回 404
  curl -sI --max-time 10 -H "Accept: application/vnd.docker.distribution.manifest.v2+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.oci.image.index.v1+json" \
    "http://$h/v2/$repo/manifests/$tag" 2>/dev/null \
    | grep -i '^docker-content-digest:' | tr -d '\r' | awk '{print $2}'; }   # 返回完整 sha256:…，截短只在显示时做

running(){ [ "$(docker inspect -f '{{.State.Running}}' $NAME 2>/dev/null)" = true ]; }
# 交互性只看宿主机 stdin：是终端就把它接进容器（-i）并告知 SR_TTY=1，容器里的 Y/N 询问据此判断（-i 下容器内 -t 0 恒为假）。
# -t 只在 stdout 也是终端时加：stdout 进了管道（sr build | tee log）还挂 -t，docker 会拒绝或把回车/转义码灌进日志（review）
TTY=(); if [ -t 0 ]; then TTY=(-i -e SR_TTY=1); [ -t 1 ] && TTY=(-it -e SR_TTY=1); fi

build_image(){
  echo "== 构建单镜像 $IMG（base=${SR_BASE_IMAGE:-Dockerfile 默认}，装 gcc 11/12/13 + 各自的 icecc 工具链包）…"
  BA=(--build-arg APT_MIRROR="${SR_APT_MIRROR:-}"); [ -n "${SR_BASE_IMAGE:-}" ] && BA+=(--build-arg BASE="$SR_BASE_IMAGE")
  docker build -f "$HERE/Dockerfile" "${BA[@]}" -t $IMG "$HERE"; }
# 没镜像就地构建（首次约 5 分钟）：sr up / sr build 都不该因为"还没跑 sr image"停下来；sr image 保留为显式重建
ensure_image(){ docker image inspect $IMG >/dev/null 2>&1 && return 0; echo "== 镜像 $IMG 不存在，先构建（一次性）"; build_image; }
ensure_container(){
  # 验证轮 偏差3：0700 迁移必须放在 running 短路之前，否则已在跑的老部署永远不会被修；改不动就拒绝——这是提权向量，不能带着跑
  if [ -d "$BASE/farm" ] && [ "$(stat -c %a "$BASE/farm" 2>/dev/null)" != 700 ]; then
    chmod 700 "$BASE/farm" 2>/dev/null || { echo "!! 无法把 $BASE/farm 设为 0700（其他用户可替换 state.env 提权），请先手动 chmod 700 后重试"; return 1; }
    echo "   (已把 $BASE/farm 收紧为 0700)"
  fi
  running && return 0
  ensure_image || { echo "!! 镜像构建失败"; return 1; }
  mkdir -p $BASE/ccache $BASE/m2 $BASE/farm $BASE/.tsp $BASE/iceccrun $TPDIR
  # review r7#3(P1)：原来 farm 是 0777 且无 sticky，本机任何用户都能删掉再放一个 state.env，容器 root 会读它 → 提权。
  # 改 0700：owner 仍能删容器 root 建的文件（删文件只看目录 w 位），容器 root 不受目录权限限制，其他用户进不来。
  # iceccrun 不能 0700：daemon 以 nobody 跑、要在里面建 socket（实测目录属主已是 nobody，chmod 会 EPERM）；它保持 0755，
  # 不可写就不是"替换文件"的向量。残余：socket 本身 0777（icecc 默认），靠 $HOME 0750 挡住非同组用户；换 daemon uid 另议。
  chmod 700 $BASE/farm 2>/dev/null || echo "!! 无法把 $BASE/farm 设为 0700，请手动 chmod 700（否则其他用户可替换 state.env）"
  # review r7#2(P1)：两次首次 sr build 并发，慢的一方会在快的一方已开工后 docker rm -f 掉它的容器。按容器名加锁、锁内复查。
  # 验证轮 #5：无命令的 `exec ... 2>/dev/null` 会永久吞掉本 shell 后续的 stderr；用 { } 把重定向限定在这一句
  { exec 8>"$BASE/farm/.container.lock"; } 2>/dev/null || { echo "!! 无法打开 $BASE/farm/.container.lock（目录权限？），拒绝在无互斥下起容器"; return 1; }
  flock -w 120 8 || { echo "!! 等待容器启动锁超时（另一个 sr 正在起容器？）"; return 1; }
  if running; then exec 8>&-; return 0; fi   # 等锁期间另一方已把容器起好，别再 rm -f
  local CGP=() CONF_MOUNT=()
  [ -f "$CONF_FILE" ] && CONF_MOUNT=(-v "$CONF_FILE":/etc/srdev.conf:ro)
  if [ -n "$SLICE" ] && command -v systemctl >/dev/null; then
    sudo -n systemctl set-property --runtime "$SLICE" "CPUQuota=$((CPUS*100))%" \
      "MemoryMax=$(echo "$MEM" | tr 'gmk' 'GMK')" >/dev/null 2>&1 && CGP=(--cgroup-parent "$SLICE")
  fi
  docker rm -f $NAME >/dev/null 2>&1
  # --init: tini 当 PID1 回收僵尸。否则被杀的 iceccd 留成 <defunct>，探活会误判 daemon 还在，
  # icecc 随即绕过并发闸门无限制本地编译 -> OOM（踩过）
  docker run -d --name $NAME --init --network host --privileged \
    ${CGP[@]+"${CGP[@]}"} --cpus=$CPUS --memory=$MEM \
    -v $WORK:$WORK -v $BASE/ccache:/ccache -v $BASE/m2:/root/.m2 \
    -v $BASE/farm:/farm -v $BASE/.tsp:/root/.tsp -v $BASE/iceccrun:/var/run/icecc \
    -v $TPDIR:/tp ${CONF_MOUNT[@]+"${CONF_MOUNT[@]}"} \
    -e SR_USER="$SR_USER" -e SR_UID="$(id -u)" -e SR_OSSCFG="$HOME/.ossutilconfig" -w $WORK $IMG sleep infinity >/dev/null
  local drc=$?; exec 8>&-   # 容器起完就放锁（无论成败）
  [ $drc = 0 ] || { echo "!! 容器启动失败（docker run 返回非零）"; return 1; }
  echo "== 容器 $NAME 已启动（单容器，编所有版本；限额 ${CPUS}核/${MEM}）"
  # 看门狗随容器死。容器重建后若已有农场，必须立刻把它拉回来——否则 3 小时无续约，
  # 死人开关会把农场释放（踩过：一天里反复重建容器，农场被自己的保护机制清掉了）
  [ -f "$BASE/farm/state.env" ] && docker exec $NAME sr-farm _wd >/dev/null 2>&1 && echo "   看门狗已重新拉起（农场续约恢复）"
  return 0   # 上一行是条件链，没有农场时会返回 1，曾让新用户第一次 sr build 在容器起好后被 || exit 1 打断
}

# 把某个官方镜像的 thirdparty 拉到 $TPDIR/<digest>/，并记下它要哪个 gcc
# $1=镜像引用 repo@sha256:…（一切 docker 操作按 digest，tag 移动或本地残留同 tag 旧镜像都拿不到错内容）
# $2=完整 digest（64 hex，直接做目录名：名字与内容由构造保证一致，永远不需要替换一个可能正被别人 bind 着编译的目录）
# $3=解析出的 tag 形式，只用于记录
ensure_tp(){
  local img=$1 dg=$2 tagname=${3:-$1}
  local d=$TPDIR/$dg
  if [ -f "$d/.ready" ]; then echo "$dg"; return 0; fi
  echo "== 首次使用该镜像的依赖，拉取中（约 7 秒，6~8G）…" >&2
  docker image inspect "$img" >/dev/null 2>&1 || { echo "   拉镜像 $img …" >&2; docker pull -q "$img" >/dev/null 2>&1; }
  # 多用户可能同时拉同一 digest：flock 串行，先拷到 .tmp 再原子 mv，别人永远看不到半成品
  # 锁文件要能被所有用户打开：A 建的 644 文件 B 打不开写就 flock 不了。建成 666，打不开写就以只读 fd 上锁
  local lk="$TPDIR/.lock.$dg"; ( umask 000; : >>"$lk" ) 2>/dev/null; chmod 666 "$lk" 2>/dev/null
  # 提取放进子 shell 持锁：子 shell 一退锁就放（review extra#3：原来 exec 7 在主 shell 拿锁不放，B 要等 A 整轮编译结束
  # 才能用已经就绪的依赖）。里面任何一步失败都不发布半成品（review extra#1：原来元数据写失败仍 mv、探测不到 gcc 就默认 14）。
  (
    flock 9 || exit 1
    [ -f "$d/.ready" ] && exit 0   # 等锁期间别人拷完了
    t="$d.tmp.$$"; rm -rf "$t" "$d" 2>/dev/null; mkdir -p "$t/installed"
    # 布局必须是 <dir>/installed/...：build.sh 检查 $STARROCKS_THIRDPARTY/installed/llvm/lib/libLLVMInstCombine.a，
    # 找不到就会去跑 build-thirdparty.sh 现场编（踩过：平铺后 rc=127）
    # 用 docker run 而不是 docker cp：实测 7s vs 18s，docker cp 要把 6.6G 序列化成 tar 流过 daemon
    docker run --rm -v "$t/installed":/dst "$img" cp -a /var/local/thirdparty/installed/. /dst/ >/dev/null 2>&1 \
      || { echo "!! 依赖拉取失败" >&2; rm -rf "$t"; exit 1; }
    # 这个镜像用哪个 gcc 大版本，编译时据此选 /opt/gccNN。探测失败就中止——绝不能默认 14 继续编（会选错编译器）
    gv=$(docker run --rm "$img" bash -c 'G=$(ls -d /opt/gcc-toolset-*/bin/gcc 2>/dev/null|sort -V|tail -1); [ -n "$G" ]||G=$(command -v gcc); $G -dumpversion' 2>/dev/null)
    gv=${gv%%.*}; gv=${gv//[!0-9]/}
    [ -n "$gv" ] || { echo "!! 探测不到 $img 的 gcc 版本，不敢默认 14，已中止（检查镜像或重试）" >&2; rm -rf "$t"; exit 1; }
    docker run --rm -v "$t":/dst "$img" bash -c "echo $gv > /dst/.gccmajor; echo $tagname > /dst/.image; echo $img > /dst/.ref; echo sha256:$dg > /dst/.digest; chmod -R a+rX /dst; touch /dst/.ready" >/dev/null 2>&1 \
      || { echo "!! 依赖元数据写入失败，不发布半成品目录，已中止" >&2; rm -rf "$t"; exit 1; }
    # 发布前完整性自检：.ready 与数字 .gccmajor 都必须在
    { [ -f "$t/.ready" ] && grep -qE '^[0-9]+$' "$t/.gccmajor" 2>/dev/null; } \
      || { echo "!! 依赖目录完整性检查未过（缺 .ready 或 .gccmajor 非数字），已中止" >&2; rm -rf "$t"; exit 1; }
    mv "$t" "$d"
  ) 9<>"$lk"
  local rc=$?
  [ $rc = 0 ] && [ -f "$d/.ready" ] && { echo "$dg"; return 0; }
  return 1; }

case "${1:-}" in
image)   build_image ;;   # 显式重建（改了 Dockerfile 之后）；平时 sr up / sr build 发现没镜像会自动构建
up)      ensure_container ;;
down)    docker rm -f $NAME >/dev/null 2>&1; echo "容器已删除（挂载卷保留）" ;;
shell)   ensure_container && docker exec -it $NAME bash -l ;;
history|log)
  F=$BASE/farm/builds.tsv
  [ -f "$F" ] || { echo "还没有编译记录"; exit 0; }
  printf "%-16s %-8s %-22s %-14s %-6s %-5s %-6s %-7s %-6s %s\n" 时间 用户 源码树@分支 版本 模式 边数 结果 用时 anon峰 命中/编译
  # 第 7 列是 build.sh 的退出码：0=成功，其余=失败。history 只报成功/失败，不写原因（用户要求）；要查原因看末列日志路径
  tail -n "${2:-20}" "$F" | awk -F"\t" '{r=($7==0?"成功":"失败"); printf "%-16s %-8s %-22s %-14s %-6s %-5s %-6s %-7s %-6s %s\n",$1,$2,substr($3,1,22),$4,$5,$6,r,$8,$9,$10}' ;;
tp)
  echo "依赖目录: $TPDIR $([ "$TPDIR" = "$SHARED_TP" ] && echo "（全机共享）" || echo "（个人）")"
  printf "%-14s %-8s %-7s %s\n" DIGEST GCC 大小 状态
  for d in $TPDIR/*/; do [ -d "$d" ] || continue; n=$(basename $d)
    printf "%-14s %-8s %-7s %-6s %s\n" "${n:0:12}" "$(cat $d/.gccmajor 2>/dev/null || echo ?)" \
      "$(du -sh $d 2>/dev/null|cut -f1)" "$([ -f $d/.ready ] && echo 就绪 || echo 不完整)" \
      "$([ ${#n} -lt 64 ] && echo '(旧格式目录，确认无人使用后可删)' || cat $d/.image 2>/dev/null)"
  done ;;
versions)
  [ -n "${SR_TP_REPO:-}" ] && echo "(SR_TP_REPO 生效：忽略 registries.conf，一律用 $SR_TP_REPO)"
  for n in $(ns_list); do
    echo "[$n] $(ns_url "$n")"
    tags_of "$n" | grep -E '^(latest$|main|[0-9]+\.[0-9]+)' | sort -Vr | head -12 | paste -sd' ' - | fold -sw 110 | sed 's/^/  /'
  done ;;
""|-h|--help|help) cat <<U
用法: sr [-v <版本>] <子命令>
  首次: cp srdev.conf.example srdev.conf; cp registries.conf.example registries.conf; 然后直接 sr -v main build

  up                 起容器（没镜像会先自动构建，约 5 分钟；单个容器编所有版本）
  image              强制重建镜像（改了 Dockerfile 之后用）
  build [目录] [选项] 编译（默认 BE+FE；--be / --fe 单选）。首次会询问依赖版本（或用 -v 指定），之后记住；换版本再 -v
  farm {init|status|usage [--watch [秒]]|rebalance|resume|suspend|down}
  tp                 列出已拉下来的各版本依赖（全机共享目录）
  history [N]        最近 N 次编译概况（默认 20）
  versions           列出 registry 里可用的版本
  shell / down

版本用 -v 显式指定，例：sr -v main build   sr -v 4.1 build   sr -v 3.5.20 build
指定一次后这棵源码树的这个分支会记住，并自动跟随该版本的最新依赖镜像；
digest 变了会提示（若报依赖相关错误，先 rebase 代码）。换版本用 -v 重新指定。
U
;;
*)
  ensure_container || exit 1
  sub=$1; shift
  case "$sub" in
    build)
      # 版本记忆：按「源码树 + 分支」记，切分支要重新指定
      # 与容器内 sr-build 同一规则找源码目录（review #7）：遇 -- 停；-j/--dist 跳过其值；其余 -* 跳过；
      # 第一个存在的目录型位置参数就是源码根（必须是根本身，不上溯）；没给时才从 $PWD 上溯。
      # 不能"扫所有参数里的现存目录"：-- 后面透传给 build.sh 的目录会被误认。
      TSTART=""; skipv=0
      for a in "$@"; do
        [ $skipv = 1 ] && { skipv=0; continue; }
        case "$a" in --) break;; -j|--dist) skipv=1;; -*) ;; *) [ -d "$a" ] && { TSTART=$(cd "$a" && pwd -P); break; };; esac   # pwd -P：软链接与真路径同一个 key（review latest#1）
      done
      # review#7：只有会真用农场的 BE 编译才值得预唤醒——--fe 纯 Java 不碰农场，--dist off 明确禁分布式，都不该把整套农场叫醒
      WANTS_FARM=1; prevd=""
      for a in "$@"; do
        [ "$a" = -- ] && break
        [ "$a" = --fe ] && WANTS_FARM=0
        [ "$prevd" = --dist ] && [ "$a" = off ] && WANTS_FARM=0
        prevd=$a
      done
      root_of(){ local d
          if [ -n "$TSTART" ]; then [ -f "$TSTART/build.sh" ] && [ -d "$TSTART/be/src" ] && { echo "$TSTART"; return 0; }; return 1; fi
          d=$(pwd -P); while [ "$d" != / ]; do   # 物理路径：软链接进来也算同一棵树（review latest#1）
          [ -f "$d/build.sh" ] && [ -d "$d/be/src" ] && { echo "$d"; return 0; }; d=$(dirname "$d"); done; return 1; }
      WROOT=$(root_of || true); PDIR=$BASE/farm/versions; KEY=""
      if [ -n "$WROOT" ]; then
        BR=$(git -C "$WROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo ?)
        [ "$BR" = HEAD ] && BR=$(git -C "$WROOT" describe --tags --abbrev=0 2>/dev/null || echo HEAD)
        KEY=$(printf %s "$WROOT@$BR" | md5sum | cut -c1-12)
      fi
      if [ -z "$SPEC" ] && [ -n "$KEY" ] && [ -f "$PDIR/$KEY" ]; then
        SPEC=$(cut -d' ' -f1 "$PDIR/$KEY")
        echo "(依赖=$SPEC · $(basename "${WROOT:-?}")@${BR:-?}，你之前指定过；换用 -v)" >&2
      fi
      # 首次编译且没给 -v：交互时让用户直接输入依赖版本（main / 4.0 这样），能解析就记住；之后换版本才需要 -v。
      # 不列菜单（用户要求：输入比选编号直观）；输错时才把 registry 里当前能解析的版本打出来当提示。
      # 不自动推断（分支名和依赖版本未必对应，猜错代价是一次失败的全量）。非交互环境仍要求 -v。
      if [ -z "$SPEC" ]; then
        if [ -t 0 ]; then   # 只看 stdin：sr build | tee log 这种 stdout 接管道的用法也该能询问；提示走 stderr
          echo "首次编译 $(basename "${WROOT:-?}")@${BR:-?}：需要指定依赖版本（对应官方 dev-env 镜像；之后会记住，换版本用 sr -v <版本> build）" >&2
          while :; do
            read -r -p "请输入依赖版本（如 main 或 4.0）: " ans
            [ -n "$ans" ] || { echo "!! 未输入版本，已取消" >&2; exit 1; }
            resolve "$ans" 2>/dev/null && { SPEC=$ans; break; }
            echo "!! 找不到 $ans 对应的依赖镜像。当前能解析的有：$(candidate_versions | paste -sd' ' -)；也可输入 3.5.20 这样的具体版本" >&2
          done
          echo "   已选 $SPEC（记住到这棵树的这个分支；换版本: sr -v <版本> build）"
        else
          echo "!! 首次编译需指定依赖版本，例: sr -v main build（sr versions 看可选项；交互终端下会弹出选择）"; exit 1
        fi
      fi
      resolve "$SPEC" || { echo "!! 找不到版本 $SPEC，sr versions 看可选项"; exit 1; }
      DGFULL=$(digest_of "$PBASE"); [ -n "$DGFULL" ] || { echo "!! 拿不到 $PBASE 的 digest"; exit 1; }
      DG=${DGFULL#sha256:}; DGS=${DG:0:12}       # 目录名用完整 digest，显示用 12 位
      REF="${PBASE%:*}@$DGFULL"                 # 按 digest 引用镜像（%:* 去掉的是最后的 :tag，registry 的 :5000 不受影响）
      echo "   依赖镜像 $PBASE  digest=$DGS$([ -n "${SR_TP_REPO:-}" ] && echo "  (SR_TP_REPO 强制，忽略 ee/os 命名空间)")"
      # 要拉依赖 = 这个 digest 第一次用 = 必然全量重编 = 必然要农场。农场若在睡，
      # 现在就后台唤醒（29s），和拉依赖（7s）+ configure 并行，不用等到编译开始再叫醒它。
      if [ "$WANTS_FARM" = 1 ] && [ ! -f "$TPDIR/$DG/.ready" ] && grep -q '^FARM_STATUS=suspended' "$BASE/farm/state.env" 2>/dev/null; then
        echo "   农场休眠中且需拉依赖 → 后台先唤醒，与拉取并行"
        docker exec -d $NAME sr-farm resume >/dev/null 2>&1
      fi
      # 自动跟随上游最新镜像（加依赖不会破坏老代码）；但 digest 变了要提醒——
      # 如果是依赖升级而你的代码还没 rebase，编译可能会挂，这时该 rebase 而不是怪工具
      if [ -n "$KEY" ] && [ -f "$PDIR/$KEY" ]; then
        OLD_DG=$(cut -d' ' -f2 "$PDIR/$KEY" 2>/dev/null)
        if [ -n "$OLD_DG" ] && [ "${OLD_DG:0:12}" != "${DG:0:12}" ]; then   # 旧记录可能是 12 位格式，按前缀比
          echo "   注意：上游 $SPEC 的依赖镜像已更新（${OLD_DG:0:12} -> $DGS），本次用新的。"
          echo "         若编译报依赖相关错误，先把代码 rebase 到最新再试。"
        fi
      fi
      ensure_tp "$REF" "$DG" "$PBASE" >/dev/null || exit 1
      GMAJ=$(cat "$TPDIR/$DG/.gccmajor" 2>/dev/null | cut -d. -f1); GMAJ=${GMAJ:-14}
      GHOME=/opt/gcc$GMAJ
      [ "$GMAJ" = 14 ] && GHOME=$(docker exec $NAME bash -c 'ls -d /opt/gcc-toolset-14 2>/dev/null || echo /opt/gcc13')
      [ -n "$KEY" ] && { mkdir -p "$PDIR" 2>/dev/null; echo "$SPEC $DG" > "$PDIR/$KEY"; }
      # 每次编译进自己的私有 mount namespace，把该版本的依赖 bind 到规范路径 /var/local/thirdparty。
      # 不能改路径挂成 /tp/<digest> 直接用：CMakeCache 会把首次 configure 找到的 FILEPATH 缓存成
      # /var/local/thirdparty/...，之后不再重找（踩过：toolchains base 上 libcurl.a 找不到；dev-env base 上
      # 则静默链到内置的 main 依赖）。规范路径 + 私有 ns：路径永不变、版本互不干扰、并发各用各的。
      # 可选透传：CCACHE_REMOTE_STORAGE(ccache 远端存储 URL) / SR_CCACHE_DIR(换一个缓存目录做对照实验)
      # MAVEN_OPTS: FE 的 maven JVM 参数/日志开关透传；SR_LOCAL_OK: 非交互且无农场时放行本机编（review：容器里提示了它，这里却没转发）
      # SR_DRYRUN / FARM_STATE：测试钩子，只走到决策打印就停 / 指向伪造的农场状态文件
      XENV=(); for v in CCACHE_REMOTE_STORAGE SR_CCACHE_DIR SR_EXPLAIN MAVEN_OPTS SR_LOCAL_OK SR_DRYRUN FARM_STATE; do [ -n "${!v:-}" ] && XENV+=(-e "$v"); done
      docker exec -w "$PWD" \
        -e STARROCKS_THIRDPARTY=/var/local/thirdparty -e STARROCKS_GCC_HOME="$GHOME" -e SR_TPDIGEST="$DGS" -e SR_VER="$SPEC" -e SR_BRANCH="${BR:-?}" \
        "${XENV[@]}" "${TTY[@]}" $NAME unshare -m --propagation private sh -c \
          'mount --bind "/tp/$0/installed" /var/local/thirdparty/installed && exec sr-build "$@"' "$DG" "$@" ;;
    farm) docker exec "${TTY[@]}" $NAME sr-farm "$@" ;;
    *) if docker exec $NAME sh -c "command -v \"\$1\"" _ "$sub" >/dev/null 2>&1; then
         docker exec "${TTY[@]}" $NAME "$sub" "$@"
       else echo "未知子命令: $sub"; exec "$0" --help; fi ;;
  esac ;;
esac
