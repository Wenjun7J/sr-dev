# Resolve versions to official dev-env images. Copy to registries.conf and replace
# REGISTRY_HOST with your registry. Format: <namespace> <registry>/<repository>.
# Entries are tried in order; the first match wins. Use sr -v 4.1 build normally,
# or select a namespace explicitly with ee:4.1 / os:4.1.
# The v2 tags/list and HEAD manifests APIs must allow anonymous access; token-authenticated Docker Hub is unsupported.
ee  REGISTRY_HOST:5000/<企业版命名空间>/dev-env-ubuntu
os  REGISTRY_HOST:5000/starrocks/dev-env-ubuntu
