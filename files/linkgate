#!/bin/bash
# Container-wide link concurrency gate, installed as CMake's <LANG>_LINKER_LAUNCHER.
#
# A Ninja job pool constrains only one build. Concurrent source trees can each
# budget all container memory and collectively exceed its limit, especially with
# ASAN links. Linking bypasses icecc, so it needs a separate cross-tree gate.
#
# Each linker takes one of N flock slots in the shared /farm volume before exec.
# The descriptor survives exec; the kernel releases its lock when the linker exits.
# Total concurrency is bounded by the largest SR_LINK_JOBS among active builds,
# not their sum. CMake applies this only to executable/shared-library links, not ar.
#
# This gate is an optimization: bypass it if flock, directory access, or the wait budget fails.
set -u
[ $# -gt 0 ] || exit 0
N=${SR_LINK_JOBS:-1}; case "$N" in ''|*[!0-9]*|0) N=1;; esac
D=${SR_LINK_GATE_DIR:-/farm/linkgate}
command -v flock >/dev/null 2>&1 || exec "$@"
mkdir -p "$D" 2>/dev/null || exec "$@"
chmod 1777 "$D" 2>/dev/null
# Bound waiting to avoid hanging a build indefinitely; the default is two hours.
# Distinguish occupied slots, which warrant waiting, from inaccessible slots,
# which require an immediate bypass rather than waiting for the entire timeout.
deadline=$(( $(date +%s) + ${SR_LINK_GATE_WAIT:-7200} ))
while :; do
  i=1; opened=0
  while [ "$i" -le "$N" ]; do
    [ -e "$D/slot.$i" ] || ( umask 000; : >>"$D/slot.$i" ) 2>/dev/null
    chmod 666 "$D/slot.$i" 2>/dev/null || true
    if [ ! -L "$D/slot.$i" ] && { exec 200<"$D/slot.$i"; } 2>/dev/null; then
      opened=$(( opened + 1 ))
      flock -n 200 && exec "$@"               # fd 200 survives exec; the kernel releases the slot when the linker exits.
    fi
    { exec 200>&-; } 2>/dev/null
    i=$(( i + 1 ))
  done
  # No openable slots means a permission/filesystem problem, not lock contention.
  [ "$opened" = 0 ] && { echo "linkgate: $D 下一个槽文件都打不开，本次链接不受闸门限制" >&2; exec "$@"; }
  if [ "$(date +%s)" -ge "$deadline" ]; then
    # A timeout should not discard hours of build work because of gate bookkeeping.
    # Bypass the gate and report the possible memory pressure on stderr.
    echo "linkgate: 等了 $(( ${SR_LINK_GATE_WAIT:-7200} / 60 )) 分钟仍抢不到槽（$N 个），本次不受闸门限制，内存可能吃紧" >&2
    exec "$@"
  fi
  sleep 2
done
