#!/bin/bash
# mvn 包装（build.sh 经 CUSTOM_MVN 调用）：`mvn clean` 前把各模块 target/checkstyle-cachefile 存一份，clean 完放回去。
#
# 为什么（2026-09-15 实测，fe-core 含测试 5567 个 java 文件）：
#   checkstyle 自带按「文件绝对路径 -> mtime」的缓存，有它 0s、没它 105s；增量构建一直有，只有 --clean 把 target/
#   连缓存一起删掉后才付全价，冷编译 3m45s 里它占了近一半。清空 target 只留这个文件再全量编：checkstyle 0s、仍报
#   0 violations、javac 照常编 4670 文件，总 2m12s。
#   maven-checkstyle-plugin 到 3.6.0 都没有改 cacheFile 位置的 -D 开关（plugin.xml 里只有 default-value），pom 也没配，
#   命令行改不了位置，只能这样保住文件。缓存键是绝对路径，容器与宿主同路径，放回原位即可。
# 限制：只对独立的 `mvn clean` 调用有效（build.sh 正是 clean 与 package 分两次调）；`mvn clean package` 一次调完
#   的场景 clean 与 validate 在同一次运行里，中间插不进去。
SELF=$(readlink -f "$0")
REAL=""
while IFS= read -r p; do [ "$(readlink -f "$p")" != "$SELF" ] && { REAL=$p; break; }; done < <(type -aP mvn)
[ -n "$REAL" ] || { echo "mvn-keepcache: PATH 里找不到真正的 mvn" >&2; exit 127; }
want=0; for a in "$@"; do [ "$a" = clean ] && want=1; done
[ $want = 1 ] || exec "$REAL" "$@"

KEEP=$(mktemp -d) || exec "$REAL" "$@"
while IFS= read -r f; do mkdir -p "$KEEP/$(dirname "$f")" && cp -p "$f" "$KEEP/$f"; done \
  < <(find . -mindepth 3 -maxdepth 5 -path '*/target/checkstyle-cachefile' 2>/dev/null)
"$REAL" "$@"; rc=$?
n=0
while IFS= read -r f; do rel=${f#"$KEEP"/}; mkdir -p "$(dirname "$rel")" && cp -p "$f" "$rel" && n=$((n+1)); done < <(find "$KEEP" -type f)
rm -rf "$KEEP"
[ $n -gt 0 ] && echo "mvn-keepcache: clean 后放回 $n 份 checkstyle 缓存（未改的文件不再重查，冷编译 checkstyle 由 ~105s 降到 0s）" >&2
exit $rc
