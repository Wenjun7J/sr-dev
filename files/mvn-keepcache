#!/bin/bash
# mvn 包装（build.sh 经 CUSTOM_MVN 调用）：保住各模块的 target/checkstyle-cachefile。
#
# 为什么（2026-09-15 实测，fe-core 含测试 5567 个 java 文件）：
#   checkstyle 自带按「文件绝对路径 -> mtime」的缓存，有它 0s、没它 105s；增量构建一直有，只有 --clean 把 target/
#   连缓存一起删掉后才付全价，冷编译 3m45s 里它占了近一半。清空 target 只留这个文件再全量编：checkstyle 0s、仍报
#   0 violations、javac 照常编 4670 文件，总 2m12s（用上包装后实测 sr build --fe --clean 2m06s）。
#   maven-checkstyle-plugin 到 3.6.0 都没有改 cacheFile 位置的 -D 开关（plugin.xml 里只有 default-value），pom 又没配，
#   命令行改不了位置。也不临时改 pom 再还原：被打断（SIGKILL、容器死）的构建会留下脏 pom，4 个模块的 XML 正则跨版本也不稳。
# 做法：每次 mvn 调用前后各同步一次——有缓存文件的模块存一份到 $STORE（默认 /farm/checkstyle-cache = 宿主 ~/farm，
#   容器重建也在），没有的（mvn clean / git clean / 手删 target）从 $STORE 放回。build.sh 把 clean 与 package 分两次调，
#   clean 一结束就放回，随后的 package 就有缓存。缓存键是绝对路径，容器与宿主同路径；缓存自带 mtime 与配置哈希校验，
#   放回一份过期的最多让它多查几个文件，不会漏查。
# 限制：`mvn clean package` 一次调完的，clean 与 validate 在同一次运行里，插不进去。
SELF=$(readlink -f "$0"); REAL=""
while IFS= read -r p; do [ "$(readlink -f "$p")" != "$SELF" ] && { REAL=$p; break; }; done < <(type -aP mvn)
[ -n "$REAL" ] || { echo "mvn-keepcache: PATH 里找不到真正的 mvn" >&2; exit 127; }
case "${1:-}" in --version|-v|-version) exec "$REAL" "$@";; esac   # env.sh 的探测，在源码树根目录调，别为它扫盘
STORE=${SR_CS_STORE:-/farm/checkstyle-cache}

# 输出 "存了几份 放回几份"。模块 = 当前目录下 2~4 层的 pom.xml 所在目录（fe/ 下：fe-core、plugin/spark-dpp…；java-extensions 同理）
sync(){ local pom d k n=0 m=0
  mkdir -p "$STORE" 2>/dev/null && chmod 777 "$STORE" 2>/dev/null
  [ -d "$STORE" ] || { echo "0 0"; return 0; }
  while IFS= read -r pom; do d=$(dirname "$pom"); k=$(cd "$d" && pwd -P | tr / %)
    if [ -f "$d/target/checkstyle-cachefile" ]; then
      cp -p "$d/target/checkstyle-cachefile" "$STORE/$k.tmp" && chmod 666 "$STORE/$k.tmp" 2>/dev/null && mv -f "$STORE/$k.tmp" "$STORE/$k" && n=$((n+1))
    elif [ -f "$STORE/$k" ]; then
      mkdir -p "$d/target" && cp -p "$STORE/$k" "$d/target/checkstyle-cachefile" && m=$((m+1))
    fi
  done < <(find . -mindepth 2 -maxdepth 4 -name pom.xml -not -path '*/target/*' -not -path '*/src/*' 2>/dev/null)
  echo "$n $m"; }

sync >/dev/null
"$REAL" "$@"; rc=$?
read -r _ restored < <(sync)
[ "${restored:-0}" -gt 0 ] && echo "mvn-keepcache: 放回 $restored 份 checkstyle 缓存（未改的文件不再重查，冷编译 checkstyle 由 ~105s 降到 0s）" >&2
exit $rc
