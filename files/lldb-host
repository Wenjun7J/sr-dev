#!/bin/bash
# Run lldb-dap or command-line LLDB in the build container with the same dependency
# mounts and test runtime environment as run-be-ut.sh. Select the command by symlink name:
#   ln -sf ~/srdev/files/lldb-host ~/bin/lldb-dap   # VS Code adapter executable.
#   ln -sf ~/srdev/files/lldb-host ~/bin/lldb       # Interactive CLI debugger.
#
# Test binaries depend on container compiler runtimes and digest-specific thirdparty
# shared libraries unavailable on the host. LLDB also needs the target's process namespace.
# DAP uses docker exec stdin/stdout; no extra listening port is required.
#
# Keep stdout exclusively for DAP traffic; send all diagnostics to stderr.
set -uo pipefail
ME=$(basename "$0"); say(){ printf '%s: %s\n' "$ME" "$*" >&2; }

HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)     # Repository root.
CONF_FILE=${SR_CONF:-$HERE/srdev.conf}; [ -f "$CONF_FILE" ] && . "$CONF_FILE"
BASE=${BASE:-$HOME}
SR_USER=${SR_USER:-$(id -un)}
NAME=${SR_CLANGD_CONTAINER:-${SR_USER}_farm}                 # Use the same container-name configuration as clangd.
case "$ME" in lldb-dap*) BIN=${SR_LLDB_DAP_BIN:-lldb-dap-20}; TTY=();;
             *)         BIN=${SR_LLDB_BIN:-lldb-20}; TTY=(); [ -t 0 ] && [ -t 1 ] && TTY=(-t);; esac   # Interactive command-line LLDB needs a TTY.

# Find the source tree from the adapter's workspace cwd or the CLI's current directory.
find_root(){ local d=${1:-}
  while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do
    [ -f "$d/build.sh" ] && [ -d "$d/be/src" ] && { printf '%s\n' "$d"; return 0; }
    d=$(dirname "$d"); done; return 1; }
SR=$(find_root "$(pwd -P)" 2>/dev/null || true)

# Use the dependency digest pinned for this tree, shared with sr build and clangd-host,
# so runtime libraries match those used to compile the target.
DG=""
if [ -n "$SR" ]; then
  BR=$(git -C "$SR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
  [ "$BR" = HEAD ] && BR=$(git -C "$SR" describe --tags --abbrev=0 2>/dev/null || echo HEAD)
  KEY=$(printf %s "$SR@$BR" | md5sum | cut -c1-12)
  DG=$(cut -d' ' -f2 "$BASE/farm/versions/$KEY" 2>/dev/null)
  case "$DG" in ''|*[!0-9a-f]*) DG="";; esac
fi

if [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" != true ]; then
  say "容器 $NAME 没在跑，先 sr up"
  "$HERE/sr" up >&2 2>&1 || { say "容器起不来，放弃"; exit 1; }
fi

# Forward SR_UT_TREE to select build libraries and SR_LLDB_ENV_DEBUG to log the computed environment.
ENVS=(-e "STARROCKS_HOME=${SR:-$PWD}")
for v in SR_UT_TREE SR_LLDB_ENV_DEBUG JAVA_HOME ASAN_OPTIONS LSAN_OPTIONS; do [ -n "${!v:-}" ] && ENVS+=(-e "$v=${!v}"); done

if [ -n "$DG" ]; then
  say "进容器 $NAME 跑 $BIN，依赖 digest ${DG:0:12}，源码树 $SR${SR_UT_TREE:+，构建树 $SR_UT_TREE}"
  # sh -c receives $0=digest, $1=BIN, and $2..=arguments; lldb-dap-env configures the target then execs them.
  exec docker exec -i "${TTY[@]}" -w "${SR:-$PWD}" "${ENVS[@]}" "$NAME" \
    unshare -m --propagation private sh -c \
    'exec 6</tp; flock -s 6 || exit 1
     mount --bind "/tp/$0/installed" /var/local/thirdparty/installed \
       || { echo "lldb-host: 依赖挂载失败，请重新生成构建配置" >&2; exit 1; }
     exec lldb-dap-env "$@"' "$DG" "$BIN" "$@"
else
  [ -n "$SR" ] && say "找不到 $SR 的依赖版本记录（这棵树还没 sr build 过？），不挂 thirdparty，依赖第三方 .so 的二进制会起不来" \
               || say "当前目录不在任何 StarRocks 源码树里，不挂 thirdparty、不设单测环境"
  exec docker exec -i "${TTY[@]}" -w "${SR:-$PWD}" "${ENVS[@]}" "$NAME" lldb-dap-env "$BIN" "$@"
fi
