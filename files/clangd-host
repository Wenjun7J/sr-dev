#!/bin/bash
# Run VS Code's clangd in the build container with the same dependency mounts.
# Set clangd.path to this script, usually through a ~/bin/clangd symlink.
#
# Compilation commands refer to container-only compilers and thirdparty paths.
# Running on the host would break --query-driver system-header discovery and
# resolution of dependencies such as Boost, Protobuf, and Thrift.
#
# The default container mount namespace has no selected thirdparty installation.
# Match sr build's private namespace and digest-specific bind mount so clangd can
# resolve the same third-party headers.
#
# Keep stdout exclusively for LSP traffic. Send all diagnostics to stderr,
# where VS Code's clangd output panel can display them.
set -uo pipefail
say(){ printf 'clangd-host: %s\n' "$*" >&2; }

HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)     # Repository root.
CONF_FILE=${SR_CONF:-$HERE/srdev.conf}; [ -f "$CONF_FILE" ] && . "$CONF_FILE"
BASE=${BASE:-$HOME}
SR_USER=${SR_USER:-$(id -un)}
NAME=${SR_CLANGD_CONTAINER:-${SR_USER}_farm}
CLANGD=${SR_CLANGD_BIN:-clangd-20}

# Find the source tree from VS Code's workspace cwd, then try --compile-commands-dir.
find_root(){ local d=${1:-}
  while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do
    [ -f "$d/build.sh" ] && [ -d "$d/be/src" ] && { printf '%s\n' "$d"; return 0; }
    d=$(dirname "$d"); done; return 1; }
SR=$(find_root "$(pwd -P)" 2>/dev/null || true)
if [ -z "$SR" ]; then
  for a in "$@"; do case "$a" in
    --compile-commands-dir=*) SR=$(find_root "${a#*=}" 2>/dev/null || true); [ -n "$SR" ] && break;; esac; done
fi

# Read the same dependency digest record as sr build to use matching headers.
DG=""
if [ -n "$SR" ]; then
  BR=$(git -C "$SR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
  [ "$BR" = HEAD ] && BR=$(git -C "$SR" describe --tags --abbrev=0 2>/dev/null || echo HEAD)
  KEY=$(printf %s "$SR@$BR" | md5sum | cut -c1-12)
  DG=$(cut -d' ' -f2 "$BASE/farm/versions/$KEY" 2>/dev/null)
  case "$DG" in ''|*[!0-9a-f]*) DG="";; esac
fi

# Start the container if needed; redirect sr up output to stderr to preserve the LSP stream.
if [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" != true ]; then
  say "容器 $NAME 没在跑，先 sr up"
  "$HERE/sr" up >&2 2>&1 || { say "容器起不来，放弃"; exit 1; }
fi

if [ -n "$DG" ]; then
  say "进容器 $NAME，依赖 digest ${DG:0:12}，源码树 $SR"
  # sh -c receives $0=digest, $1=clangd, and $2..=arguments. exec "$@" must not shift them.
  exec docker exec -i -w "${SR:-$PWD}" "$NAME" \
    unshare -m --propagation private sh -c \
    'exec 6</tp; flock -s 6 || exit 1
     mount --bind "/tp/$0/installed" /var/local/thirdparty/installed \
       || { echo "clangd-host: 依赖挂载失败，请重新生成构建配置" >&2; exit 1; }
     exec "$@"' "$DG" "$CLANGD" "$@"
else
  [ -n "$SR" ] && say "找不到 $SR 的依赖版本记录（这棵树还没 sr build 过？），不挂 thirdparty，第三方头文件会报找不到" \
               || say "当前目录不在任何 StarRocks 源码树里，不挂 thirdparty"
  exec docker exec -i -w "$PWD" "$NAME" "$CLANGD" "$@"
fi
