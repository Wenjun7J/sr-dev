#!/bin/bash
# sr-farm: compilation farm lifecycle management, running inside the container.
# Renewal resets expiry to now + N hours. If the container stops, renewals stop
# and the farm expires within an hour: an intentional dead man's switch.
set -uo pipefail
# The host mounts site configuration read-only; set -a exports it to tspapi.py and SSH.
# Prefer /farm/srdev.conf, synchronized by the host on each invocation. The legacy
# /etc/srdev.conf file mount pins an inode and can go stale after an editor saves it.
SRCONF=/farm/srdev.conf; [ -f "$SRCONF" ] || SRCONF=/etc/srdev.conf
# Capture environment overrides before sourcing configuration. Reset to this baseline
# on each watchdog reload so removed settings return to their defaults.
# A watchdog child uses the explicit baseline from its parent; use - rather than :-
# so an explicitly empty value is preserved. Other invocations use their own environment.
ENVBASE_IDLE_MIN=${SR_WD_BASE_IDLE-${IDLE_MIN:-}}
ENVBASE_RENEW_MIN=${SR_WD_BASE_RENEW_MIN-${RENEW_MIN:-}}
ENVBASE_RENEW_H=${SR_WD_BASE_RENEW_H-${RENEW_H:-}}
[ -f "$SRCONF" ] && { set -a; . "$SRCONF"; set +a; }
API=${SR_TSPAPI:-/usr/local/bin/tspapi.py}   # SR_TSPAPI/SR_FARM_DIR let isolated tests replace the platform client and state directory.
FARM=${SR_FARM_DIR:-/farm}
STATE=$FARM/state.env
# Never source state.env: a replaced state file would execute as root. Accept only
# allowlisted KEY=value entries with validated values; reject any malformed line.
load_state(){ local k v
  [ -f "$STATE" ] || return 1
  while IFS='=' read -r k v || [ -n "$k" ]; do
    v=${v%\"}; v=${v#\"}
    case "$k" in
      CLUSTER|NETNAME) [[ "$v" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || { echo "!! state.env 的 $k 取值非法: '$v'" >&2; return 1; } ;;
      CID|WORKERS|NCPU|SPORT|DPORT) [[ "$v" =~ ^[0-9]{1,10}$ ]] || { echo "!! state.env 的 $k 不是整数: '$v'" >&2; return 1; } ;;
      SCHED) [[ "$v" =~ ^[0-9.]{7,15}$ ]] || { echo "!! state.env 的 SCHED 不像 IP: '$v'" >&2; return 1; } ;;
      NODES) [[ "$v" =~ ^[0-9.\ ]*$ ]] || { echo "!! state.env 的 NODES 不像 IP 列表: '$v'" >&2; return 1; } ;;
      FARM_STATUS) case "$v" in initializing|running|degraded|suspended|releasing) ;; *) echo "!! state.env 的 FARM_STATUS 非法: '$v'" >&2; return 1;; esac ;;
      ''|'#'*) continue ;;
      *) echo "!! state.env 含未知键 '$k'，拒绝加载" >&2; return 1 ;;
    esac
    printf -v "$k" '%s' "$v"
  done < "$STATE"; }
# Serialize the entire read-state / platform-operation / write-state sequence for
# init, resume, suspend, down, and rebalance. Long-lived children must close fd 8
# so they cannot retain the lifecycle lock indefinitely.
lifecycle_lock(){
  # Fail closed if the lock file cannot be opened; changing farm state without a lock is unsafe.
  # Scope stderr redirection to this command: a bare exec would silence all later errors.
  { exec 8>"$FARM/lifecycle.lock"; } 2>/dev/null || { echo "!! 无法打开 $FARM/lifecycle.lock，拒绝在无互斥保护下操作农场"; exit 1; }
  flock -w 600 8 || { echo "!! 另一个农场操作正在进行（等锁 10 分钟超时），稍后再试"; exit 1; }; }
LOGF=$FARM/watchdog.log
KEY=$FARM/ssh/id_farm
NAME=${FARM_NAME:-${SR_USER:-$(id -un)}_farm}
WORKERS=${WORKERS:-4}
ITYPE=${ITYPE:-8c32g}
DISK=${DISK:-20}   # icecc uses very little disk space on workers; no data disk is needed.
IDLE_MIN=${IDLE_MIN:-15}     # Resume takes about 29 seconds, so an aggressive idle timeout is practical.
WARM_EVERY_MIN=${SR_WARM_EVERY_MIN:-5}   # Limit automatic warmup to once every N minutes, even for a broken worker.
RENEW_MIN=${RENEW_MIN:-15}
RENEW_H=${RENEW_H:-3}       # Renewal resets expiry to now + N hours; it does not add time to the old expiry.
NUSER=${SR_NODE_USER:-sr}          # SSH user on worker nodes.
NODEPW=${SR_NODE_PASSWORD:-}       # Initial password, used only to install the SSH key. Never hardcode credentials.
mkdir -p $FARM/ssh 2>/dev/null; chmod 700 $FARM/ssh 2>/dev/null
SSHO="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10"
n_ssh(){ ssh -n -i $KEY $SSHO $NUSER@"$1" "$2"; }
beat(){ : > $FARM/last-build 2>/dev/null; chmod 666 $FARM/last-build 2>/dev/null; }
# Close fd 9: sr-build holds a build lock on it, and a persistent watchdog would
# otherwise keep that lock after the build exits. Also close lifecycle lock fd 8.
# Pass the pre-configuration environment as SR_WD_BASE_* explicitly: the parent
# has already exported configuration values, which must not become the child's baseline.
# pgrep is only a fast path. Concurrent builds can both pass it, so _watchdog
# uses flock to enforce a single instance and avoid conflicting lifecycle decisions.
wd_ensure(){ pgrep -f "[s]r-farm _watchdog" >/dev/null || {
  SR_WD_BASE_IDLE="$ENVBASE_IDLE_MIN" SR_WD_BASE_RENEW_MIN="$ENVBASE_RENEW_MIN" SR_WD_BASE_RENEW_H="$ENVBASE_RENEW_H" \
    setsid nohup "$0" _watchdog </dev/null >>"$LOGF" 2>&1 8>&- 9>&- & }; }
# Run the scheduler in this container: it is a lightweight coordinator. Clients and
# workers exchange preprocessed sources and build outputs directly. With host networking,
# workers connect to the host IP, leaving all cloud nodes available as workers.
HOSTIP=$(hostname -I | awk '{print $1}')
# Give each user a separate icecc instance on the shared development host. Port collisions
# can prevent the daemon from starting and cause uncontrolled local compilation.
# Derive the same ports in sr-farm and sr-build from the host UID, and use a distinct
# network name so workers only connect to their owner's scheduler.
SR_USER=${SR_USER:-$(id -un)}
# id -u is always 0 inside the root container. Use SR_UID supplied by the host sr
# command to derive user-specific ports, falling back to id -u only when absent.
UIDN=${SR_UID:-$(id -u 2>/dev/null || echo 0)}
NETNAME=${NETNAME:-${SR_USER}_farm}
# The scheduler uses SPORT and SPORT+1 for its control interface, so allocate ports
# in steps of two. UID modulo 250 maps SPORT to [18700, 19198], below the DPORT range.
# Existing farms load their recorded ports from state.env, overriding these defaults.
SPORT=${SPORT:-$(( 18700 + 2 * (UIDN % 250) ))}    # Scheduler; SPORT+1 is the text control port.
DPORT=${DPORT:-$(( 19700 + UIDN % 500 ))}    # Local iceccd.
# Profile containers share the host network but have separate PID namespaces.
# Check whether the listener on $1 runs $2 in this container. sched_ensure also
# recognizes a sibling container's scheduler by its network name on the control port.
# SR_SCHED_VERBOSE=1 enables -vvv scheduler logs for diagnosing worker assignment.
port_is_ours(){ local line pid
  line=$(ss -ltnpH "sport = :$1" 2>/dev/null)
  case "$line" in *users:*) ;; *) return 1;; esac
  for pid in $(printf '%s\n' "$line" | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u); do
    case "$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null)" in *"$2"*) return 0;; esac
  done; return 1; }
# Query icecream's built-in text control interface at SPORT+1.
sched_q(){ exec 3<>/dev/tcp/127.0.0.1/$((SPORT+1)) 2>/dev/null || return 1; printf '%s\nquit\n' "$1" >&3; timeout 2 cat <&3; exec 3>&-; }
sched_ensure(){
  if port_is_ours "$SPORT" icecc-scheduler; then return 0; fi
  if [ -n "$(ss -ltnH "sport = :$SPORT" 2>/dev/null)" ]; then
    if sched_q listcs 2>/dev/null | grep -q "^200-ICECC ${NETNAME}:"; then return 0; fi
    echo "!! scheduler 端口 $SPORT 已被其他用户或进程占用（非 ${NETNAME}），请在 srdev.conf 中设置 SPORT= 错开" >&2
    return 1
  fi
  if [ -n "$(ss -ltnH "sport = :$((SPORT+1))" 2>/dev/null)" ] && ! port_is_ours "$((SPORT+1))" icecc-scheduler; then
    echo "!! scheduler 管理端口 $((SPORT+1)) 已被其他用户或进程占用，请在 srdev.conf 中设置 SPORT= 错开" >&2
    return 1
  fi
  /usr/sbin/icecc-scheduler -n "$NETNAME" -p "$SPORT" -d -l /tmp/icecc-scheduler.log $([ -n "${SR_SCHED_VERBOSE:-}" ] && echo "-v -v -v") >/dev/null 2>&1 6>&- 8>&- 9>&-
}   # Close lifecycle fd 8 and watchdog fd 6 so the persistent scheduler cannot retain their locks.
# Host networking exposes worker connections locally. Check each remote IP in NODES
# for an established scheduler connection, rather than counting all matching sockets:
# the local daemon's loopback connection appears twice and can hide missing workers.
# grep -c exits with 1 for zero matches; suppress its status without printing a second zero.
dcount(){ local n=0 ip
  for ip in ${NODES:-}; do
    [ -n "$(ss -tnH state established "( sport = :$SPORT and dst = $ip )" 2>/dev/null)" ] && n=$((n+1))
  done; echo $n; }
# Deploy node configuration idempotently; $1=1 also installs the SSH key. node-setup.sh
# reads back the configuration to verify it. Collect each child's exit status because
# a bare wait loses individual failures. The caller separately checks worker connections.
provision_nodes(){ local first=${1:-0} ip p bad="" pids=() ips=()
  for ip in $NODES; do
    ( [ "$first" = 1 ] && SSHPASS="$NODEPW" sshpass -e ssh-copy-id -i $KEY.pub $SSHO $NUSER@$ip >/dev/null 2>&1
      scp -q -i $KEY $SSHO /usr/local/bin/node-setup.sh $NUSER@$ip:/tmp/ 2>/dev/null || exit 1
      ssh -n -i $KEY $SSHO $NUSER@$ip "bash /tmp/node-setup.sh $SCHED worker ${SR_NODE_JOBS:-auto} $NETNAME $SPORT ${SR_APT_MIRROR:-}" ) &
    pids+=($!); ips+=("$ip")
  done
  for i in "${!pids[@]}"; do wait "${pids[$i]}" || bad="$bad ${ips[$i]}"; done
  [ -n "$bad" ] && echo "   !! 这些节点部署未成功：$bad（上面每行的 iceccd= 字段能看出卡在哪）"
  [ -z "$bad" ]; }
# Detect builds across profile containers by their source-tree locks; pgrep only sees
# this container. Any held lock means busy. Without flock, assume idle: this check
# only controls automatic suspension, and a mistaken suspension falls back to local builds.
busy(){ local f
  command -v flock >/dev/null || return 1
  for f in "$FARM"/sr-build.*.lock; do
    [ -e "$f" ] || continue
    ( exec 8>>"$f"; flock -n 8 ) >/dev/null 2>&1 || return 0
  done; return 1; }
wait_workers(){ local i; for i in $(seq 1 "$1"); do sleep 2; [ "$(dcount)" -ge "$WORKERS" ] && return 0; done; return 1; }
# ---- Worker warmup ----
# icecc can starve workers with no compiler environment or speed history once other
# workers have a score. Send each unscored worker a real compilation to install its
# environment and establish a speed score.
# The scheduler discards timing samples for outputs smaller than 4096 bytes or zero
# user CPU time. Judge success by a nonzero worker speed, not the icecc exit status.
# One GCC version is enough because scores belong to workers, not toolchains.
# Signal cleanup uses Bash dynamic scope to access warm_workers' pids and dir.
warm_abort(){ local rc=$1 p
  kill ${pids[@]+"${pids[@]}"} 2>/dev/null
  for p in ${pids[@]+"${pids[@]}"}; do wait "$p" 2>/dev/null; done
  rm -rf "${dir:-/nonexistent}" 2>/dev/null
  echo "   预热被中断（农场本身已就绪；稍后可 sr farm rebalance 补预热）" >&2
  exit "$rc"; }
# The watchdog checks for zero-score workers every minute. Lifecycle-only warmup is
# insufficient: a daemon may restart later, lose its score, and remain starved.
# Periodic checks restore it, with WARM_EVERY_MIN limiting retries for broken workers.
warm_if_starving(){
  [ "${FARM_STATUS:-}" = running ] || return 0
  local now last cs ip sp need=0
  now=$(date +%s); last=$(cat "$FARM/.last-warm" 2>/dev/null); last=${last//[!0-9]/}
  [ $(( now - ${last:-0} )) -ge $(( WARM_EVERY_MIN * 60 )) ] || return 0
  cs=$(sched_q listcs 2>/dev/null); [ -n "$cs" ] || return 0
  for ip in ${NODES:-}; do
    sp=$(printf '%s\n' "$cs" | sed -nE "s/^ [^ ]+ \(${ip//./\\.}:[0-9]+\).*speed=([0-9.]+).*/\1/p" | head -1)
    case "${sp:-}" in 0|0.0|0.00) need=1; break;; esac    # Ignore unregistered workers; missing registration is a separate problem.
  done
  [ "$need" = 1 ] || return 0
  echo "$(date '+%F %T') 发现评分为 0 的 worker，自动预热" >>"$LOGF"
  warm_workers >>"$LOGF" 2>&1
  rc=$?
  # Return code 2 means the local iceccd is not running and warmup was skipped.
  # Do not delay the next real warmup attempt.
  [ "$rc" != 2 ] && echo "$now" > "$FARM/.last-warm"
  return "$rc"; }

warm_workers(){
  command -v icecc >/dev/null 2>&1 || return 0
  local envf="" gxx="" gccdir gh dir src cs ip name sp i n=0 fail="" deadline got want rem alive=0 q st pids=() p
  # Match the compiler to its toolchain archive. Select the compiler directory first,
  # then the archive in the corresponding directory, as sr-build does. Independently
  # choosing the newest archive could pair preprocessing and compilation from different GCC versions.
  for gccdir in /opt/gcc-toolset-*/ /opt/gcc[0-9]*/; do
    [ -x "${gccdir}bin/g++" ] || continue
    gh=$(basename "${gccdir%/}"); envf=$(ls -t "/opt/icecc/$gh"/*.tar.gz 2>/dev/null | head -1)
    [ -n "$envf" ] && { gxx="${gccdir}bin/g++"; break; }
  done
  { [ -n "$envf" ] && [ -n "$gxx" ]; } || { echo "   (跳过预热：镜像里没有配对的 icecc 工具链包与编译器)"; return 0; }
  # Warmup requires a reachable local iceccd socket; otherwise icecc compiles locally
  # and creates no remote speed score. sr-build starts the daemon with matching options,
  # so only check it here. A stale socket or an existing process/port is not sufficient.
  if ! { [ -S "${ICESOCK:-/var/run/icecc/iceccd.socket}" ] && python3 -c "import socket,sys
s=socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(2)
try: s.connect('${ICESOCK:-/var/run/icecc/iceccd.socket}'); s.close()
except Exception: sys.exit(1)" 2>/dev/null; }; then
    echo "   (跳过预热：本机 iceccd 连不上——它由 sr build 启动。首次构建后跑一次 sr farm rebalance 即可)"
    return 2   # 2 means skipped, neither success nor failure; callers report readiness accordingly.
  fi
  # After a scheduler restart, allow up to 60 seconds for workers to register. Count
  # each IP in NODES: listcs also includes the local submitter, so counting all entries
  # can skip warmup for the last remote worker to reconnect.
  want=$(printf '%s\n' ${NODES:-} | grep -c .)
  for i in $(seq 1 30); do
    cs=$(sched_q listcs 2>/dev/null); got=0
    for ip in ${NODES:-}; do printf '%s\n' "$cs" | grep -qE "^ [^ ]+ \(${ip//./\\.}:" && got=$((got+1)); done
    [ "$got" -ge "${want:-1}" ] && break
    sleep 2
  done
  [ -n "$cs" ] || { echo "   (跳过预热：读不到 scheduler 的主机列表)"; return 0; }
  dir=$(mktemp -d /tmp/sr-warm.XXXXXX) || return 0; src=$dir/w.cpp
  { echo '#include <string>'; echo '#include <vector>'
    for i in $(seq 1 200); do
      echo "std::vector<std::string> sr_warm_$i(int x){std::vector<std::string> v;for(int i=0;i<x;i++)v.push_back(std::to_string(i*$i));return v;}"
    done; } > "$src"
  echo "== 预热 worker（让每台都拿到 env 与速度评分，避免 scheduler 重启后有机器零任务）…"
  # On interruption, stop warmup children, remove temporary files, and exit. Merely
  # cleaning up would let the loop continue submitting jobs with deleted sources.
  # Farm state is already saved and the lifecycle lock released; only warmup is incomplete.
  trap 'warm_abort 130' INT; trap 'warm_abort 143' TERM
  deadline=$(( $(date +%s) + 300 ))
  for ip in ${NODES:-}; do
    # Use min(180, remaining budget) per job, with a TERM-to-KILL grace period to enforce the total limit.
    rem=$(( deadline - $(date +%s) )); [ "$rem" -gt 180 ] && rem=180
    [ "$rem" -le 10 ] && { fail="$fail $ip(超预算未预热)"; continue; }
    name=$(printf '%s\n' "$cs" | sed -nE "s/^ ([^ ]+) \(${ip//./\\.}:[0-9]+\).*/\1/p" | head -1)
    [ -n "$name" ] || { fail="$fail $ip(未注册)"; continue; }
    sp=$(printf '%s\n' "$cs" | sed -nE "s/^ [^ ]+ \(${ip//./\\.}:[0-9]+\).*speed=([0-9.]+).*/\1/p" | head -1)
    case "${sp:-0}" in 0|0.0|0.00) ;; *) continue;; esac     # Skip workers that already have a speed score.
    ( unset ICECC; ICECC_VERSION="$envf" ICECC_PREFERRED_HOST="$name" \
        timeout -k 10 "$rem" icecc "$gxx" -O2 -c "$src" -o "$dir/$name.o" >/dev/null 2>&1 ) &
    pids+=($!)
    # Wait only for warmup children. A bare wait would also wait for the persistent
    # watchdog started by wd_ensure, causing init/resume to hang indefinitely.
    if [ "${#pids[@]}" -ge 2 ]; then wait "${pids[0]}" 2>/dev/null; pids=(${pids[@]:1}); fi
    n=$((n+1))
  done
  for p in ${pids[@]+"${pids[@]}"}; do wait "$p" 2>/dev/null; done
  pids=(); trap - INT TERM
  cs=$(sched_q listcs 2>/dev/null)                # Judge readiness by speed, not the icecc exit status.
  for ip in ${NODES:-}; do
    sp=$(printf '%s\n' "$cs" | sed -nE "s/^ [^ ]+ \(${ip//./\\.}:[0-9]+\).*speed=([0-9.]+).*/\1/p" | head -1)
    case "${sp:-}" in ''|0|0.0|0.00) case "$fail" in *"$ip"*) ;; *) fail="$fail $ip";; esac;; esac
  done
  rm -rf "$dir"
  [ -n "$fail" ] && echo "   !! 这些 worker 预热后仍无速度评分，可能接不到任务：$fail（稍后可 sr farm rebalance 重试）"
  return 0; }
# Compilation slots per worker (icecc -m): prefer SR_NODE_JOBS, then a node's actual
# CPU count, then the ITYPE prefix (e.g. 8c16g -> 8), and finally 8. Record this in
# state.env so sr-build can calculate total parallelism as WORKERS*NCPU plus local slots.
node_jobs(){ local ip n
  # Normalize to a positive decimal integer before Bash arithmetic. Values such as
  # auto, zero, or 08 can fail or yield incorrect parallelism. Invalid SR_NODE_JOBS
  # falls back to the measured CPU count; init validates it before allocating nodes.
  case "${SR_NODE_JOBS:-}" in ''|*[!0-9]*) ;; *) n=$((10#$SR_NODE_JOBS)); [ "$n" -gt 0 ] && { echo "$n"; return; };; esac
  for ip in ${NODES:-}; do
    n=$(timeout 8 ssh -n -i $KEY $SSHO $NUSER@$ip nproc 2>/dev/null); n=${n//[!0-9]/}
    [ -n "$n" ] && [ "$((10#$n))" -gt 0 ] && { echo "$((10#$n))"; return; }
  done
  n=$(printf '%s' "$ITYPE" | grep -oE '^[0-9]+')
  [ -n "$n" ] && [ "$((10#$n))" -gt 0 ] && { echo "$((10#$n))"; return; }
  echo 8; }

case "${1:-}" in
init)
  lifecycle_lock   # Only one concurrent init may pass the existence check below.
  # Resume an initializing farm from its saved minimal state instead of allocating
  # again. A previous timeout may have left nodes that become ready later.
  CONT=0
  if [ -f "$STATE" ]; then
    { load_state || exit 1; }
    if [ "${FARM_STATUS:-}" = initializing ]; then
      CONT=1; ID=$CID; NAME=${CLUSTER:-$NAME}
      [ -n "${WORKERS:-}" ] && WANTW=$WORKERS
      echo "== 发现上次未完成的初始化（cluster_id=$ID，申请 ${WANTW:-$WORKERS} 台），从断点继续，不重新申请机器"
    else
      echo "已有农场，先 sr-farm down 或用 sr-farm status 查看"; exit 1
    fi
  fi
  WANTW=${WANTW:-$WORKERS}
  [ -n "$NODEPW" ] || { echo "!! 首次给节点铺 ssh 密钥需要节点初始密码：在 srdev.conf 里设 SR_NODE_PASSWORD 后重试"; exit 1; }
  # UID-derived ports can collide. Before allocating a farm, reject any listener that
  # cannot be attributed to our service and explain how to change the ports.
  # Allow our scheduler on SPORT and SPORT+1 after down, and our persistent local
  # iceccd on DPORT after a build; an occupied port alone is not a conflict.
  while read -r _p _svc; do
    [ -n "${_p:-}" ] || continue
    [ -n "$(ss -ltnH "sport = :$_p" 2>/dev/null)" ] || continue
    port_is_ours "$_p" "$_svc" && continue
    echo "!! 端口 $_p 已被本机其他进程占用（不是我们的 $_svc），而农场要用它（scheduler $SPORT/$((SPORT+1))、本机 daemon $DPORT）。"
    echo "   这些端口按 uid 推导：SPORT=18700+2*(uid%250)、DPORT=19700+uid%500，uid 相差 250/500 的两个人会撞在一起。"
    echo "   在 srdev.conf 里显式设 SPORT= 和/或 DPORT= 错开，再 sr farm init。"
    exit 1
  done <<EOF
$SPORT icecc-scheduler
$((SPORT+1)) icecc-scheduler
$DPORT iceccd
EOF
  # Validate before allocating: SR_NODE_JOBS must be empty (automatic) or a positive integer.
  if [ -n "${SR_NODE_JOBS:-}" ] && ! printf '%s' "$SR_NODE_JOBS" | grep -qE '^[1-9][0-9]*$'; then
    echo "!! SR_NODE_JOBS='$SR_NODE_JOBS' 非法：留空=按节点 CPU 核数自动定，或填正整数（如 6）。已中止，未申请集群。"; exit 1
  fi
  [ "${WORKERS:-0}" -ge 1 ] 2>/dev/null || { echo "!! WORKERS 必须是 ≥1 的整数（现为 '${WORKERS:-}'）"; exit 1; }
  [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N "" -f "$KEY" -C sr-farm   # Dedicated key; leave the user's personal ~/.ssh untouched.
  sched_ensure || exit 1
  # WORKERS is the total billable machine count. The platform requires one FE, which
  # also acts as a worker, so request WORKERS-1 BEs.
  # Never adopt an existing cluster by name. Without local state, down cannot safely
  # release it, and provisioning could stop services on unrelated machines.
  PRE=$($API cid "$NAME" 2>/dev/null)
  if [ $CONT = 1 ]; then
    # A resumed initialization must find exactly the cluster recorded in local state.
    # Stop on a mismatch rather than provisioning machines belonging to another cluster.
    [ "$PRE" = "$CID" ] || { echo "!! 记录里的 cluster_id=$CID，但平台上叫 $NAME 的是 ${PRE:-不存在}。"
                             echo "   两边对不上，不继续部署。请到平台核对后，sr farm down 清记录再重新 init。"; exit 1; }
  else
    # Never adopt an existing cluster by name.
    [ -n "$PRE" ] && { echo "!! 平台上已存在同名集群 $NAME (id=$PRE)，不会认领它。"
                       echo "   若它是你的旧农场：先 sr farm down 释放；若本地已无记录，请到平台上核对后手工释放再重试。"; exit 1; }
  fi
  if [ $CONT = 0 ]; then
  echo "== 申请集群 $NAME（$WORKERS × $ITYPE，磁盘 ${DISK}G，全部当 worker；scheduler 跑在本容器）…"
  # A failed create response leaves the result uncertain: the platform may have
  # accepted the request before a timeout or parsing failure. Stop provisioning and
  # require manual verification so an untracked billable cluster is not overlooked.
  $API create "$NAME" "$(( WORKERS - 1 ))" 2 "$ITYPE" "$DISK" || {
    echo "!! 创建集群的请求未确认成功，已中止部署。"
    echo "   注意：这不代表平台上没建出来——响应超时或断连时集群可能已经创建并开始计费。"
    echo "   请按名字 $NAME 和创建时间到平台核对；若确实建出来了，手工释放后再重试 sr farm init。"; exit 1; }
    # Record the cluster ID immediately after creation, before waiting for Running.
    # Otherwise interruption could leave a billable cluster that down cannot recover.
    # Poll briefly because the platform's cluster list may lag behind creation.
    for i in $(seq 1 10); do ID=$($API cid "$NAME"); [ -n "$ID" ] && break; sleep 3; done
    [ -n "$ID" ] || { echo "!! 创建后取不到集群 $NAME 的 id（等了 30 秒）。可能创建未真正生效，也可能平台延迟。"
                      echo "   已中止，不做任何部署。请到平台核对是否有新建出来的 $NAME，有就手工释放后重试。"; exit 1; }
  fi
  # Save minimal state.env with the cluster ID and initializing status immediately.
  # Then down can release the cluster if any later step fails or is interrupted.
  # If saving fails, stop and report the ID and recovery steps; never silently leave
  # a billable cluster without a local record.
  printf 'CLUSTER=%s\nCID=%s\nSCHED=%s\nWORKERS=%s\nNETNAME=%s\nSPORT=%s\nDPORT=%s\nFARM_STATUS=initializing\n' \
    "$NAME" "$ID" "$HOSTIP" "$WANTW" "$NETNAME" "$SPORT" "$DPORT" > "$STATE.tmp" && mv -f "$STATE.tmp" "$STATE" || {
    rm -f "$STATE.tmp" 2>/dev/null
    echo "!! 写不下农场状态 $STATE（盘满？$FARM 不可写？），但集群已经建出来并开始计费。"
    echo "   集群名 $NAME，cluster_id=$ID。请到平台手工释放它，或腾出空间后用这个 id 重建记录。"
    exit 1; }   # Atomic replacement prevents readers from seeing partial records.
  echo "== 等待 RUNNING（约 5-6 分钟）…"
  # Require Running before reading nodes. A timed-out APPLYING cluster may return
  # an incomplete node list, which must not be mistaken for a fully provisioned farm.
  RUNOK=0
  for i in $(seq 1 45); do sleep 20; S=$($API row "$NAME"|cut -d'|' -f1); [ "$S" = Running ] && { RUNOK=1; break; }; done
  # Check readiness before disabling cleanup; that API silently has no effect while APPLYING.
  if [ "$RUNOK" != 1 ]; then
    echo "!! 等了 15 分钟平台仍不是 Running（最后一次读到 '${S:-读不到}'）。已中止部署，状态留在 initializing。"
    echo "   集群 $ID 仍在——稍后**再跑一次 sr farm init** 会从断点继续，不会重新申请机器；确定不要了就 sr farm down 回收。"
    exit 1
  fi
  # Call only after RUNNING; the platform silently ignores it during APPLYING.
  $API op "$ID" disable_auto_release >/dev/null
  NODES=$($API nodes "$NAME")
  [ -n "$NODES" ] || { echo "取不到节点 IP，中止（集群 $ID 仍在，可 sr-farm down 清理）"; exit 1; }
  SCHED=$HOSTIP; NW=$(echo $NODES | wc -w)
  if [ "$NW" -ne "$WANTW" ]; then
    echo "!! 申请了 $WANTW 台，平台只给出 $NW 台节点。已中止部署，状态留在 initializing。"
    echo "   集群 $ID 仍在——节点补齐后再跑一次 sr farm init 会从断点继续；确定不要了就 sr farm down 回收。"
    exit 1
  fi
  echo "   cluster_id=$ID  scheduler=$SCHED(本容器)  worker($NW): $NODES"
  echo "== 铺密钥 + 部署 icecc（顺便清掉 TSP 的 StarRocks：FE 的 -Xmx26g 会压垮 8c32g 节点）…"
  # Require both successful provisioning and worker connections. A TCP connection
  # alone does not prove the daemon loaded the intended configuration.
  PROV_OK=1; provision_nodes 1 || PROV_OK=0   # Reinstall keys on retry too: it is idempotent, and the earlier attempt may have stopped before this step.
  WORKERS=$NW
  if wait_workers 30 && [ "$PROV_OK" = 1 ]; then INIT_STATUS=running
  else INIT_STATUS=degraded
       [ "$PROV_OK" = 1 ] || echo "!! 有节点的 node-setup.sh 返回失败，即使都连上了也标 degraded（配置可能没写对）。"
       echo "!! 只有 $(dcount)/$NW 台 worker 连上 scheduler，已标 degraded。上面每行的 iceccd= 字段能看出哪台没装上。"
       echo "   修复：sr farm resume（会重新下发并校验）"
  fi
  NCPU=$(node_jobs)   # Per-node slots for sr-build's total parallelism; SSH is available after provisioning.
  printf 'CLUSTER=%s\nCID=%s\nSCHED=%s\nNODES="%s"\nWORKERS=%s\nNCPU=%s\nNETNAME=%s\nSPORT=%s\nDPORT=%s\nFARM_STATUS=%s\n' \
         "$NAME" "$ID" "$SCHED" "$NODES" "$NW" "$NCPU" "$NETNAME" "$SPORT" "$DPORT" "$INIT_STATUS" > "$STATE.tmp" && mv -f "$STATE.tmp" "$STATE" || {
    rm -f "$STATE.tmp" 2>/dev/null
    echo "!! 写不下最终农场状态 $STATE（盘满？）。集群 $ID 已部署好但记录仍停在 initializing，"
    echo "   看门狗不会续约，它会在租期到点后被释放。腾出空间后再跑一次 sr farm init（会从断点继续）。"
    exit 1; }
  beat; wd_ensure
  # Release the lifecycle lock before warmup, which may take minutes, so suspend/down
  # can proceed. Include warmup in readiness reporting: unscored workers may receive
  # no tasks even though the cluster is running.
  { exec 8>&-; } 2>/dev/null; warm_workers; WARM_RC=$?
  # Change only the report, not FARM_STATUS. State validation and the watchdog
  # recognize running; incomplete warmup does not make the cluster itself unavailable.
  echo ""
  if [ "$INIT_STATUS" = degraded ]; then
    echo "== 初始化未完成（degraded）==============================="
  elif [ "${WARM_RC:-0}" = 2 ]; then
    # Report skipped warmup explicitly: zero-score workers may receive no tasks,
    # leaving all compilation on the local container despite a running farm.
    echo "== 集群已建好，但【尚未预热】=============================="
    echo "   worker 的 speed 还是 0，scheduler 不会派活 —— 现在编译会全压本机。"
    echo "   跑一次 sr build（它会拉起本机 iceccd），再 sr farm rebalance 即可。"
  else
    echo "== 农场就绪 =========================================="
  fi
  printf "   集群 %s (id=%s)   区域 %s\n" "$NAME" "$ID" "$($API spec "$NAME" | cut -d'|' -f4)"
  printf "   规格 %s × %s   磁盘 %sG/台   scheduler 在本容器 %s:%s   网络名 %s\n" \
         "$NW" "$($API spec "$NAME" | cut -d'|' -f2)" "$($API spec "$NAME" | cut -d'|' -f3)" "$SCHED" "$SPORT" "$NETNAME"
  echo "   节点："
  for ip in $NODES; do
    n_ssh "$ip" "printf '     %-15s %sc / %sG 内存 / 根盘%s 可用 / 数据盘%s\n' \
      \"\$(hostname -I|awk '{print \$1}')\" \"\$(nproc)\" \"\$(free -g|awk '/Mem:/{print \$2}')\" \
      \"\$(df -h / | awk 'NR==2{print \$4}')\" \"\$(df -h /home/disk1 2>/dev/null | awk 'NR==2{print \$2}' || echo 无)\"" 2>/dev/null
  done
  echo "======================================================"
  echo "== 看门狗每 ${RENEW_MIN} 分钟续约 ${RENEW_H} 小时；空闲 ${IDLE_MIN} 分钟自动休眠。"
  echo "   容器关闭 → 续约停止 → 农场 ${RENEW_H} 小时内自动释放。"
  # Return failure for degraded readiness while preserving state and the watchdog for recovery.
  if [ "$INIT_STATUS" = degraded ]; then
    echo "!! 初始化未完成（degraded）：worker 未全部连上。状态与看门狗已保留，修好节点后 sr farm resume；本命令以非零退出。"; exit 2
  fi
  ;;
# Resource view: scheduler control port (SPORT+1), one SSH hop per node, and local cgroup. --watch [seconds] refreshes it.
usage)
  [ -f "$STATE" ] || { echo "当前无农场"; exit 1; }
  { load_state || exit 1; }
  CG=/sys/fs/cgroup   # sched_q is defined globally.
  once(){
    local hdr cs jobs u0 u1 cores mem memmax
    cs=$(sched_q listcs 2>/dev/null); hdr=$(printf '%s\n' "$cs" | sed -n 's/^200-ICECC \([^:]*\): \([0-9]*\)s uptime, \([0-9]*\) hosts, \([0-9]*\) jobs in queue (\([0-9]*\) total).*/scheduler \1 · 已运行 \2s · \3 台 daemon · 排队 \4 · 累计派发 \5/p')
    total=$(printf '%s\n' "$cs" | sed -n 's/.*(\([0-9]*\) total).*/\1/p' | head -1); total=${total:-0}
    echo "== 集群 $CLUSTER (id=$CID)  平台 $($API row "$CLUSTER" 2>/dev/null | cut -d'|' -f1)/本地 $FARM_STATUS  到期 $($API row "$CLUSTER" 2>/dev/null | cut -d'|' -f2)"
    echo "   ${hdr:-scheduler 文本口 :$((SPORT+1)) 连不上}"
    echo "== scheduler 视图（jobs=当前/上限，load 为 icecc 千分制）"
    printf '   %-26s %-15s %-9s %-6s %s\n' 主机 IP jobs load speed
    printf '%s\n' "$cs" | grep -E '^ [^ ]+ \(' | sed -E 's/^ ([^ ]+) \(([0-9.]+):[0-9]+\) \[[^]]*\] speed=([0-9.]+) jobs=([0-9]+\/[0-9]+) load=([0-9]+).*/\1 \2 \4 \5 \3/' \
      | awk -v me="$HOSTIP" -v total="$total" '{tag=($2==me)?"(本机)":""; starving=($2!=me && $5+0==0 && total>200); if(starving) tag="<- 从未接到任务(speed=0)"; printf "   %-26s %-15s %-9s %5.1f%% %s %s\n", substr($1,1,26), $2, $3, $4/10, $5, tag; split($3,a,"/"); if($2!=me){cur+=a[1]; cap+=a[2]}; if(starving) idle++} END{printf "   远端合计 %d/%d 槽在用\n", cur, cap; if(idle>0) printf "   !! %d 台 worker 在 scheduler 已派发 %d 个任务后仍 speed=0：它一直没接到任务（多半是 env 缓存空，而 scheduler 有了其它主机的统计就不再试新主机）。\n      修复：sr farm rebalance（重启 scheduler，统计清零后随机分派、顺带给它装 env；进行中的任务会短暂回退本地）\n", idle, total}'
    jobs=$(sched_q listjobs 2>/dev/null | grep -vE '^200|^$'); [ -n "$jobs" ] && { echo "== 正在派发的任务（前 10）"; printf '%s\n' "$jobs" | head -10 | cut -c1-150 | sed 's/^/   /'; }
    echo "== 节点实际负载（ssh 一跳：loadavg 1m/5m · 内存 · 编译进程数）"
    # Fetch node statistics in parallel but write each result to a temporary file
    # named by IP. Print in numeric IP order so rows remain stable during --watch.
    NLD=$(mktemp -d /tmp/sr-nodeload.XXXXXX)
    for ip in $NODES; do
      ( r=$(timeout 8 ssh -n -i $KEY $SSHO $NUSER@$ip 'printf "%s %s|%s|%s|%s\n" $(cut -d" " -f1,2 /proc/loadavg) "$(free -m | awk "/^Mem:/{print \$3\"/\"\$2\"M\"}")" "$(pgrep -c cc1plus)" "$(nproc)"' 2>/dev/null)
        { [ -n "$r" ] && printf '   %-15s load %-12s mem %-14s cc1plus %-3s /%s 核\n' "$ip" "$(echo "$r"|cut -d'|' -f1)" "$(echo "$r"|cut -d'|' -f2)" "$(echo "$r"|cut -d'|' -f3)" "$(echo "$r"|cut -d'|' -f4)" \
                    || printf '   %-15s (ssh 不通)\n' "$ip"; } > "$NLD/$ip" ) &
    done; wait
    # Sort all four IP components numerically; lexical order puts .10 before .9.
    for ip in $(printf '%s\n' $NODES | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n); do cat "$NLD/$ip" 2>/dev/null; done
    rm -rf "$NLD"
    echo "== 本容器"
    u0=$(awk '/^usage_usec/{print $2}' $CG/cpu.stat 2>/dev/null); sleep 1; u1=$(awk '/^usage_usec/{print $2}' $CG/cpu.stat 2>/dev/null)
    cores=$(awk -v a="${u0:-0}" -v b="${u1:-0}" 'BEGIN{printf "%.1f", (b-a)/1000000}')
    # memory.current includes page cache; anon better reflects actual compiler memory use.
    mem=$(awk '/^anon /{print $2}' $CG/memory.stat 2>/dev/null || echo 0); memmax=$(cat $CG/memory.max 2>/dev/null || echo max)
    printf '   CPU %s 核在用 / 配额 %s   内存(anon) %.1fG / %s   本地 cc1plus %s\n' "$cores" "$(awk '{printf "%d", $1/$2}' $CG/cpu.max 2>/dev/null || echo ?)" "$(echo "${mem:-0}" | awk '{print $1/1073741824}')" "$([ "$memmax" = max ] && echo 不限 || echo "$memmax" | awk '{printf "%.0fG", $1/1073741824}')" "$(pgrep -c cc1plus)"
    local t; for f in /farm/sr-build.*.lock; do [ -e "$f" ] || continue; t=$(cat "$f.tree" 2>/dev/null); ( exec 8>"$f"; flock -n 8 ) 2>/dev/null || echo "   正在编译: ${t:-?}"; done
    [ -f /farm/last-build ] && echo "   距上次编译 $(( ($(date +%s)-$(stat -c %Y /farm/last-build))/60 )) 分钟"
  }
  if [ "${2:-}" = --watch ]; then while true; do clear; date '+%F %T'; once; sleep "${3:-5}"; done; else once; fi ;;
status)
  [ -f "$STATE" ] || { echo "当前无农场"; exit 1; }
  { load_state || exit 1; }
  # Capture API output and exit status separately. A failed query must not look like
  # a missing cluster and prompt removal of a valid farm record after a transient error.
  ROW=$($API row "$CLUSTER"); RROW=$?
  if [ $RROW -ne 0 ]; then
    echo "!! 查询平台失败（$API row 退出码 $RROW），无法确认集群 $CLUSTER (id=$CID) 现在的状态。"
    echo "   这不代表农场没了。检查 ~/.tsp 凭据与网络后重试；确认没了再 sr farm down。"
    exit 1
  fi
  IFS='|' read -r S T N <<<"$ROW"
  # A successful query with no matching row means the cluster was released or cleaned up; only local state remains.
  if [ -z "$S" ]; then
    echo "!! 集群 $CLUSTER (id=$CID) 在平台上已不存在——很可能到期被释放（看门狗停过 3 小时以上？）。"
    echo "   本地记录状态=$FARM_STATUS 已失效。处理：sr farm down 清记录，再 sr farm init 重建。"
    exit 1
  fi
  LB=$(stat -c %Y $FARM/last-build 2>/dev/null || echo 0)
  sched_ensure; D=$(dcount)
  # A running watchdog does not prove renewals succeed. Report the last successful
  # renewal and flag an age exceeding two renewal intervals.
  LR=$(cat "$FARM/.last-renew" 2>/dev/null); LR=${LR//[!0-9]/}
  if [ -n "$LR" ]; then
    RAGE=$(( ($(date +%s)-LR)/60 ))
    if [ "$RAGE" -gt $(( RENEW_MIN * 2 )) ]; then RENEWMSG="$RAGE 分钟前（!! 超过两个周期，续约可能已失败，看 $LOGF）"
    else RENEWMSG="$RAGE 分钟前"; fi
  elif pgrep -f '[s]r-farm _watchdog' >/dev/null; then RENEWMSG="还没有成功记录（看门狗刚起？超过 $RENEW_MIN 分钟仍如此就看 $LOGF）"
  else RENEWMSG="无记录（看门狗没在跑）"; fi
  printf "集群 %s (id=%s)\n平台状态 %s / 本地记录 %s\n到期 %s   22点清扫 %s\nscheduler %s:%s(本容器)   worker 已连 %s/%s\n距上次编译 %d 分钟\n看门狗 %s   上次成功续约 %s\n" \
    "$CLUSTER" "$CID" "$S" "$FARM_STATUS" "$T" "$N" "$SCHED" "$SPORT" "$D" "$WORKERS" $(( ($(date +%s)-LB)/60 )) \
    "$(pgrep -f '[s]r-farm _watchdog' >/dev/null && echo 运行中 || echo 已停)" "$RENEWMSG"
  ;;
resume|up)
  lifecycle_lock
  { load_state || exit 1; }
  # Only init can continue an initializing farm that may not yet have nodes.
  # Direct the user there instead of attempting resume.
  [ "${FARM_STATUS:-}" = initializing ] && { echo "!! 上次 sr farm init 未完成（状态 initializing）。再跑一次 sr farm init 会从断点继续，不会重新申请机器；确定不要了就 sr farm down 回收"; exit 1; }
  [ "${FARM_STATUS:-}" = releasing ] && { echo "!! 农场正在释放（上次 sr farm down 未确认完成），先 sr farm down 清理后再 init"; exit 1; }
  sched_ensure || exit 1
  pstate(){ $API row "$CLUSTER" 2>/dev/null | cut -d'|' -f1; }
  # Wait for a pending suspend operation to settle before starting. The platform
  # may silently ignore start while Updating; then wait explicitly for Running.
  for i in $(seq 1 30); do case "$(pstate)" in Updating|Stopping|Starting) sleep 5;; *) break;; esac; done
  [ "$(pstate)" = Running ] || $API op "$CID" start >/dev/null
  for i in $(seq 1 36); do [ "$(pstate)" = Running ] && break; sleep 5; done
  [ "$(pstate)" = Running ] || { echo "!! 平台 3 分钟内未到 Running（现在 $(pstate)），稍后再试 sr farm resume"; exit 1; }
  # Verify actual worker readiness before recording running; saved state alone is
  # not enough. A degraded farm must be provisioned and verified again even if all
  # workers reconnect, since a live daemon may still have stale configuration.
  if [ "${FARM_STATUS:-}" = degraded ]; then
    echo "== 上次标记为 degraded，强制重新下发节点配置（不能只看连接数）…"
    PROV_OK=1; provision_nodes 0 || PROV_OK=0
    if wait_workers 60 && [ "$PROV_OK" = 1 ]; then
      echo "修复后就绪：$WORKERS 台 worker 已连"
    else
      [ "${PROV_OK}" = 1 ] || echo "!! 有节点的 node-setup.sh 仍返回失败。"
      echo "!! 仍不健康：$(dcount)/$WORKERS 连上，保持 degraded。"
      echo "   排查：sr farm status / 节点上 systemctl status iceccd / scheduler 端口 $SPORT"
      exit 1
    fi
  elif wait_workers 60; then
    echo "农场就绪：$WORKERS 台 worker 已连"
  else
    echo "== 120 秒内 worker 未全部连上（$(dcount)/$WORKERS），重新下发节点配置修复…"
    # Provisioning failure remains a failure even if all daemons connect; they may be using old configuration.
    PROV_OK=1; provision_nodes 0 || PROV_OK=0
    if wait_workers 45 && [ "$PROV_OK" = 1 ]; then echo "修复后就绪：$WORKERS 台 worker 已连"
    else
      sed -i 's/^FARM_STATUS=.*/FARM_STATUS=degraded/' "$STATE"; wd_ensure
      [ "${PROV_OK:-1}" = 1 ] || echo "!! 有节点的 node-setup.sh 返回失败，配置可能没写对。"
      echo "!! 农场不健康：仅 $(dcount)/$WORKERS 连上，已标记 degraded，sr build 会拒绝开工。"
      echo "   排查：sr farm status / 节点上 systemctl status iceccd / scheduler 端口 $SPORT"
      exit 1
    fi
  fi
  # Reset the idle timer on manual resume so the watchdog does not immediately suspend the farm again.
  beat; sed -i 's/^FARM_STATUS=.*/FARM_STATUS=running/' "$STATE"; wd_ensure
  { exec 8>&-; } 2>/dev/null; warm_workers ;;   # Release the lock before warmup; resumed workers may have lost their speed scores.
suspend)
  lifecycle_lock
  { load_state || exit 1; }
  # Automatic suspend passes --if-idle and rechecks activity under the lifecycle
  # lock, since a build may start after the watchdog's initial check. Manual suspend
  # is unconditional. A small remaining race is acceptable: builds fall back locally.
  if [ "${2:-}" = --if-idle ]; then
    LBN=$(stat -c %Y "$FARM/last-build" 2>/dev/null || echo 0)
    IDLEN=$(( ($(date +%s)-LBN)/60 ))
    if busy || [ "$IDLEN" -lt "${SR_IDLE_MIN_AT_DECIDE:-$IDLE_MIN}" ]; then
      echo "$(date '+%F %T') 复核时发现有构建在跑（或刚开工 ${IDLEN} 分钟），取消这次自动休眠"; exit 0
    fi
  fi
  # Record suspended only after a successful platform operation. On failure, retain
  # state and return nonzero so the next idle cycle can retry.
  if $API op "$CID" stop >/dev/null; then
    sed -i 's/^FARM_STATUS=.*/FARM_STATUS=suspended/' "$STATE"; echo "已休眠（仍继续续约，否则睡着也会到期）"
  else
    echo "!! 休眠请求未成功，状态保持 ${FARM_STATUS:-?}（机器仍在跑，继续计费）。下个空闲周期会重试，或手动 sr farm suspend"; exit 1
  fi ;;
down|release)
  lifecycle_lock
  if [ -f "$STATE" ]; then { load_state || exit 1; }
    # Check existence first so repeated down can clear state after the cluster is gone.
    # exists returns 0 for present, 1 for absent, and 2 for query failure; never treat
    # a failed query as proof that the cluster disappeared.
    $API exists "$CID" >/dev/null 2>&1; EX=$?
    case $EX in
      1) echo "平台上已无集群 $CID，清理本地记录" ;;
      2) echo "!! 查询平台失败，无法确认，保留状态（CID=$CID），稍后重试 sr farm down"; exit 1 ;;
      0) $API op "$CID" release >/dev/null || { echo "!! 释放请求失败，保留状态（CID=$CID），稍后重试 sr farm down"; exit 1; }
         # A returned request is not proof of acceptance. Wait for disappearance or a release
         # state (Releas*/Delet*/Destroy*/Terminat*/Remov*) before marking releasing or
         # stopping renewals. If neither appears within 60 seconds, retain the original state.
         ST=""; EX=0
         for i in $(seq 1 12); do sleep 5; ST=$($API exists "$CID" 2>/dev/null); EX=$?
           [ $EX = 0 ] || break
           case "$ST" in [Rr]eleas*|[Dd]elet*|[Dd]estroy*|[Tt]erminat*|[Rr]emov*) break;; esac
         done
         case $EX in
           1) echo "平台确认集群已消失" ;;
           2) echo "!! 释放请求已发出但随后查询失败，无法确认，状态原样保留（CID=$CID），稍后重试 sr farm down"; exit 1 ;;
           0) case "$ST" in
                [Rr]eleas*|[Dd]elet*|[Dd]estroy*|[Tt]erminat*|[Rr]emov*)
                  sed -i 's/^FARM_STATUS=.*/FARM_STATUS=releasing/' "$STATE"; pkill -f "[s]r-farm _watchdog" 2>/dev/null
                  echo "平台状态 $ST：释放中。已标 releasing 并停止续约；稍后再执行 sr farm down 确认并清理本地记录"; exit 0 ;;
                *) echo "!! 释放请求发出 60 秒后平台仍显示 ${ST:-?}，释放未被接受。状态原样保留、续约继续（CID=$CID），请到平台排查"; exit 1 ;;
              esac ;;
         esac ;;
    esac
  fi
  pkill -f "[s]r-farm _watchdog" 2>/dev/null
  rm -f "$STATE"; echo "已释放并停止看门狗" ;;
# Restart the scheduler to reset scores that can starve new or unscored workers.
# Initial assignments repopulate environments across workers. Active builds briefly
# fall back to local compilation until connections recover.
rebalance)
  lifecycle_lock; [ -f "$STATE" ] || { echo "当前无农场"; exit 1; }; { load_state || exit 1; }
  pkill -x icecc-scheduler 2>/dev/null; sleep 1; sched_ensure || exit 1
  echo "scheduler 已重启（:$SPORT）。worker 在 1~3 分钟内重连…"
  { exec 8>&-; } 2>/dev/null; warm_workers   # Warm up after restart so late reconnecting workers do not remain unscored and starved.
  echo "完成。sr farm usage 里各台 speed 应都 > 0" ;;
_wd) wd_ensure; exit 0 ;;
_watchdog)
  # Hold the singleton lock for the watchdog's entire lifetime; exit if already held.
  # Reserve fd 6 for this lock; fd 8 is the lifecycle lock and fd 9 the build lock.
  { exec 6>"$FARM/watchdog.lock"; } 2>/dev/null || { echo "$(date '+%F %T') 打不开看门狗单例锁，退出" >>"$LOGF"; exit 1; }
  # Retry briefly: another watchdog usually holds the lock, but a short-lived child
  # may still have inherited fd 6. Persistent children explicitly close it.
  WDGOT=0
  for _i in 1 2 3 4 5; do flock -n 6 && { WDGOT=1; break; }; sleep 3; done
  if [ $WDGOT = 0 ]; then
    # Log lock contention without trying to identify another watchdog with pgrep.
    # It can match this process or timeout/setsid wrappers, so attribution is unreliable.
    # wd_ensure already handles the common case with a fast process check.
    echo "$(date '+%F %T') 拿不到看门狗单例锁（重试 15 秒）。若确有另一个看门狗在跑，这行可忽略；" >>"$LOGF"
    echo "$(date '+%F %T')   否则可能有子进程继承了锁 fd，续约会停摆——下次 sr build 会再拉一次，或手动 sr farm resume" >>"$LOGF"
    exit 0
  fi
  RENEW_FAILS=0
  while true; do
    [ -f "$STATE" ] || exit 0
    # Reload site configuration each cycle so timer changes reach the persistent
    # watchdog. Reset to the original environment first: sourcing alone does not clear
    # removed settings. Load before state.env; their keys do not overlap.
    IDLE_MIN=$ENVBASE_IDLE_MIN; RENEW_MIN=$ENVBASE_RENEW_MIN; RENEW_H=$ENVBASE_RENEW_H
    [ -f "$SRCONF" ] && { set -a; . "$SRCONF"; set +a; }
    IDLE_MIN=${IDLE_MIN:-15}; RENEW_MIN=${RENEW_MIN:-15}; RENEW_H=${RENEW_H:-3}
    load_state || { echo "$(date '+%F %T') state.env 解析失败（损坏或被篡改），看门狗退出，停止续约" >>"$LOGF"; exit 1; }
    # Stop renewing or waking a releasing cluster; do not rely solely on down having killed the watchdog.
    [ "${FARM_STATUS:-}" = releasing ] && { echo "$(date '+%F %T') 农场正在释放，看门狗停止续约并退出" >>"$LOGF"; exit 0; }
    [ "${FARM_STATUS:-}" = running ] && sched_ensure
    # Record successful renewal time and consecutive failures. Log errors and retry
    # sooner so expired credentials or platform outages are visible through status
    # before the lease expires during a build.
    RWAIT=$RENEW_MIN
    if RENEW_ERR=$($API op "$CID" renew $RENEW_H 2>&1 >/dev/null); then   # Reset expiry to now + RENEW_H hours.
      RENEW_FAILS=0; date +%s > "$FARM/.last-renew" 2>/dev/null; chmod 666 "$FARM/.last-renew" 2>/dev/null
    else
      RENEW_FAILS=$((RENEW_FAILS+1)); RWAIT=1        # Retry failures after one minute rather than waiting a full renewal interval.
      echo "$(date '+%F %T') !! 续约失败（连续第 $RENEW_FAILS 次）：${RENEW_ERR:0:200}" >>"$LOGF"
      [ "$RENEW_FAILS" = 3 ] && echo "$(date '+%F %T') !! 已连续 3 次续约失败，农场会在租期到点后被平台释放。请检查 ~/.tsp 凭据与平台可达性。" >>"$LOGF"
    fi
    # The platform resets auto-release at midnight and may clean up the farm at 22:00.
    # Reapply this inexpensive, idempotent setting each cycle.
    $API op "$CID" disable_auto_release >/dev/null 2>&1 \
      || echo "$(date '+%F %T') !! disable_auto_release 失败，农场可能在 22 点被平台清扫" >>"$LOGF"
    # Manual wakeup hook: touch /farm/resume-request to request resume on the next
    # watchdog cycle. No repository code creates this file automatically.
    if [ -f "$FARM/resume-request" ]; then
      rm -f "$FARM/resume-request"; "$0" resume >>"$LOGF" 2>&1 6>&-
    else
      LB=$(stat -c %Y $FARM/last-build 2>/dev/null || echo 0)
      IDLE=$(( ($(date +%s)-LB)/60 ))
      # This is only a preliminary idle check; suspend rechecks under its lifecycle lock
      # with --if-idle in case a build has started. Close fd 6 in the child so it cannot
      # retain the watchdog's singleton lock.
      if [ "$IDLE" -ge "$IDLE_MIN" ] && [ "${FARM_STATUS:-}" = running ] && ! busy; then
        echo "$(date '+%F %T') 空闲 ${IDLE} 分钟 -> 休眠" >>"$LOGF"
        SR_IDLE_MIN_AT_DECIDE=$IDLE_MIN "$0" suspend --if-idle >>"$LOGF" 2>&1 6>&-
      fi
    fi
    # Check scheduler health more frequently than lease renewal. Its failure sends all
    # tasks to the local daemon, which still limits parallelism but reduces throughput.
    for _ in $(seq 1 $((RWAIT))); do
      sleep 60 6>&-      # Close the singleton lock in sleep so restarting a killed watchdog does not have to wait up to 60 seconds.
      [ -f "$STATE" ] || exit 0
      [ "${FARM_STATUS:-}" = running ] && { sched_ensure; warm_if_starving; }
    done
  done ;;
*) cat <<U
用法: sr-farm {init|status|usage|rebalance|resume|suspend|down}
  init                 申请农场并部署；之后自动续约、空闲自动休眠、故障自愈
  status               集群状态 / 到期 / daemon 连接数 / 距上次编译 / 看门狗
  usage [--watch [秒]]  scheduler 各 worker 槽位与负载、节点实际负载、本容器 CPU/内存
  rebalance            重启 scheduler 并预热所有 worker（有 worker 长期拿不到任务时用）
  resume               唤醒
  suspend              休眠
  down                 释放并停看门狗
U
;;
esac
