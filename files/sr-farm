#!/bin/bash
# sr-farm —— 编译农场生命周期（跑在容器内）
#   续约用「重置为 N 小时」语义：容器一关，续约停止，农场 1 小时内自我了断。
#   这是刻意的死人开关设计。
set -uo pipefail
# 站点配置由宿主机 sr 只读挂进来；set -a 让 tspapi.py / ssh 子进程也看得到
# 优先读宿主机每次调用同步进来的 /farm/srdev.conf（目录挂载，改了立刻可见）；/etc/srdev.conf 是旧的单文件挂载，
# 钉在容器创建时的 inode 上、编辑器保存后就过期（实测容器读到的一直是旧 WORKERS/ITYPE），只作为老容器的兼容回退
SRCONF=/farm/srdev.conf; [ -f "$SRCONF" ] || SRCONF=/etc/srdev.conf
# 先记下纯环境变量给的值（source 之前），看门狗每轮热加载时按它复位——否则从配置里删掉某项后，
# 变量在长跑进程里仍留着上一轮的值，`${VAR:-默认}` 永远取不到默认（codex r9#1）。同时保持"环境覆盖配置"的优先级。
# 看门狗子进程优先用父进程显式传来的基线（用 - 而非 :- ，空字符串也算"父进程说了算"）；
# 其它调用是干净环境，直接取当前环境值。
ENVBASE_IDLE_MIN=${SR_WD_BASE_IDLE-${IDLE_MIN:-}}
ENVBASE_RENEW_MIN=${SR_WD_BASE_RENEW_MIN-${RENEW_MIN:-}}
ENVBASE_RENEW_H=${SR_WD_BASE_RENEW_H-${RENEW_H:-}}
[ -f "$SRCONF" ] && { set -a; . "$SRCONF"; set +a; }
API=${SR_TSPAPI:-/usr/local/bin/tspapi.py}   # SR_TSPAPI/SR_FARM_DIR 供隔离测试替换平台客户端与状态目录
FARM=${SR_FARM_DIR:-/farm}
STATE=$FARM/state.env
# review r7#3(P1)：state.env 不再 source（目录曾是 0777，可被替换后当 root 执行）。只接受白名单键的 KEY=value 并校验取值形状，
# 任何一行不合规就拒绝加载——文件是我们自己 printf 写的，合规是常态，不合规就是损坏或篡改。
load_state(){ local k v
  [ -f "$STATE" ] || return 1
  while IFS='=' read -r k v || [ -n "$k" ]; do
    v=${v%\"}; v=${v#\"}
    case "$k" in
      CLUSTER|NETNAME) [[ "$v" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || { echo "!! state.env 的 $k 取值非法: '$v'" >&2; return 1; } ;;
      CID|WORKERS|NCPU|SPORT|DPORT) [[ "$v" =~ ^[0-9]{1,10}$ ]] || { echo "!! state.env 的 $k 不是整数: '$v'" >&2; return 1; } ;;
      SCHED) [[ "$v" =~ ^[0-9.]{7,15}$ ]] || { echo "!! state.env 的 SCHED 不像 IP: '$v'" >&2; return 1; } ;;
      NODES) [[ "$v" =~ ^[0-9.\ ]*$ ]] || { echo "!! state.env 的 NODES 不像 IP 列表: '$v'" >&2; return 1; } ;;
      FARM_STATUS) case "$v" in initializing|running|degraded|suspended|releasing) ;; *) echo "!! state.env 的 FARM_STATUS 非法: '$v'" >&2; return 1;; esac ;;
      ''|'#'*) continue ;;
      *) echo "!! state.env 含未知键 '$k'，拒绝加载" >&2; return 1 ;;
    esac
    printf -v "$k" '%s' "$v"
  done < "$STATE"; }
# review r7#5：init/resume/suspend/down/rebalance 的「读状态→平台操作→写状态」全程互斥，否则 resume 会把并发 suspend 刚写的
# suspended 覆盖回 running。常驻进程（看门狗、scheduler）启动时必须关掉继承的 fd 8，否则锁被永久占住。
lifecycle_lock(){
  # 拿不到锁文件就拒绝操作（fail closed）：无互斥地改农场状态比拒绝更危险；/farm 打不开本身就说明环境坏了
  # 验证轮 #5：无命令的 `exec ... 2>/dev/null` 会把 stderr 永久重定向到 /dev/null，后续所有报错都被吞；用 { } 把它限定在这一句
  { exec 8>"$FARM/lifecycle.lock"; } 2>/dev/null || { echo "!! 无法打开 $FARM/lifecycle.lock，拒绝在无互斥保护下操作农场"; exit 1; }
  flock -w 600 8 || { echo "!! 另一个农场操作正在进行（等锁 10 分钟超时），稍后再试"; exit 1; }; }
LOGF=$FARM/watchdog.log
KEY=$FARM/ssh/id_farm
NAME=${FARM_NAME:-${SR_USER:-$(id -un)}_farm}
WORKERS=${WORKERS:-4}
ITYPE=${ITYPE:-8c32g}
DISK=${DISK:-20}   # 实测 icecc 在 worker 上只占 4KB，不需要数据盘
IDLE_MIN=${IDLE_MIN:-15}     # resume 实测 29 秒，可以激进休眠
WARM_EVERY_MIN=${SR_WARM_EVERY_MIN:-5}   # 看门狗最多每 N 分钟自动预热一次（某台真坏了也不会每分钟空转）
RENEW_MIN=${RENEW_MIN:-15}
RENEW_H=${RENEW_H:-3}       # renew 语义是「重置为 now+N」而非累加，实测确认
NUSER=${SR_NODE_USER:-sr}          # 节点 ssh 用户
NODEPW=${SR_NODE_PASSWORD:-}       # 节点初始密码，只在首次铺密钥时用，之后全走密钥；不要写进代码
mkdir -p $FARM/ssh 2>/dev/null; chmod 700 $FARM/ssh 2>/dev/null
SSHO="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10"
n_ssh(){ ssh -n -i $KEY $SSHO $NUSER@"$1" "$2"; }
beat(){ : > $FARM/last-build 2>/dev/null; chmod 666 $FARM/last-build 2>/dev/null; }
# 9>&- 不能省：sr-build 是持着构建锁(fd 9)调过来的，看门狗常驻会把那把锁永久占住
# （踩过：编译早已结束、ps 里没有 sr-build，却一直报「已有构建在进行」）
# 8>&-：别把生命周期锁带进常驻进程。SR_WD_BASE_*：把「source 配置之前」的纯环境基线显式传给看门狗——
# 父进程是 set -a 导出配置后才 fork 的，子进程若自己从环境里取基线，取到的是被配置污染的值，
# 于是从配置里删掉某项后永远回不到默认（codex r10#5）。
wd_ensure(){ pgrep -f "[s]r-farm _watchdog" >/dev/null || {
  SR_WD_BASE_IDLE="$ENVBASE_IDLE_MIN" SR_WD_BASE_RENEW_MIN="$ENVBASE_RENEW_MIN" SR_WD_BASE_RENEW_H="$ENVBASE_RENEW_H" \
    setsid nohup "$0" _watchdog </dev/null >>"$LOGF" 2>&1 8>&- 9>&- & }; }
# scheduler 跑在本容器里：实测它只占 3.2MB / 0.5% CPU，纯中介（预处理源码和产物都是
# client 与 worker 直连传输，不经过它）。放这儿省下一整台 8c32g 去当 worker。
# 容器是 --network host，所以农场节点直接连宿主机 IP 即可（反向连通已实测五台全通）。
HOSTIP=$(hostname -I | awk '{print $1}')
# 每个用户一套独立的 icecc：宿主机是多人共享的开发机，默认端口只有第一个人抢得到，
# 后来者的 daemon 静默 bind 失败 -> 客户端连不上 -> 无限制本地并发 -> OOM（踩过）。
# 端口由 uid 推导，保证同一用户的 sr-farm 与 sr-build 算出同一组数；
# netname 再隔离一层，保证 worker 只认自己主人的 scheduler。
SR_USER=${SR_USER:-$(id -un)}
# 容器里 id -u 恒为 0（root），按它推导端口所有用户都会撞到 18700（踩过）。
# 宿主机的 sr 用 -e SR_UID 把真实 uid 传进来；没传时才退回 id -u。
UIDN=${SR_UID:-$(id -u 2>/dev/null || echo 0)}
NETNAME=${NETNAME:-${SR_USER}_farm}
# scheduler 占 SPORT 和 SPORT+1（文本管理口）两个端口，所以按 uid 每人跨 2：否则相邻 uid 的 SPORT 正撞上前一个人的
# SPORT+1（review#1 P1，实测第二个 scheduler Address already in use 退出）。250 人落在 [18700,19198]，不越到 DPORT 段。
# 已有农场的端口记在各自 state.env 里、source 时覆盖此默认值，老农场不受影响，新 init 才用新分配。
SPORT=${SPORT:-$(( 18700 + 2 * (UIDN % 250) ))}    # scheduler（+1 为文本管理口）
DPORT=${DPORT:-$(( 19700 + UIDN % 500 ))}    # 本机 iceccd
# 多 profile 容器共用一个农场：容器都是 --network host，8765 全机唯一。
# 必须查端口而不是查进程——各容器 PID namespace 独立，pgrep 看不到别家的 scheduler，
# 会重复去起然后 bind 失败。
# SR_SCHED_VERBOSE=1（srdev.conf）时 scheduler 以 -vvv 跑，日志里能看到每个任务派给谁/为什么不派——排查"某台 worker 零任务"用
sched_ensure(){ [ -n "$(ss -ltnH "sport = :$SPORT" 2>/dev/null)" ] || \
  /usr/sbin/icecc-scheduler -n "$NETNAME" -p "$SPORT" -d -l /tmp/icecc-scheduler.log $([ -n "${SR_SCHED_VERBOSE:-}" ] && echo "-v -v -v") >/dev/null 2>&1 8>&- 9>&-; }   # 8>&-：常驻 scheduler 不得继承生命周期锁
# --network host 让容器和宿主机共享 netns，本地就能数出连上来的 daemon
# grep -c 计数为 0 时退出码是 1，用 || echo 0 会多打一行；必须吃掉退出码
# 按 NODES 里的远端 IP 逐个判"有没有到 scheduler 端口的已建立连接"。不能数所有含端口的连接：
# 本地 iceccd 那条回环连接两端各算一次，5 台显示 7；反过来少连 2 台也能凑够数，degraded 检测就形同虚设（review #4）
dcount(){ local n=0 ip
  for ip in ${NODES:-}; do
    [ -n "$(ss -tnH state established "( sport = :$SPORT and dst = $ip )" 2>/dev/null)" ] && n=$((n+1))
  done; echo $n; }
# 下发节点配置（幂等）。$1=1 表示首次要先铺密钥。node-setup.sh 内部回读文件比对，报"写入OK/不符"
# 逐个收集每台的退出码：裸 wait 汇总不了失败，部署全挂也看不出来（codex r13#6）。
# 仍保留调用方的 worker 连接检查作为第二道——两者互相独立，一个查"部署脚本怎么说"，一个查"实际连上没有"。
provision_nodes(){ local first=${1:-0} ip p bad="" pids=() ips=()
  for ip in $NODES; do
    ( [ "$first" = 1 ] && sshpass -p "$NODEPW" ssh-copy-id -i $KEY.pub $SSHO $NUSER@$ip >/dev/null 2>&1
      scp -q -i $KEY $SSHO /usr/local/bin/node-setup.sh $NUSER@$ip:/tmp/ 2>/dev/null || exit 1
      ssh -n -i $KEY $SSHO $NUSER@$ip "bash /tmp/node-setup.sh $SCHED worker ${SR_NODE_JOBS:-auto} $NETNAME $SPORT ${SR_APT_MIRROR:-}" ) &
    pids+=($!); ips+=("$ip")
  done
  for i in "${!pids[@]}"; do wait "${pids[$i]}" || bad="$bad ${ips[$i]}"; done
  [ -n "$bad" ] && echo "   !! 这些节点部署未成功：$bad（上面每行的 iceccd= 字段能看出卡在哪）"
  [ -z "$bad" ]; }
wait_workers(){ local i; for i in $(seq 1 "$1"); do sleep 2; [ "$(dcount)" -ge "$WORKERS" ] && return 0; done; return 1; }
# scheduler 的文本管理口（端口 = SPORT+1，icecream 自带）。原来只在 usage 分支里定义，预热也要用，提到全局。
sched_q(){ exec 3<>/dev/tcp/127.0.0.1/$((SPORT+1)) 2>/dev/null || return 1; printf '%s\nquit\n' "$1" >&3; timeout 2 cat <&3; exec 3>&-; }
# ---- worker 预热 ----
# icecc 的 pick_server 对「从没编过、又没有 env」的 worker 只当 bestui，永远输给任何已有评分的 best；于是 scheduler 每次
# 重启后，重连较晚的那台会永久零任务（192.0.2.10 与 192.0.2.11 各实测复现过一次，农场白白少一台）。
# 就绪后主动给还没评分的 worker 各派一个「有真实编译成本」的任务：把 env 传过去并拿到 speed，此后它就正常参与调度。
# 关键约束（codex r9）：scheduler 的 add_job_stats 会丢弃产物 <4096 字节或 user_msec=0 的任务计时——我第一次用一行函数
# 预热，env 传过去了但 speed 仍是 0。所以既要产物够大又要真花 CPU；成败以「该 worker 的 speed 变成非 0」为准，不看 icecc 返回码。
# 只需一种 gcc：统计按 worker 累计、不分工具链；别的工具链首次用时再传包即可。
# 预热被信号打断时的收尾。靠 bash 的动态作用域看到 warm_workers 里的 pids/dir（trap 是在 warm_workers 作用域内触发的）。
warm_abort(){ local rc=$1 p
  kill ${pids[@]+"${pids[@]}"} 2>/dev/null
  for p in ${pids[@]+"${pids[@]}"}; do wait "$p" 2>/dev/null; done
  rm -rf "${dir:-/nonexistent}" 2>/dev/null
  echo "   预热被中断（农场本身已就绪；稍后可 sr farm rebalance 补预热）" >&2
  exit "$rc"; }
# 看门狗每分钟顺带查一次：有没有评分为 0 的 worker。有就预热。
# 为什么必须periodic而不能只靠 init/resume/rebalance：那三处都是「某一时刻做一次」，而 worker 的 daemon
# 可以在任何时刻重启（2026-09-17 实测：节点的 unattended-upgrades 把 iceccd 连带重启 8 轮，全发生在 rebalance
# 预热之后），重启即以「零历史」重新注册、评分归零，此后永远拿不到任务。只有周期检查能自愈。
# 限流 WARM_EVERY_MIN 分钟一次：某台真的坏了也不会每分钟空转一轮预热。
warm_if_starving(){
  [ "${FARM_STATUS:-}" = running ] || return 0
  local now last cs ip sp need=0
  now=$(date +%s); last=$(cat "$FARM/.last-warm" 2>/dev/null); last=${last//[!0-9]/}
  [ $(( now - ${last:-0} )) -ge $(( WARM_EVERY_MIN * 60 )) ] || return 0
  cs=$(sched_q listcs 2>/dev/null); [ -n "$cs" ] || return 0
  for ip in ${NODES:-}; do
    sp=$(printf '%s\n' "$cs" | sed -nE "s/^ [^ ]+ \(${ip//./\\.}:[0-9]+\).*speed=([0-9.]+).*/\1/p" | head -1)
    case "${sp:-}" in 0|0.0|0.00) need=1; break;; esac    # 没注册（取不到）不算，那是另一回事
  done
  [ "$need" = 1 ] || return 0
  echo "$now" > "$FARM/.last-warm"
  echo "$(date '+%F %T') 发现评分为 0 的 worker，自动预热" >>"$LOGF"
  warm_workers >>"$LOGF" 2>&1; }

warm_workers(){
  command -v icecc >/dev/null 2>&1 || return 0
  local envf="" gxx="" gccdir gh dir src cs ip name sp i n=0 fail="" deadline got want rem alive=0 q st pids=() p
  # 工具链包必须和编译器配对：包按 mtime 取最新、编译器按路径取第一个的话，多 gcc 的镜像里会配错版本
  # （客户端用 A 预处理、worker 用 B 编，预热必失败）。先定编译器目录，再取同名目录下的包——和 sr-build 同一规则（codex r10#4）。
  for gccdir in /opt/gcc-toolset-*/ /opt/gcc[0-9]*/; do
    [ -x "${gccdir}bin/g++" ] || continue
    gh=$(basename "${gccdir%/}"); envf=$(ls -t "/opt/icecc/$gh"/*.tar.gz 2>/dev/null | head -1)
    [ -n "$envf" ] && { gxx="${gccdir}bin/g++"; break; }
  done
  { [ -n "$envf" ] && [ -n "$gxx" ]; } || { echo "   (跳过预热：镜像里没有配对的 icecc 工具链包与编译器)"; return 0; }
  # 预热必须经本机 iceccd 才会外发；没有 daemon 时 icecc 直接在本机编，白跑且留不下远端评分（codex r10#2）。
  # daemon 由 sr-build 每次构建时按配对参数启动，这里只检查不另起，免得起出一个参数不匹配的常驻 daemon。
  for q in $(pgrep -x iceccd 2>/dev/null); do st=$(awk '{print $3}' /proc/$q/stat 2>/dev/null); [ "$st" != Z ] && { alive=1; break; }; done
  [ "$alive" = 1 ] || [ -n "$(ss -ltnH "sport = :${DPORT:-10245}" 2>/dev/null)" ] \
    || { echo "   (跳过预热：本机 iceccd 还没起来——它由 sr build 启动。首次构建后若仍有 worker 零任务，跑一次 sr farm rebalance 即可)"; return 0; }
  # rebalance 刚重启 scheduler 时 worker 还没重连完，有界等待它们注册（最多 60 秒）。
  # 必须按 $NODES 里的 IP 逐个数：listcs 的总行数含本机提交端，拿它和 WORKERS 比会提前满足，
  # 结果最后重连的那台被当成"未注册"跳过预热——正是我们要防的那台（实测 192.0.2.12 中招）。
  want=$(printf '%s\n' ${NODES:-} | grep -c .)
  for i in $(seq 1 30); do
    cs=$(sched_q listcs 2>/dev/null); got=0
    for ip in ${NODES:-}; do printf '%s\n' "$cs" | grep -qE "^ [^ ]+ \(${ip//./\\.}:" && got=$((got+1)); done
    [ "$got" -ge "${want:-1}" ] && break
    sleep 2
  done
  [ -n "$cs" ] || { echo "   (跳过预热：读不到 scheduler 的主机列表)"; return 0; }
  dir=$(mktemp -d /tmp/sr-warm.XXXXXX) || return 0; src=$dir/w.cpp
  { echo '#include <string>'; echo '#include <vector>'
    for i in $(seq 1 200); do
      echo "std::vector<std::string> sr_warm_$i(int x){std::vector<std::string> v;for(int i=0;i<x;i++)v.push_back(std::to_string(i*$i));return v;}"
    done; } > "$src"
  echo "== 预热 worker（让每台都拿到 env 与速度评分，避免 scheduler 重启后有机器零任务）…"
  # 被 Ctrl+C / kill 时收掉预热子进程和临时目录，并**退出**——只清理不退出的话，信号打断 wait 后循环会继续给剩下的 worker
  # 派任务，而源码临时目录已经删了，最后还可能返回 0（codex r11#1；和第 7 轮 sr-build 的 on_signal 是同一类错，那边改对了这边漏了）。
  # 此处农场状态已写好、生命周期锁也已释放，中途退出是安全的：农场就绪，只是没预热完。
  trap 'warm_abort 130' INT; trap 'warm_abort 143' TERM
  deadline=$(( $(date +%s) + 300 ))
  for ip in ${NODES:-}; do
    # 单任务时限取 min(180, 剩余预算)，并给 TERM→KILL 宽限，总预算才是真的封顶（codex r10#3）
    rem=$(( deadline - $(date +%s) )); [ "$rem" -gt 180 ] && rem=180
    [ "$rem" -le 10 ] && { fail="$fail $ip(超预算未预热)"; continue; }
    name=$(printf '%s\n' "$cs" | sed -nE "s/^ ([^ ]+) \(${ip//./\\.}:[0-9]+\).*/\1/p" | head -1)
    [ -n "$name" ] || { fail="$fail $ip(未注册)"; continue; }
    sp=$(printf '%s\n' "$cs" | sed -nE "s/^ [^ ]+ \(${ip//./\\.}:[0-9]+\).*speed=([0-9.]+).*/\1/p" | head -1)
    case "${sp:-0}" in 0|0.0|0.00) ;; *) continue;; esac     # 已有评分的跳过
    ( unset ICECC; ICECC_VERSION="$envf" ICECC_PREFERRED_HOST="$name" \
        timeout -k 10 "$rem" icecc "$gxx" -O2 -c "$src" -o "$dir/$name.o" >/dev/null 2>&1 ) &
    pids+=($!)
    # 只等自己起的预热任务，绝不能用裸 wait：wd_ensure 刚起的常驻看门狗也是本 shell 的子进程，
    # 裸 wait 会一直等它，init/resume 直接卡死（codex r10#1；rebalance 不起看门狗所以之前没暴露）
    if [ "${#pids[@]}" -ge 2 ]; then wait "${pids[0]}" 2>/dev/null; pids=(${pids[@]:1}); fi
    n=$((n+1))
  done
  for p in ${pids[@]+"${pids[@]}"}; do wait "$p" 2>/dev/null; done
  pids=(); trap - INT TERM
  cs=$(sched_q listcs 2>/dev/null)                # 以 speed 判定，不看 icecc 返回码
  for ip in ${NODES:-}; do
    sp=$(printf '%s\n' "$cs" | sed -nE "s/^ [^ ]+ \(${ip//./\\.}:[0-9]+\).*speed=([0-9.]+).*/\1/p" | head -1)
    case "${sp:-}" in ''|0|0.0|0.00) case "$fail" in *"$ip"*) ;; *) fail="$fail $ip";; esac;; esac
  done
  rm -rf "$dir"
  [ -n "$fail" ] && echo "   !! 这些 worker 预热后仍无速度评分，可能接不到任务：$fail（稍后可 sr farm rebalance 重试）"
  return 0; }
# 每台 worker 的编译并发槽（= icecc -m）。显式 SR_NODE_JOBS 优先（内存受限时压低）；
# 否则读一台节点的实际核数；再退回 ITYPE 前缀里的核数（如 8c16g→8）；最后 8。
# sr-build 用它算总并发 J = WORKERS*NCPU + 本地，所以要写进 state.env。
node_jobs(){ local ip n
  # 一律归一化成正整数：客户端拿它做 Bash 算术，auto/空/0/08 这类字串会让构建 "unbound variable"/八进制报错/算出 J=16
  # （review 0916b）。SR_NODE_JOBS 只认正整数，其它往下按实测核数；10# 防八进制。init 已在申请前挡掉非法值，这里再兜一层。
  case "${SR_NODE_JOBS:-}" in ''|*[!0-9]*) ;; *) n=$((10#$SR_NODE_JOBS)); [ "$n" -gt 0 ] && { echo "$n"; return; };; esac
  for ip in ${NODES:-}; do
    n=$(timeout 8 ssh -n -i $KEY $SSHO $NUSER@$ip nproc 2>/dev/null); n=${n//[!0-9]/}
    [ -n "$n" ] && [ "$((10#$n))" -gt 0 ] && { echo "$((10#$n))"; return; }
  done
  n=$(printf '%s' "$ITYPE" | grep -oE '^[0-9]+')
  [ -n "$n" ] && [ "$((10#$n))" -gt 0 ] && { echo "$((10#$n))"; return; }
  echo 8; }

case "${1:-}" in
init)
  lifecycle_lock   # 两个 init 并发时只能有一个通过下面的存在性检查
  [ -f "$STATE" ] && { echo "已有农场，先 sr-farm down 或用 sr-farm status 查看"; exit 1; }
  [ -n "$NODEPW" ] || { echo "!! 首次给节点铺 ssh 密钥需要节点初始密码：在 srdev.conf 里设 SR_NODE_PASSWORD 后重试"; exit 1; }
  # 非法配置要在申请集群之前挡住（review 0916b）：SR_NODE_JOBS 要么留空（按节点核数自动），要么正整数
  if [ -n "${SR_NODE_JOBS:-}" ] && ! printf '%s' "$SR_NODE_JOBS" | grep -qE '^[1-9][0-9]*$'; then
    echo "!! SR_NODE_JOBS='$SR_NODE_JOBS' 非法：留空=按节点 CPU 核数自动定，或填正整数（如 6）。已中止，未申请集群。"; exit 1
  fi
  [ "${WORKERS:-0}" -ge 1 ] 2>/dev/null || { echo "!! WORKERS 必须是 ≥1 的整数（现为 '${WORKERS:-}'）"; exit 1; }
  [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N "" -f "$KEY" -C sr-farm   # 专用密钥，不碰你个人的 ~/.ssh
  sched_ensure
  # review extra2#3：WORKERS 就是要申请的机器总数（用户按它估费用）。平台每个集群必带 1 台 FE，全部当 worker，
  # 所以 BE 台数 = WORKERS-1，总数正好 = WORKERS（原来传 WORKERS 台 BE 再加 1 台 FE，写 5 实际开 6 台）。
  # 绝不认领同名集群：创建前先查平台上有没有同名的。有就停下——本地没有 state.env 时 sr farm down 也释放不了它，
  # 只能人工到平台核对（codex r13#2：原来 create 业务失败不报错、随后按名字找 CID，会把已存在的同名集群当成本次创建结果，
  # 并对它跑 node-setup 停掉那批机器上的服务）。
  PRE=$($API cid "$NAME" 2>/dev/null)
  [ -n "$PRE" ] && { echo "!! 平台上已存在同名集群 $NAME (id=$PRE)，不会认领它。"
                     echo "   若它是你的旧农场：先 sr farm down 释放；若本地已无记录，请到平台上核对后手工释放再重试。"; exit 1; }
  echo "== 申请集群 $NAME（$WORKERS × $ITYPE，磁盘 ${DISK}G，全部当 worker；scheduler 跑在本容器）…"
  # 创建失败只能断言"结果未确认"，不能断言"没建出来"：客户端返回非零也可能是平台已受理、只是响应超时/断连/解析失败，
  # 那样会留下一台没有本地记录、无法 sr farm down 回收的计费集群（codex r15#1）。所以中止部署，但要求人工核对。
  $API create "$NAME" "$(( WORKERS - 1 ))" 2 "$ITYPE" "$DISK" || {
    echo "!! 创建集群的请求未确认成功，已中止部署。"
    echo "   注意：这不代表平台上没建出来——响应超时或断连时集群可能已经创建并开始计费。"
    echo "   请按名字 $NAME 和创建时间到平台核对；若确实建出来了，手工释放后再重试 sr farm init。"; exit 1; }
  echo "== 等待 RUNNING（约 5-6 分钟）…"
  for i in $(seq 1 45); do sleep 20; S=$($API row "$NAME"|cut -d'|' -f1); [ "$S" = Running ] && break; done
  # 走到这里才按名字取 CID 是安全的：创建前已确认无同名集群、且创建确实成功。取不到就停，不猜、不部署
  # （codex r14：并发/重名场景下按名字回退可能认领到别人那一套，让另一套资源悬空）。
  ID=$($API cid "$NAME")
  [ -n "$ID" ] || { echo "!! 创建后仍取不到集群 $NAME 的 id。可能创建未真正生效，也可能平台延迟。"
                    echo "   已中止，不做任何部署。请到平台核对是否有新建出来的 $NAME，有就手工释放后重试。"; exit 1; }
  # review#3：拿到 CID 立刻落一份最小 state.env（initializing）。之后取节点/部署/连接检查任一步失败或被 Ctrl+C，
  # sr farm down 都能凭这份 CID 回收集群；成功后下面再覆盖成完整记录。
  printf 'CLUSTER=%s\nCID=%s\nSCHED=%s\nNETNAME=%s\nSPORT=%s\nDPORT=%s\nFARM_STATUS=initializing\n' \
    "$NAME" "$ID" "$HOSTIP" "$NETNAME" "$SPORT" "$DPORT" > "$STATE.tmp" && mv -f "$STATE.tmp" "$STATE"   # 原子写：读方不会看到半行
  # 必须在 RUNNING 之后调：APPLYING 阶段调用会静默失效（实测）
  $API op "$ID" disable_auto_release >/dev/null
  NODES=$($API nodes "$NAME")
  [ -n "$NODES" ] || { echo "取不到节点 IP，中止（集群 $ID 仍在，可 sr-farm down 清理）"; exit 1; }
  SCHED=$HOSTIP; NW=$(echo $NODES | wc -w)
  echo "   cluster_id=$ID  scheduler=$SCHED(本容器)  worker($NW): $NODES"
  echo "== 铺密钥 + 部署 icecc（顺便清掉 TSP 的 StarRocks：FE 的 -Xmx26g 会压垮 8c32g 节点）…"
  provision_nodes 1
  # 部署完必须实测有几台 worker 连上了；不够就标 degraded 而不是 running（踩过：3 台 apt 失败却当成功）
  WORKERS=$NW
  if wait_workers 30; then INIT_STATUS=running
  else INIT_STATUS=degraded
       echo "!! 只有 $(dcount)/$NW 台 worker 连上 scheduler，已标 degraded。上面每行的 iceccd= 字段能看出哪台没装上。"
       echo "   修复：sr farm resume（会重新下发并校验）"
  fi
  NCPU=$(node_jobs)   # 每台并发槽，供 sr-build 算总 J；nodes 已部署好，此处 ssh 能通
  printf 'CLUSTER=%s\nCID=%s\nSCHED=%s\nNODES="%s"\nWORKERS=%s\nNCPU=%s\nNETNAME=%s\nSPORT=%s\nDPORT=%s\nFARM_STATUS=%s\n' \
         "$NAME" "$ID" "$SCHED" "$NODES" "$NW" "$NCPU" "$NETNAME" "$SPORT" "$DPORT" "$INIT_STATUS" > "$STATE.tmp" && mv -f "$STATE.tmp" "$STATE"
  beat; wd_ensure
  # 预热前先放生命周期锁：预热会编译几分钟，不该把 suspend/down 一直挡在外面（codex r9）
  { exec 8>&-; } 2>/dev/null; warm_workers
  echo ""
  if [ "$INIT_STATUS" = degraded ]; then echo "== 初始化未完成（degraded）==============================="; else echo "== 农场就绪 =========================================="; fi
  printf "   集群 %s (id=%s)   区域 %s\n" "$NAME" "$ID" "$($API spec "$NAME" | cut -d'|' -f4)"
  printf "   规格 %s × %s   磁盘 %sG/台   scheduler 在本容器 %s:%s   网络名 %s\n" \
         "$NW" "$($API spec "$NAME" | cut -d'|' -f2)" "$($API spec "$NAME" | cut -d'|' -f3)" "$SCHED" "$SPORT" "$NETNAME"
  echo "   节点："
  for ip in $NODES; do
    n_ssh "$ip" "printf '     %-15s %sc / %sG 内存 / 根盘%s 可用 / 数据盘%s\n' \
      \"\$(hostname -I|awk '{print \$1}')\" \"\$(nproc)\" \"\$(free -g|awk '/Mem:/{print \$2}')\" \
      \"\$(df -h / | awk 'NR==2{print \$4}')\" \"\$(df -h /home/disk1 2>/dev/null | awk 'NR==2{print \$2}' || echo 无)\"" 2>/dev/null
  done
  echo "======================================================"
  echo "== 看门狗每 ${RENEW_MIN} 分钟续约 ${RENEW_H} 小时；空闲 ${IDLE_MIN} 分钟自动休眠。"
  echo "   容器关闭 → 续约停止 → 农场 ${RENEW_H} 小时内自动释放。"
  # review r7#8：degraded 已正确写入状态并保留看门狗以便恢复，但原来仍以最后一条 echo 的 0 退出，调用方以为成功
  if [ "$INIT_STATUS" = degraded ]; then
    echo "!! 初始化未完成（degraded）：worker 未全部连上。状态与看门狗已保留，修好节点后 sr farm resume；本命令以非零退出。"; exit 2
  fi
  ;;
# 资源视图：scheduler 文本口（端口 = SPORT+1，icecream 自带）+ 各节点 ssh 一跳 + 本容器 cgroup。--watch [秒] 循环刷新
usage)
  [ -f "$STATE" ] || { echo "当前无农场"; exit 1; }
  { load_state || exit 1; }
  CG=/sys/fs/cgroup   # sched_q 已提到全局定义
  once(){
    local hdr cs jobs u0 u1 cores mem memmax
    cs=$(sched_q listcs 2>/dev/null); hdr=$(printf '%s\n' "$cs" | sed -n 's/^200-ICECC \([^:]*\): \([0-9]*\)s uptime, \([0-9]*\) hosts, \([0-9]*\) jobs in queue (\([0-9]*\) total).*/scheduler \1 · 已运行 \2s · \3 台 daemon · 排队 \4 · 累计派发 \5/p')
    total=$(printf '%s\n' "$cs" | sed -n 's/.*(\([0-9]*\) total).*/\1/p' | head -1); total=${total:-0}
    echo "== 集群 $CLUSTER (id=$CID)  平台 $($API row "$CLUSTER" 2>/dev/null | cut -d'|' -f1)/本地 $FARM_STATUS  到期 $($API row "$CLUSTER" 2>/dev/null | cut -d'|' -f2)"
    echo "   ${hdr:-scheduler 文本口 :$((SPORT+1)) 连不上}"
    echo "== scheduler 视图（jobs=当前/上限，load 为 icecc 千分制）"
    printf '   %-26s %-15s %-9s %-6s %s\n' 主机 IP jobs load speed
    printf '%s\n' "$cs" | grep -E '^ [^ ]+ \(' | sed -E 's/^ ([^ ]+) \(([0-9.]+):[0-9]+\) \[[^]]*\] speed=([0-9.]+) jobs=([0-9]+\/[0-9]+) load=([0-9]+).*/\1 \2 \4 \5 \3/' \
      | awk -v me="$HOSTIP" -v total="$total" '{tag=($2==me)?"(本机)":""; starving=($2!=me && $5+0==0 && total>200); if(starving) tag="<- 从未接到任务(speed=0)"; printf "   %-26s %-15s %-9s %5.1f%% %s %s\n", substr($1,1,26), $2, $3, $4/10, $5, tag; split($3,a,"/"); if($2!=me){cur+=a[1]; cap+=a[2]}; if(starving) idle++} END{printf "   远端合计 %d/%d 槽在用\n", cur, cap; if(idle>0) printf "   !! %d 台 worker 在 scheduler 已派发 %d 个任务后仍 speed=0：它一直没接到任务（多半是 env 缓存空，而 scheduler 有了其它主机的统计就不再试新主机）。\n      修复：sr farm rebalance（重启 scheduler，统计清零后随机分派、顺带给它装 env；进行中的任务会短暂回退本地）\n", idle, total}'
    jobs=$(sched_q listjobs 2>/dev/null | grep -vE '^200|^$'); [ -n "$jobs" ] && { echo "== 正在派发的任务（前 10）"; printf '%s\n' "$jobs" | head -10 | cut -c1-150 | sed 's/^/   /'; }
    echo "== 节点实际负载（ssh 一跳：loadavg 1m/5m · 内存 · 编译进程数）"
    # 并行 ssh 但按 IP 排序输出：直接在子进程里打印的话，谁先返回谁先出现，每次刷新顺序都不一样，
    # 盯 --watch 时很难比对。各自写进以 IP 命名的临时文件，全部结束后按 IP 的四段数值排序再打。
    NLD=$(mktemp -d /tmp/sr-nodeload.XXXXXX)
    for ip in $NODES; do
      ( r=$(timeout 8 ssh -n -i $KEY $SSHO $NUSER@$ip 'printf "%s %s|%s|%s|%s\n" $(cut -d" " -f1,2 /proc/loadavg) "$(free -m | awk "/^Mem:/{print \$3\"/\"\$2\"M\"}")" "$(pgrep -c cc1plus)" "$(nproc)"' 2>/dev/null)
        { [ -n "$r" ] && printf '   %-15s load %-12s mem %-14s cc1plus %-3s /%s 核\n' "$ip" "$(echo "$r"|cut -d'|' -f1)" "$(echo "$r"|cut -d'|' -f2)" "$(echo "$r"|cut -d'|' -f3)" "$(echo "$r"|cut -d'|' -f4)" \
                    || printf '   %-15s (ssh 不通)\n' "$ip"; } > "$NLD/$ip" ) &
    done; wait
    # -t. -kN,Nn 四段各按数值排：纯字典序会把 .10 排在 .9 前面
    for ip in $(printf '%s\n' $NODES | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n); do cat "$NLD/$ip" 2>/dev/null; done
    rm -rf "$NLD"
    echo "== 本容器"
    u0=$(awk '/^usage_usec/{print $2}' $CG/cpu.stat 2>/dev/null); sleep 1; u1=$(awk '/^usage_usec/{print $2}' $CG/cpu.stat 2>/dev/null)
    cores=$(awk -v a="${u0:-0}" -v b="${u1:-0}" 'BEGIN{printf "%.1f", (b-a)/1000000}')
    # memory.current 含页缓存，空闲时也有十几 G，看 anon 才是编译真占的
    mem=$(awk '/^anon /{print $2}' $CG/memory.stat 2>/dev/null || echo 0); memmax=$(cat $CG/memory.max 2>/dev/null || echo max)
    printf '   CPU %s 核在用 / 配额 %s   内存(anon) %.1fG / %s   本地 cc1plus %s\n' "$cores" "$(awk '{printf "%d", $1/$2}' $CG/cpu.max 2>/dev/null || echo ?)" "$(echo "${mem:-0}" | awk '{print $1/1073741824}')" "$([ "$memmax" = max ] && echo 不限 || echo "$memmax" | awk '{printf "%.0fG", $1/1073741824}')" "$(pgrep -c cc1plus)"
    local t; for f in /farm/sr-build.*.lock; do [ -e "$f" ] || continue; t=$(cat "$f.tree" 2>/dev/null); ( exec 8>"$f"; flock -n 8 ) 2>/dev/null || echo "   正在编译: ${t:-?}"; done
    [ -f /farm/last-build ] && echo "   距上次编译 $(( ($(date +%s)-$(stat -c %Y /farm/last-build))/60 )) 分钟"
  }
  if [ "${2:-}" = --watch ]; then while true; do clear; date '+%F %T'; once; sleep "${3:-5}"; done; else once; fi ;;
status)
  [ -f "$STATE" ] || { echo "当前无农场"; exit 1; }
  { load_state || exit 1; }; IFS='|' read -r S T N <<<"$($API row "$CLUSTER")"
  # 平台上查不到 = 集群已不在（到期释放/被清扫），本地记录只是残影，别把空状态当正常打出来
  if [ -z "$S" ]; then
    echo "!! 集群 $CLUSTER (id=$CID) 在平台上已不存在——很可能到期被释放（看门狗停过 3 小时以上？）。"
    echo "   本地记录状态=$FARM_STATUS 已失效。处理：sr farm down 清记录，再 sr farm init 重建（6~9 分钟）。"
    exit 1
  fi
  LB=$(stat -c %Y $FARM/last-build 2>/dev/null || echo 0)
  sched_ensure; D=$(dcount)
  printf "集群 %s (id=%s)\n平台状态 %s / 本地记录 %s\n到期 %s   22点清扫 %s\nscheduler %s:%s(本容器)   worker 已连 %s/%s\n距上次编译 %d 分钟\n看门狗 %s\n" \
    "$CLUSTER" "$CID" "$S" "$FARM_STATUS" "$T" "$N" "$SCHED" "$SPORT" "$D" "$WORKERS" $(( ($(date +%s)-LB)/60 )) \
    "$(pgrep -f '[s]r-farm _watchdog' >/dev/null && echo 运行中 || echo 已停)"
  ;;
resume|up)
  lifecycle_lock
  { load_state || exit 1; }
  # review r7 存疑1：init 拿到 CID 后失败会留下 initializing（无 NODES），原地恢复超出逐条修补范围，明确挡住并指路
  [ "${FARM_STATUS:-}" = initializing ] && { echo "!! 上次 sr farm init 未完成（状态 initializing，无节点信息），请先 sr farm down 回收该集群，再重新 init"; exit 1; }
  [ "${FARM_STATUS:-}" = releasing ] && { echo "!! 农场正在释放（上次 sr farm down 未确认完成），先 sr farm down 清理后再 init"; exit 1; }
  sched_ensure
  pstate(){ $API row "$CLUSTER" 2>/dev/null | cut -d'|' -f1; }
  # 平台还在 Updating（上一次 suspend 没落定）时发 start 会被静默丢掉（踩过：4 分钟后仍 Suspended）。
  # 先等它落定，再 start，再轮询到 Running——每一步都实测，不猜。
  for i in $(seq 1 30); do case "$(pstate)" in Updating|Stopping|Starting) sleep 5;; *) break;; esac; done
  [ "$(pstate)" = Running ] || $API op "$CID" start >/dev/null
  for i in $(seq 1 36); do [ "$(pstate)" = Running ] && break; sleep 5; done
  [ "$(pstate)" = Running ] || { echo "!! 平台 3 分钟内未到 Running（现在 $(pstate)），稍后再试 sr farm resume"; exit 1; }
  # 状态必须实测，不能靠记录：原来 90 次循环超时也照样写 running，sr-build 便按 -j56 开工，
  # 实际 worker 一台没连上，全落本地（踩过：跑了 21 分钟才发现是配置写错了）
  if wait_workers 60; then
    echo "农场就绪：$WORKERS 台 worker 已连"
  else
    echo "== 120 秒内 worker 未全部连上（$(dcount)/$WORKERS），重新下发节点配置修复…"
    provision_nodes 0
    if wait_workers 45; then echo "修复后就绪：$WORKERS 台 worker 已连"
    else
      sed -i 's/^FARM_STATUS=.*/FARM_STATUS=degraded/' "$STATE"; wd_ensure
      echo "!! 农场不健康：仅 $(dcount)/$WORKERS 连上，已标记 degraded，sr build 会拒绝开工。"
      echo "   排查：sr farm status / 节点上 systemctl status iceccd / scheduler 端口 $SPORT"
      exit 1
    fi
  fi
  # review latest#4：手动 resume 要重置空闲计时，否则看门狗按休眠前的 last-build 算空闲、刚醒又睡，用户拿不到 15 分钟准备窗口
  beat; sed -i 's/^FARM_STATUS=.*/FARM_STATUS=running/' "$STATE"; wd_ensure
  { exec 8>&-; } 2>/dev/null; warm_workers ;;   # 放锁后再预热（休眠唤醒同样会让 worker 重新注册，可能出现零任务的机器）
suspend)
  lifecycle_lock
  { load_state || exit 1; }
  # review#4：原来不看返回码就写 suspended——机器其实还在跑，看门狗却以为睡了、不再尝试休眠还继续续约。失败就保持原状态并返回非零，
  # 下个空闲周期会再试（tspapi op 业务失败/HTTP 失败都以非零退出）
  if $API op "$CID" stop >/dev/null; then
    sed -i 's/^FARM_STATUS=.*/FARM_STATUS=suspended/' "$STATE"; echo "已休眠（仍继续续约，否则睡着也会到期）"
  else
    echo "!! 休眠请求未成功，状态保持 ${FARM_STATUS:-?}（机器仍在跑，继续计费）。下个空闲周期会重试，或手动 sr farm suspend"; exit 1
  fi ;;
down|release)
  lifecycle_lock
  if [ -f "$STATE" ]; then { load_state || exit 1; }
    # 先看平台上还在不在（第二次 down 时集群可能已经没了，先发 release 会报错、本地记录永远清不掉）。
    # exists 的退出码：0=存在(打印状态) 1=不存在 2=查询失败——查询失败绝不能当成"已消失"
    $API exists "$CID" >/dev/null 2>&1; EX=$?
    case $EX in
      1) echo "平台上已无集群 $CID，清理本地记录" ;;
      2) echo "!! 查询平台失败，无法确认，保留状态（CID=$CID），稍后重试 sr farm down"; exit 1 ;;
      0) $API op "$CID" release >/dev/null || { echo "!! 释放请求失败，保留状态（CID=$CID），稍后重试 sr farm down"; exit 1; }
         # "请求返回了"不等于"平台接受了"。只认两种证据：集群消失，或状态变成释放类（Releas*/Delet*/Destroy*/Terminat*/Remov*）。
         # 观察到之前不标 releasing、不停续约；60 秒后仍是 Running/Suspended 就当释放被拒，状态原样保留（review：业务拒绝不能当释放中）。
         ST=""; EX=0
         for i in $(seq 1 12); do sleep 5; ST=$($API exists "$CID" 2>/dev/null); EX=$?
           [ $EX = 0 ] || break
           case "$ST" in [Rr]eleas*|[Dd]elet*|[Dd]estroy*|[Tt]erminat*|[Rr]emov*) break;; esac
         done
         case $EX in
           1) echo "平台确认集群已消失" ;;
           2) echo "!! 释放请求已发出但随后查询失败，无法确认，状态原样保留（CID=$CID），稍后重试 sr farm down"; exit 1 ;;
           0) case "$ST" in
                [Rr]eleas*|[Dd]elet*|[Dd]estroy*|[Tt]erminat*|[Rr]emov*)
                  sed -i 's/^FARM_STATUS=.*/FARM_STATUS=releasing/' "$STATE"; pkill -f "[s]r-farm _watchdog" 2>/dev/null
                  echo "平台状态 $ST：释放中。已标 releasing 并停止续约；稍后再执行 sr farm down 确认并清理本地记录"; exit 0 ;;
                *) echo "!! 释放请求发出 60 秒后平台仍显示 ${ST:-?}，释放未被接受。状态原样保留、续约继续（CID=$CID），请到平台排查"; exit 1 ;;
              esac ;;
         esac ;;
    esac
  fi
  pkill -f "[s]r-farm _watchdog" 2>/dev/null
  rm -f "$STATE"; echo "已释放并停止看门狗" ;;
# 重启 scheduler：icecc 有了各主机的统计后不再"试"没统计的新主机（比如 env 缓存被清过的 worker），它会一直零任务。
# 重启后统计清零，前几轮随机分派，顺带把 env 装到所有主机。进行中的编译会短暂回退本地（软降级），几秒后恢复。
rebalance)
  lifecycle_lock; [ -f "$STATE" ] || { echo "当前无农场"; exit 1; }; { load_state || exit 1; }
  pkill -x icecc-scheduler 2>/dev/null; sleep 1; sched_ensure
  echo "scheduler 已重启（:$SPORT）。worker 在 1~3 分钟内重连…"
  { exec 8>&-; } 2>/dev/null; warm_workers   # 重启 scheduler 正是"重连晚的那台被饿死"的高发时刻，直接预热掉
  echo "完成。sr farm usage 里各台 speed 应都 > 0" ;;
_wd) wd_ensure; exit 0 ;;
_watchdog)
  while true; do
    [ -f "$STATE" ] || exit 0
    # 热加载站点配置：看门狗是常驻进程，只在启动时读一次的话，改了 IDLE_MIN/RENEW_MIN/RENEW_H 同步进来也不生效
    # （codex r8 存疑1）。放在 load_state 之前，两者键不重叠。
    # 复位到"纯环境"基线再 source，配置里删掉的项才能回到默认值（re-source 不会清除已消失的变量）
    IDLE_MIN=$ENVBASE_IDLE_MIN; RENEW_MIN=$ENVBASE_RENEW_MIN; RENEW_H=$ENVBASE_RENEW_H
    [ -f "$SRCONF" ] && { set -a; . "$SRCONF"; set +a; }
    IDLE_MIN=${IDLE_MIN:-15}; RENEW_MIN=${RENEW_MIN:-15}; RENEW_H=${RENEW_H:-3}
    load_state || { echo "$(date '+%F %T') state.env 解析失败（损坏或被篡改），看门狗退出，停止续约" >>"$LOGF"; exit 1; }
    # 正在释放的集群不能再续约/唤醒：看门狗自己识别状态退出，不依赖 down 那一次 pkill
    [ "${FARM_STATUS:-}" = releasing ] && { echo "$(date '+%F %T') 农场正在释放，看门狗停止续约并退出" >>"$LOGF"; exit 0; }
    [ "${FARM_STATUS:-}" = running ] && sched_ensure
    $API op "$CID" renew $RENEW_H >/dev/null 2>&1   # 重置为 now+RENEW_H 小时
    # 平台每天 0 点把 auto-release 重置为 true，不重发的话农场会在某天 22 点被清掉。
    # 幂等且便宜，索性每轮都发一次。
    $API op "$CID" disable_auto_release >/dev/null 2>&1
    if [ -f "$FARM/resume-request" ]; then
      rm -f "$FARM/resume-request"; "$0" resume >>"$LOGF" 2>&1
    else
      LB=$(stat -c %Y $FARM/last-build 2>/dev/null || echo 0)
      IDLE=$(( ($(date +%s)-LB)/60 ))
      # pgrep 只能看见本容器的进程，多 profile 场景下会把别的容器正在跑的编译当成空闲
      # 而把农场睡掉。改查共享锁：拿得到锁 = 全机确实没有编译在跑。
      # 锁是按源码树分的，任意一把被占住就算忙
      busy(){ command -v flock >/dev/null || return 1
              for f in /farm/sr-build.*.lock; do
                [ -e "$f" ] || continue
                ( exec 8>"$f"; flock -n 8 ) >/dev/null 2>&1 || return 0
              done; return 1; }
      if [ "$IDLE" -ge "$IDLE_MIN" ] && [ "${FARM_STATUS:-}" = running ] && ! busy; then
        echo "$(date '+%F %T') 空闲 ${IDLE} 分钟 -> 休眠" >>"$LOGF"; "$0" suspend >>"$LOGF" 2>&1
      fi
    fi
    # scheduler 探活要比续费勤得多：它一死，所有任务立刻退回本地（实测仍能编完、
    # 不会 OOM，因为本地 daemon 把并发卡在 -m 16），但全程降级。等 15 分钟才发现太亏了。
    for _ in $(seq 1 $((RENEW_MIN))); do
      sleep 60
      [ -f "$STATE" ] || exit 0
      [ "${FARM_STATUS:-}" = running ] && { sched_ensure; warm_if_starving; }
    done
  done ;;
*) cat <<U
用法: sr-farm {init|status|resume|suspend|down}
  init     申请农场并部署（约 6 分钟），之后自动续约 + 空闲自动休眠
  status   集群状态 / 到期 / daemon 连接数 / 距上次编译 / 看门狗
  resume   唤醒（实测 29 秒到可派活）
  suspend  休眠
  down     释放并停看门狗
U
;;
esac
