#!/bin/bash
# Inject a Ninja link job pool during CMake configuration.
#
# Upstream build and test scripts do not set JOB_POOL, so links can inherit full
# compile concurrency. iceccd limits compilation but not linking; concurrent ASAN
# links can exhaust container memory or stall it in reclaim. Limit links separately.
#
# Upstream env.sh accepts CUSTOM_CMAKE for both build.sh and run-be-ut.sh.
# Inject CMAKE_JOB_POOLS=link=N and CMAKE_JOB_POOL_LINK=link only for configure
# invocations containing -G. Pools do not affect Ninja command hashes, and Make
# generators ignore them. sr-build sizes SR_LINK_JOBS from CPU and memory limits;
# without it, leave link-pool settings unchanged.
real=${SR_REAL_CMAKE:-cmake}
[ "$(readlink -f "$(command -v "$real" 2>/dev/null || echo "$real")" 2>/dev/null)" = "$(readlink -f "$0")" ] && real=cmake   # Avoid recursion if the configured executable points back to this wrapper.
# Apply two independent limits: Ninja's job pool limits one build, while the
# linkgate launcher uses shared flock slots to limit all source trees in a container.
# A per-build pool alone cannot prevent combined memory overcommit.
# Recognize both -G Ninja and -GNinja forms.
GATE=${SR_LINK_GATE:-/usr/local/bin/linkgate}
# Evaluate link-pool settings separately from other injected arguments, so a missing
# SR_LINK_JOBS does not accidentally disable unrelated configuration hooks.
inj=()
if [[ "${SR_LINK_JOBS:-}" =~ ^[1-9][0-9]*$ ]]; then
  inj+=("-DCMAKE_JOB_POOLS=link=$SR_LINK_JOBS" -DCMAKE_JOB_POOL_LINK=link)
  [ -x "$GATE" ] && inj+=("-DCMAKE_CXX_LINKER_LAUNCHER=$GATE")
fi
# sr-build may supply additional configure arguments, including CMAKE_PROJECT_INCLUDE
# for --dynlib. Word splitting is intentional: this variable contains multiple arguments.
[ -n "${SR_EXTRA_CMAKE_ARGS:-}" ] && inj+=($SR_EXTRA_CMAKE_ARGS)
if [ ${#inj[@]} -gt 0 ]; then
  for a in "$@"; do
    case "$a" in -G|-G?*) exec "$real" "${inj[@]}" "$@";; esac
  done
fi
exec "$real" "$@"
