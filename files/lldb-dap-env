#!/bin/bash
# Prepare the BE unit test runtime environment used by run-be-ut.sh, then exec
# the requested container debugger command, such as lldb-dap-20 or lldb-20.
#
# Shared-library test binaries lack RPATH/RUNPATH. Match run-be-ut.sh by collecting
# build-tree shared-library directories, thirdparty jemalloc/LLVM/Paimon, the GCC
# runtime, and the JDK's libjvm. Write an LLDB command file that applies these
# paths through target.env-vars to the debuggee only, loaded by initCommands or -S.
#
# Optional inputs: STARROCKS_HOME selects the source tree, otherwise search upward
# from cwd. SR_UT_TREE selects the build tree; prefer be/nj-dyn/ut_build_ASAN, then
# be/ut_build_ASAN. Never mix same-named libraries from different build trees.
set -u
find_root(){ local d=${1:-}
  while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do
    [ -f "$d/build.sh" ] && [ -d "$d/be/src" ] && { printf '%s\n' "$d"; return 0; }
    d=$(dirname "$d"); done; return 1; }
SR=${STARROCKS_HOME:-$(find_root "$(pwd -P)" 2>/dev/null || true)}
if [ -z "$SR" ]; then echo "lldb-dap-env: 不在 StarRocks 源码树里，不设单测环境，原样执行" >&2; exec "$@"; fi
export STARROCKS_HOME=$SR
export STARROCKS_THIRDPARTY=${STARROCKS_THIRDPARTY:-/var/local/thirdparty}
export STARROCKS_GCC_HOME=${STARROCKS_GCC_HOME:-/opt/gcc-toolset-14}
TREE=${SR_UT_TREE:-}
if [ -z "$TREE" ]; then for t in "$SR/be/nj-dyn/ut_build_ASAN" "$SR/be/ut_build_ASAN"; do [ -d "$t" ] && { TREE=$t; break; }; done; fi
add(){ [ -n "${1:-}" ] && [ -d "$1" ] && LD_LIBRARY_PATH="$1${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; return 0; }   # Prepend paths, matching run-be-ut.sh.
# Keep the following entries aligned with run-be-ut.sh.
export TERM=${TERM:-xterm} UDF_RUNTIME_DIR=$SR/lib/udf-runtime LOG_DIR=$SR/log
export LSAN_OPTIONS=${LSAN_OPTIONS:-suppressions=$SR/conf/asan_suppressions.conf}
if [ -f "$SR/conf/be_test.conf" ]; then
  for i in $(sed 's/ //g' "$SR/conf/be_test.conf" | grep -E '^[[:upper:]]([[:upper:]]|_|[[:digit:]])*='); do export "$i"; done
fi
mkdir -p "$LOG_DIR" "$UDF_RUNTIME_DIR" 2>/dev/null
LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}
for d in jemalloc/lib-shared lib lib64 llvm/lib paimon-cpp/lib; do add "$STARROCKS_THIRDPARTY/installed/$d"; done
if [ -n "$TREE" ]; then
  while IFS= read -r d; do add "$d"; done < <(find "$TREE" -type f \( -name '*.so' -o -name '*.so.*' \) ! -name '*.debuginfo' -printf '%h\n' 2>/dev/null | sort -u)
else echo "lldb-dap-env: 找不到构建树（SR_UT_TREE 未设且 be/nj-dyn/ut_build_ASAN、be/ut_build_ASAN 都不在），.so 模式的二进制会起不来" >&2; fi
add "$(dirname "$("$STARROCKS_GCC_HOME/bin/g++" -print-file-name=libstdc++.so 2>/dev/null)" 2>/dev/null)"
JH=${JAVA_HOME:-$STARROCKS_THIRDPARTY/installed/open_jdk}
[ -f "$JH/lib/server/libjvm.so" ] && { export JAVA_HOME=$JH; add "$JH/lib/server"; add "$JH/lib"; }
# Apply this library path only to the debuggee, never to LLDB or lldb-server.
# StarRocks' bundled LLVM may share a soname with the debugger's LLVM while lacking
# required target backends, causing symbol lookup failures or hung attach/launch.
# A loader override for LLDB alone is insufficient because lldb-server inherits its
# environment. Set target.env-vars through an LLDB command file instead of exporting
# LD_LIBRARY_PATH. Attaching to an existing process does not need this setup.
if [ -n "$TREE" ]; then
  ENVF=$TREE/.sr-lldb-env
  { echo "# Generated by lldb-dap-env ($(date '+%F %T')): run-be-ut.sh library paths for the debug target only, never the debugger."
    printf 'settings set target.inherit-env true\nsettings set target.env-vars LD_LIBRARY_PATH=%s\n' "$LD_LIBRARY_PATH"; } > "$ENVF.tmp" 2>/dev/null && mv -f "$ENVF.tmp" "$ENVF" 2>/dev/null \
    || echo "lldb-dap-env: 写不了 $ENVF（被调试进程会缺 LD_LIBRARY_PATH，launch 会起不来；attach 不受影响）" >&2
fi
unset LD_LIBRARY_PATH
# abort_on_error=1 makes ASAN raise SIGABRT so the debugger stops at the report.
# Disable leak detection by default because LSan does not support ptrace and may
# fail at process exit even after tests pass. This affects only this debug entrypoint;
# normal sr be-ut behavior is unchanged, and explicit ASAN_OPTIONS takes precedence.
export ASAN_OPTIONS=${ASAN_OPTIONS:-abort_on_error=1:disable_coredump=0:unmap_shadow_on_exit=1:detect_stack_use_after_return=1:detect_leaks=0}
[ -n "${SR_LLDB_ENV_DEBUG:-}" ] && { echo "lldb-dap-env: 源码树 $SR 构建树 ${TREE:-无}"; [ -n "$TREE" ] && cat "$TREE/.sr-lldb-env"; } >&2
exec "$@"
