#!/bin/bash
# CMAKE_CXX_COMPILER_LAUNCHER: pass ordinary TUs to ccache. For PCH, invoke the
# compiler directly and generate <gch>.sum for pch_external_checksum, so ccache
# hashes the checksum instead of non-reproducible .gch bytes.
#
# GCC can produce different .gch bytes even for consecutive builds in one container.
# Hashing those bytes makes every dependent TU miss after a clean build or image change.
# PCH commands also include their own output through -include, causing ccache to
# reject storage as 'Input file modified'. A reproducible .sum enables cross-host reuse.
#
# Checksum algorithm v5; increment its version when semantics change so sr-build
# can migrate old checksums.
# 1. Rewrite absolute paths under CCACHE_BASEDIR to realpath-relative paths from
#    cwd, matching ccache's compiler argv. Prefix substitution or basenames alone
#    are insufficient and can collide across directories or __FILE__ values.
# 2. Keep the cmake_pch.hxx.cxx input and -include header to match PCH preprocessing.
#    GCC does not load .gch with -E.
# 3. Use -E -fdirectives-only to retain #define/#undef without expanding header
#    macros. Full preprocessing misses changes to macros unused inside the PCH.
#    Preserve line/file markers for __INCLUDE_LEVEL__ and __FILE__; remove the
#    working-directory marker with -fno-working-directory.
# 4. Normalize marker filenames using GCC's ordered -ffile-prefix-map semantics:
#    last specified first, stop at the first match. Skip normalization when macro
#    or debug maps are mixed in. Without a map, retain absolute paths conservatively.
# 5. Hash the version, rewritten arguments, and normalized preprocessor output.
#    Remove values only from maps whose effect is fully reflected in normalized
#    output; other mapping values and their order must remain in the hash.
# 6. Publish through a temporary file in the same directory and an atomic rename.
#    On any failure, remove the old .sum so ccache safely falls back to .gch hashing.
set -o pipefail
out=""; prev=""
for a in "$@"; do [ "$prev" = -o ] && out=$a; prev=$a; done
# Detect PCH through -x c++-header/-x c-header or a .gch output; CMake's C PCH command may omit -x.
case " $* " in *" -x c++-header "*|*" -x c-header "*) ;; *) case "$out" in *.gch) ;; *) exec ccache "$@" ;; esac ;; esac

# Generate PCH without ccache: it does not hash -ffile-prefix-map values and may
# restore a .gch with the wrong baked-in __FILE__ values. TU caching uses .sum
# independently of .gch bytes. icecc cannot generate PCH remotely.
# Use icerun for the local daemon's concurrency slots, without changing arguments
# or outputs. Fall back to direct compilation if icerun or the daemon socket is unavailable.
if command -v icerun >/dev/null 2>&1 && [ -S /var/run/icecc/iceccd.socket ]; then icerun "$@"; else "$@"; fi; rc=$?
{ [ $rc = 0 ] && [ -n "$out" ]; } || exit $rc

base=${CCACHE_BASEDIR:-}
# Rewrite the base directory itself too, including arguments such as -I$base.
rel(){ if [ -n "$base" ] && { [ "$1" = "$base" ] || [[ "$1" == "$base"/* ]]; }; then realpath -m --relative-to="$PWD" -- "$1"; else printf '%s' "$1"; fi; }
args=(); skip=0
for a in "$@"; do
  [ $skip = 1 ] && { skip=0; continue; }
  case "$a" in
    -o|-MF|-MT|-MQ) skip=1; continue;;
    -MD|-MMD|-c) continue;;
    -I*) r="-I$(rel "${a#-I}")";;
    *) r=$(rel "$a");;
  esac
  args+=("$r")
done

# Normalize line markers only when all maps are -ffile-prefix-map. GCC prepends
# maps to a list, so the last specified matching map wins, not the longest prefix.
# Preserve argument order and emit sed rules in reverse order; t stops at the first match.
# If macro/debug-specific maps are present, keep every map value and its order in
# the hash instead. This sacrifices cross-directory reuse to preserve correctness.
FMAPS=(); MIXED=0
for a in "${args[@]}"; do case "$a" in -ffile-prefix-map=*=*) FMAPS+=("${a#*=}");; -fmacro-prefix-map=*|-fdebug-prefix-map=*) MIXED=1;; esac; done
sedf="$out.sum.sed.$$"; : > "$sedf" 2>/dev/null
esc_lhs(){ printf '%s' "$1" | sed 's/[][\\.*^$|]/\\&/g'; }   # Match prefix characters such as '.' literally, as GCC uses plain string-prefix comparison.
esc_rhs(){ printf '%s' "$1" | sed 's/[\\&|]/\\&/g'; }          # Escape '&' (the whole match) and '|' (the delimiter) in the sed replacement.
if [ $MIXED = 0 ] && [ ${#FMAPS[@]} -gt 0 ]; then
  for (( k=${#FMAPS[@]}-1; k>=0; k-- )); do
    m=${FMAPS[k]}; printf 's|^\\(# [0-9]* "\\)%s|\\1%s|; t\n' "$(esc_lhs "${m%=*}")" "$(esc_rhs "${m##*=}")"
  done > "$sedf" 2>/dev/null
fi

# For file-only maps, hash option names without values because normalized output
# already captures mapping effects and order. For mixed maps, retain values and
# order so a change in mapped filenames also changes the checksum.
hashed=()
for r in "${args[@]}"; do
  case "$r" in
    -ffile-prefix-map=*=*) if [ $MIXED = 0 ]; then hashed+=("${r%%=*}"); else hashed+=("$r"); fi ;;
    *) hashed+=("$r");;
  esac
done

# Preprocessing, normalization, hashing, writing, and publication must all succeed.
# Otherwise remove the old checksum, which may no longer describe the regenerated PCH.
publish_sum(){
  local tmp sum
  tmp=$(mktemp "$out.sum.XXXXXX" 2>/dev/null) || return 1
  { "${args[@]}" -E -fdirectives-only -fno-working-directory > "$tmp.raw" 2>/dev/null && [ -s "$tmp.raw" ] \
    && [ -f "$sedf" ] && sed -f "$sedf" "$tmp.raw" > "$tmp.i" && [ -s "$tmp.i" ] \
    && sum=$({ printf 'v5\n'; printf '%s\n' "${hashed[@]}"; cat "$tmp.i"; } | sha256sum | cut -d' ' -f1) && [ -n "$sum" ] \
    && printf 'v5 %s\n' "$sum" > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$out.sum"; } || { rm -f "$tmp" "$tmp.raw" "$tmp.i"; return 1; }
  [ -n "${SR_PCH_KEEP_I:-}" ] && mv -f "$tmp.i" "$out.i" 2>/dev/null || rm -f "$tmp.i"   # SR_PCH_KEEP_I=1 retains normalized preprocessor output for inspection.
  rm -f "$tmp.raw"; return 0
}
if ! publish_sum; then
  rm -f "$out.sum"
  echo "ccache-pch: 生成/发布 $out.sum 失败，已删除旧 .sum（该 PCH 的 TU 按 .gch 内容哈希：正确但不可跨机共享）" >&2
fi
rm -f "$sedf"
exit 0
