#!/bin/bash
# sr-build —— StarRocks BE 加速编译驱动（容器内使用）
#   本地 ninja + ccache 为默认；农场可用且重编规模够大时自动外发。
#   所有默认值来自 2026-09 的实测，见 --why。
set -uo pipefail

# 源码树跟着当前目录走：从 $PWD 逐级上溯找 StarRocks 根（build.sh + env.sh + be/src）。
# 这台机上有 20+ 个 worktree，写死一个路径等于每次都编错仓库。
find_root(){ local d; d=$(pwd -P)   # 物理路径：软链接进来与真路径算同一棵树、同一把锁（review latest#1）
  while [ "$d" != / ]; do
    [ -f "$d/build.sh" ] && [ -f "$d/env.sh" ] && [ -d "$d/be/src" ] && { echo "$d"; return 0; }
    d=$(dirname "$d")
  done; return 1; }
FARM_STATE=${FARM_STATE:-/farm/state.env}
# 锁按源码树分，且放共享卷 /farm（不是容器内 /tmp，那样多 profile 容器互相看不见）。
# 同一棵树必须串行：gensrc 产物是共享的，并发会互相覆盖。
# 不同树可以并行：真正的并发闸门是全机单例 iceccd 的 -m 16，不管几个任务在跑，
# 本机同时编译的 cc1plus 都不会超过 16 个，scheduler 会把其余的派到农场。
LOCK=""   # 源码树定下来之后才能算，见下

BT=Release ; DIST=auto ; JAVAEXT=1 ; CLEAN=0 ; GEN=ninja ; JLOCAL=16 ; JSET=0 ; VERBOSE=0 ; CACHE=1
# LOCALCAP（常驻 iceccd 的本机并发上限）挪到读完站点配置之后再算，见下面的 SRCONF 处：
# 在这里算的话，srdev.conf 里的 SR_LOCAL_JOBS 永远不生效，配置模板里那个旋钮等于死的（codex r8#5）。
TARGET=all  # be | fe | all（默认 all：BE+FE；只编一个用 --be / --fe）
usage(){ cat <<'U'
用法: sr-build [源码目录] [选项] [-- 透传给 build.sh 的参数]
  不给源码目录就从当前目录上溯找 StarRocks 根
  --be | --fe | --all            编译目标（默认 all=BE+FE；FE 走原生 maven，不经农场/ccache）
  --debug | --release | --asan   构建类型（默认 release；debug/asan 需显式指定，仅对 be 生效）
  --dist auto|on|off             是否用编译农场（默认 auto）
  --no-java-ext                  跳过 java-extensions（默认构建，仅约 6 秒）
  --clean                        清空该类型的构建树后重建
  --make                         回退到 Unix Makefiles（默认 ninja）
  --no-ccache                    绕过 ccache（仅用于做纯编译计时对比）
  -j N                           本次总并发上限。不给=农场容量+本地16；显式给则整次最多 N 个并发（含本机），内存紧时真能限住本机
  --why                          打印各默认值背后的实测依据
U
}
why(){ cat <<'W'
默认值的实测依据（StarRocks main@f2cedbb2c2f，16 核封顶开发机，机内对比）:
  ninja 而非 make      : 全量 2768s -> 1933s (1.43x)，CPU 利用率 56% -> 84%
  ccache sloppiness    : BE 开 WITH_PCH=ON，默认令 78.4% 的编译绕过缓存；
                         解开后回退/切分支场景 1825s -> 392s (4.66x)
  本地 -j16            : 共享机约束；峰值内存 28.3GB(Debug) / 32.7GB(ASAN)
  分布式并发自适应     : worker数×8 + 本地16。写死 48 会在 worker 变化时吃亏
                         纯本地 -j16 1308s -> 4 worker 778s(1.68x) -> 5 worker 678s(1.93x)
  scheduler 放本容器   : 它只占 3.2MB/0.5%CPU（预处理源码和产物都是 client<->worker 直连，
                         不过它），省下的那台机当 worker，32->40 核，快 14.8%
  农场异步唤醒         : 不等那 29 秒，直接按满并发开工，后台边编边判断要不要唤醒；
                         轮询累计 ccache miss，攒够 8 次才唤醒（全命中的编译不吵醒农场）
  客户端 iceccd -m 16  : 预处理只占编译成本 8.8%，无需为它留核；
                         压到 -m4 实测反而慢 44% (820s -> 1180s)
  --dist auto 阈值     : 农场醒着 >50 条边；睡着 >150 条边(唤醒需 29 秒)
                         实测改 1 个 TU 走农场亏 1.9%，改 377 个赚 45%
  默认建 java-extensions: 热 .m2 下仅 5.8 秒，而跳过会导致
                         output/be/lib/jni-packages 缺 jar，Hive/Iceberg 等连接器运行时失败
W
}
PASS=(); SRARG=""
while [ $# -gt 0 ]; do case "$1" in
  --be) TARGET=be; shift;; --fe) TARGET=fe; shift;; --all) TARGET=all; shift;;
  --debug) BT=Debug; shift;; --release) BT=Release; shift;; --asan) BT=ASAN; shift;;
  --dist) DIST=$2; shift 2;; --no-java-ext) JAVAEXT=0; shift;;
  --clean) CLEAN=1; shift;; --make) GEN=make; shift;; --no-ccache) CACHE=0; shift;;
  -j) JLOCAL=$2; JSET=1; shift 2;; --why) why; exit 0;; -h|--help) usage; exit 0;;
  -v) VERBOSE=1; shift;;
  --) shift; PASS+=("$@"); break;;
  # 目录型位置参数 = 指定源码树，放前放后都行
  *) if [ -d "$1" ] && [ -z "$SRARG" ]; then SRARG=$(cd "$1" && pwd -P); shift   # pwd -P：软链接与真路径同一把锁（review latest#1）
     else echo "未知参数: $1"; usage; exit 1; fi;;
esac; done

# 指定了目录就用它，否则从 $PWD 上溯
if [ -n "$SRARG" ]; then
  SR=$SRARG
  { [ -f "$SR/build.sh" ] && [ -d "$SR/be/src" ]; } || { echo "!! $SR 不像 StarRocks 源码树（缺 build.sh 或 be/src）"; exit 1; }
else
  SR=$(find_root) || { echo "!! 当前目录 $PWD 不在任何 StarRocks 源码树里。"
                       echo "   进到某个 worktree 再跑，或者显式指定：sr build /path/to/starrocks [选项]"; exit 1; }
fi

LOCK=/farm/sr-build.$(printf %s "$SR" | md5sum | cut -c1-12).lock
command -v flock >/dev/null && exec 9>$LOCK && flock -n 9 || {
  echo "!! 这棵源码树已有构建在进行：$SR"
  echo "   同一棵树的 gensrc 产物是共享的，并发会互相覆盖，故串行。"
  echo "   等它结束，或换一棵 worktree（不同树可以并行）。"; exit 1; }
chmod 666 $LOCK 2>/dev/null
printf '%s\n' "$SR" > "$LOCK.tree" 2>/dev/null; chmod 666 "$LOCK.tree" 2>/dev/null

export STARROCKS_HOME=$SR
# 隔离构建树，避免和原生 be/build_* 打架。但老分支的 build.sh 不认这个变量——
# 认不认要看它自己，猜错会导致头部显示的构建树是假的、edges() 数不到边、--clean 删错目录。
if grep -q CMAKE_BUILD_PREFIX "$SR/build.sh" 2>/dev/null; then
  # review extra#5：Ninja 与 Make 不能共用一个 CMake 构建目录（换生成器 CMake 拒绝配置）。新分支认 CMAKE_BUILD_PREFIX，
  # 就按生成器给不同前缀，各自一份互不撞；build.sh 在前缀下仍按 build_$BT 建目录，所以 TREE 仍能算准。
  export CMAKE_BUILD_PREFIX=$SR/be/nj; [ "$GEN" = make ] && export CMAKE_BUILD_PREFIX=$SR/be/nj-make
  TREE_BASE=$CMAKE_BUILD_PREFIX
else
  TREE_BASE=$SR/be                          # 老分支：只能用它原生的位置，生成器无法隔离（见下面的冲突检测）
  TREE_NOTE="  (该分支 build.sh 不支持 CMAKE_BUILD_PREFIX，用原生位置)"
fi
# build.sh 把 $CCACHE 当 CMAKE_CXX_COMPILER_LAUNCHER。
# 用 ccache 当 launcher、靠 CCACHE_PREFIX 转发给 icecc —— 这样缓存和分布式能同时生效。
# ccache-pch = ccache 的薄包装：编 PCH 时顺手写 .gch.sum，配合 pch_external_checksum，见该脚本头注
if [ $CACHE = 1 ]; then export CCACHE=/usr/local/bin/ccache-pch; else export CCACHE=/usr/local/bin/cxxlaunch; export CCACHE_DISABLE=1; fi
export CCACHE_DIR=${SR_CCACHE_DIR:-/ccache}   # SR_CCACHE_DIR 仅供对照实验换目录
# 缓存 key 跟着项目走、与目录无关：以源码树根为 base_dir，树内的绝对路径（-I、源文件、PCH）改写成相对路径再哈希，
# ccache 也把相对路径传给编译器。于是同一份代码放哪个目录、哪个人编，key 都相同，本地 miss 才去远端拿。
# 实测：同一 commit 另一路径、空本地缓存，1639/1640 从远端命中、1m28s。thirdparty/gcc 在树外，保持绝对路径，对所有人一致。
export CCACHE_BASEDIR=$SR
# ccache 远端（可选）：srdev.conf 配了 SR_CCACHE_REMOTE_BUCKET 就把本容器里的 OSS 代理当 http 后端。
# 两级读穿：本地命中不走网，本地 miss 才查远端并回填本地。代理端口按 uid（多用户不撞），
# 凭据用各人自己的 ~/.ossutilconfig（宿主机 sr 以 SR_OSSCFG 传路径）。实测 main 全量：
# 空本地 + 已填充远端 1m51s（对照本地全命中 1m32s、真编 8~11 分钟）；一份 Debug 基线约 3.2 GB / 3244 个对象。
# 站点配置：优先读宿主机每次调用同步进来的 /farm/srdev.conf（目录挂载，改了立刻可见）；/etc/srdev.conf 是旧的单文件挂载，
# 钉在容器创建时的 inode 上、编辑器保存后就过期，只作为老容器的兼容回退
SRCONF=/farm/srdev.conf; [ -f "$SRCONF" ] || SRCONF=/etc/srdev.conf
[ -f "$SRCONF" ] && { set -a; . "$SRCONF"; set +a; }
# 常驻本机 iceccd 的并发上限（全局、只在它首次启动时生效，不随单次 -j 变——不能为了某一次构建重启别的构建也在用的 daemon）。
# 必须在读完配置之后算，否则 srdev.conf 的 SR_LOCAL_JOBS 不生效（codex r8#5）。非正整数一律回退 16。
# 单次构建要限住本机内存，用显式 -j N：它是本次「总并发上限」，ninja 最多同时发 N 个任务（review extra2#1）。
# 先十进制归一化再判正数：只比字面量 "0" 的话，"00"/"000" 会绕过检查、算出 0，daemon 拿到 -m 0（codex r9#2）
LOCALCAP=${SR_LOCAL_JOBS:-16}
case "$LOCALCAP" in ''|*[!0-9]*) LOCALCAP=16;; *) LOCALCAP=$((10#$LOCALCAP)); [ "$LOCALCAP" -gt 0 ] || LOCALCAP=16;; esac
REMOTE_NOTE=""
if [ $CACHE = 1 ] && [ -z "${CCACHE_REMOTE_STORAGE:-}" ] && [ -n "${SR_CCACHE_REMOTE_BUCKET:-}" ]; then
  PPORT=$(( 20700 + ${SR_UID:-0} % 500 )); RPFX=${SR_CCACHE_REMOTE_PREFIX:-ccache/}
  proxy_up(){ [ -n "$(ss -ltnH "sport = :$PPORT" 2>/dev/null)" ]; }   # 不能 `ss | grep -q`：pipefail 下 SIGPIPE 返回 141（踩过）
  # review r7#4(P1)：容器 --network host，127.0.0.1 挡不住本机其他用户；代理无鉴权时任何人都能用所有者凭据 PUT 污染 / DELETE 共享缓存。
  # 每用户随机令牌存 /farm/ccache-token（0600，目录已是 0700），ccache 用 http 后端自带的 bearer-token 属性携带，代理对所有方法校验。
  TOKF=/farm/ccache-token
  # 验证轮 #4：令牌只能生成一次、绝不覆盖——两棵树并发首次生成会一个起代理用 A、另一个把文件盖成 B，客户端此后永久 401。
  # 短锁内复查 + 临时文件 + mv -n（不覆盖）原子发布。
  # 锁内复查“不存在或为空”才生成（非空令牌绝不碰）；临时令牌校验为 64 位 hex 后用 mv -f 原子发布——
  # 不能用 mv -n：它连零字节的残留文件也拒绝替换，空令牌就永远修不好、远端缓存持续禁用（codex 第五轮）。
  if [ ! -s "$TOKF" ]; then
    ( { exec 7>"$TOKF.lock"; } 2>/dev/null && flock -w 10 7 && [ ! -s "$TOKF" ] \
        && head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$TOKF.tmp.$$" && chmod 600 "$TOKF.tmp.$$" \
        && [[ "$(cat "$TOKF.tmp.$$")" =~ ^[0-9a-f]{64}$ ]] && mv -f "$TOKF.tmp.$$" "$TOKF" ) 2>/dev/null
    rm -f "$TOKF.tmp.$$" 2>/dev/null
  fi
  TOK=$(cat "$TOKF" 2>/dev/null)
  # 旧版（无鉴权）代理还在跑时，不带令牌 GET /_stats 会得 200 → 杀掉重起，否则鉴权形同虚设（kill 只影响本用户端口的代理）
  if proxy_up && command -v curl >/dev/null 2>&1 \
     && [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$PPORT/_stats" 2>/dev/null)" = 200 ]; then
    echo "   (发现无鉴权的旧版 ccache 代理，重启以启用令牌校验)"; pkill -f "oss-ccache-proxy.py .*--listen 127.0.0.1:$PPORT " 2>/dev/null; sleep 0.5
  fi
  if ! proxy_up && [ -f "${SR_OSSCFG:-/nonexistent}" ] && [ -n "$TOK" ]; then
    setsid nohup python3 /usr/local/bin/oss-ccache-proxy.py --bucket "$SR_CCACHE_REMOTE_BUCKET" --prefix "$RPFX" --token-file "$TOKF" \
      --listen 127.0.0.1:$PPORT --config "$SR_OSSCFG" --log /farm/ccache-proxy.log </dev/null >>/farm/ccache-proxy.out 2>&1 8>&- 9>&- &
    for i in 1 2 3 4 5 6; do proxy_up && break; sleep 0.5; done
  fi
  if proxy_up && [ -n "$TOK" ]; then
    # connect-timeout 默认 100ms，-j56 并发下会误判；operation-timeout 要容得下 100MB 级的 PCH 结果
    export CCACHE_REMOTE_STORAGE="http://127.0.0.1:$PPORT/|bearer-token=$TOK|connect-timeout=3000|operation-timeout=60000"
    REMOTE_NOTE="oss://$SR_CCACHE_REMOTE_BUCKET/$RPFX (经本容器 :$PPORT)"
  else
    REMOTE_NOTE="未启用：代理起不来（缺 ${SR_OSSCFG:-~/.ossutilconfig}？看 /farm/ccache-proxy.out）"
  fi
elif [ -n "${CCACHE_REMOTE_STORAGE:-}" ]; then REMOTE_NOTE="$CCACHE_REMOTE_STORAGE (环境指定)"; fi
export BUILD_TYPE=$BT
[ "$GEN" = make ] && export PATH=/opt/noninja:$PATH

# ---- 决定要不要用农场 ----
USE_FARM=0; FARM_NOTE="本地"; ASYNC_WAKE=0
# icecc 工具链包必须和当前 gcc 配对：传错版本的包，worker 会用另一个 gcc 编，产物 ABI 不一致且不报错。
# 所以配对检查放在农场决策之前——没有配对的包就只能本地，绝不拿别的 gcc 的包顶替（原来的回退就是这么写的，踩过 review）。
GH=$(basename "${STARROCKS_GCC_HOME:-/opt/gcc-toolset-14}")
TOOLCHAIN=$(ls -1 /opt/icecc/$GH/*.tar.gz 2>/dev/null | head -1)
MISS_MIN=${MISS_MIN:-8}      # 这段时间内 ccache miss 超过几次就算「真在编」
TREE=$TREE_BASE/build_$BT
# review r7#1（codex 第三轮）：透传 --with-gcov 时 build.sh 用 build_${BT}_gcov。探针/依赖戳/pending 必须对准真实目录，
# 否则 gcov 构建成功会把普通树的戳改成新 digest、删掉 pending，普通 Debug 随后在新依赖下不再强制清理、残留旧对象。
# 上游 build.sh 同时支持 --with-gcov / --without-gcov，按出现顺序最后一个生效；驱动必须同样判定。
# 只看"出现过 --with-gcov"的话，`--with-gcov --without-gcov` 会让我们选 build_${BT}_gcov 而上游用 build_${BT}，
# 依赖戳/探针/清理判断全落到错目录（codex r8#6）。
GCOV=0; for a in ${PASS[@]+"${PASS[@]}"}; do case "$a" in --with-gcov) GCOV=1;; --without-gcov) GCOV=0;; esac; done
[ "$GCOV" = 1 ] && TREE=${TREE}_gcov
# 老分支无法按生成器隔离目录：已有 CMakeCache 记的是另一种生成器时，CMake 会拒绝配置，提前识别并要求 --clean（review extra#5）
if [ "$TARGET" != fe ] && [ "$TREE_BASE" = "$SR/be" ] && [ -f "$TREE/CMakeCache.txt" ] && [ $CLEAN = 0 ]; then
  PREVGEN=$(sed -n 's/^CMAKE_GENERATOR:[A-Z]*=//p' "$TREE/CMakeCache.txt" | head -1)
  WANTGEN=Ninja; [ "$GEN" = make ] && WANTGEN="Unix Makefiles"
  if [ -n "$PREVGEN" ] && [ "$PREVGEN" != "$WANTGEN" ]; then
    echo "!! 该分支的构建目录 $TREE 上次用的是「$PREVGEN」，本次要用「$WANTGEN」，老分支无法隔离目录，CMake 会拒绝。"
    echo "   请加 --clean 重来（会清掉该类型的构建树）。"; exit 1
  fi
fi
# review #2：.sum 算法升级到 v5 后，旧 .sum（或有 .gch 无 .sum）的 PCH 强制重建，让新算法落地。只删 .sum 不行——
# PCH 内容只含标准库头，自然重建几乎不会发生，跨机共享会一直断。此处已在源码树锁内、configure/数边之前；
# 只碰 wrapper 管理的产物（*/CMakeFiles/*/cmake_pch.hxx.gch）。C 语言的 cmake_pch.h.gch 不管：build.sh 只给 C++ 配了
# launcher，C 编译不经 ccache，永远不会有 .sum，纳入只会每次误删重建（踩过）。
if [ -z "${SR_DRYRUN:-}" ] && [ "$TARGET" != fe ] && [ -d "$TREE" ]; then   # --fe 不碰 BE 构建树；SR_DRYRUN 不改任何产物（review latest#3）
  OLDPCH=0
  while IFS= read -r g; do
    if [ ! -f "$g.sum" ] || [ "$(head -c 3 "$g.sum" 2>/dev/null)" != "v5 " ]; then rm -f "$g" "$g.sum"; OLDPCH=$((OLDPCH+1)); fi
  done < <(find "$TREE" -path '*/CMakeFiles/*/cmake_pch.hxx.gch' 2>/dev/null)
  [ $OLDPCH -gt 0 ] && echo "   (发现 $OLDPCH 个旧格式 PCH，已删除以重建并生成 v5 .sum；该目标的 TU 本次会按新 key 查缓存)"
fi
# grep -c 计数为 0 时退出码是 1，写 `|| echo 99999` 会输出两行 "0\n99999"（踩过三次了）
# 数边只看现有 build.ninja，绝不能先跑 build.sh --configure-only：它每次都重写 gensrc/codegen/*/*_manifest.cmake，
# 所有 codegen 的 .stamp 随之变脏，依赖 stamp 的全部 TU 跟着重编——此前每一次默认 sr build 都是全量 ninja 遍历，
# 一直被 ccache 命中掩盖（SR_EXPLAIN=1 抓到的现行）。编译器/依赖路径变了导致 build.ninja 过期的情况由下面的 FRESH 检测覆盖；
# build.ninja 本身过期（ninja -n 第一条是 Re-running CMake）时数不准，交给"开工并后台按 miss 评估"路径兜底。
# 输出两个值 "边数 清单是否过期"，调用方 read < <(edges)。不能在函数里给全局变量赋值——$(edges) 是子 shell，
# 赋值会丢（review 用注入 Re-running CMake 的 ninja 桩抓到 MANIFEST_DIRTY 恒为 0）
MANIFEST_DIRTY=0
edges(){ [ -f "$TREE/build.ninja" ] || { echo "99999 0"; return; }
         local out n d=0; out=$( cd "$TREE" && ninja -n 2>/dev/null ); n=$(printf '%s\n' "$out" | grep -c 'CXX object')
         printf '%s\n' "$out" | grep -q 'Re-running CMake' && d=1
         echo "${n:-99999} $d"; }
# 农场是硬前置。这是个分布式编译项目，没有农场就别开工——
# 静默退化成本地编译只会让人以为"就这么慢"，而不知道少了 1.9 倍。
# 没有农场：不能分布式，但可以本机编。交互时问一句（y 继续 / 其它退出），非交互保持拒绝——脚本里静默退化成本地
# 只会让人以为"就这么慢"，要放行请显式 SR_LOCAL_OK=1
# FE 是 maven/Java，农场和 ccache 都帮不上：先定死本地，下面的农场检查只约束需要农场的构建（review：原来 --fe 也会被"无农场"拦住）
[ "$TARGET" = fe ] && { DIST=off; FARM_NOTE="本地（FE 是 maven/Java，农场和 ccache 都帮不上）"; }
NOFARM=""
if [ ! -f "$FARM_STATE" ] && [ "$DIST" != off ]; then
  echo "!! 还没有编译农场：无法分布式编译（全量约慢 1.9 倍），只能本机 -j$JLOCAL。"
  echo "   建农场: sr farm init（约 6~9 分钟建 5 台 worker；之后休眠/唤醒/续约/自愈全自动，不用再管）"
  if [ -t 0 ] || [ -n "${SR_TTY:-}" ]; then   # SR_TTY 由宿主机 sr 按自己的 stdin 设置：docker exec -i 下容器内 -t 0 恒为假
    printf '   现在先用本机编译吗？[y/N] ' >&2; read -r ans   # 提示走 stderr：stdin 非终端（docker exec -i / | tee）时 read -p 不打印提示（review#6）
    case "$ans" in y|Y|yes|YES) DIST=off; NOFARM=1; FARM_NOTE="本地（尚无农场，用户确认）";; *) echo "   已取消。"; exit 1;; esac
  elif [ -n "${SR_LOCAL_OK:-}" ]; then
    DIST=off; NOFARM=1; FARM_NOTE="本地（尚无农场，SR_LOCAL_OK=1）"
  else
    echo "   非交互环境不自动退化；要本机编请设 SR_LOCAL_OK=1 或加 --dist off。"; exit 1
  fi
fi
# 农场标记为 degraded（resume 修复后仍连不上）时也拒绝：这是分布式工具，不能静默退回本地。显式 --dist off 与 FE 不算静默，不拦（review）
if [ "$DIST" != off ] && grep -q '^FARM_STATUS=degraded' "$FARM_STATE" 2>/dev/null; then
  echo "!! 农场处于 degraded（worker 未连上，resume 修复失败）。先 sr farm status 排查，或 sr farm resume 重试。"
  exit 1
fi
# 走本地的几种原因分别写清楚，别混成一句
[ "$DIST" = off ] && [ -z "$NOFARM" ] && [ "$TARGET" != fe ] && FARM_NOTE="本地（--dist off）"
if [ "$DIST" != off ] && grep -q '^FARM_STATUS=releasing' "$FARM_STATE" 2>/dev/null; then
  DIST=off; FARM_NOTE="本地（农场正在释放，sr farm down 尚未确认完成）"
  echo "!! 农场正在释放，本次按无农场处理（本地 -j$JLOCAL）"
fi
if [ "$DIST" != off ] && [ ! -f "$TOOLCHAIN" ]; then
  DIST=off; FARM_NOTE="本地（镜像里没有与 $GH 配对的 icecc 工具链包，不能外发）"
  echo "!! /opt/icecc/$GH/ 下没有工具链包，本次不用农场（重建镜像应修复；绝不拿别的 gcc 的包顶替）"
fi
# review extra#2：--output-compile-time 会让 build.sh 把 launcher 换成 compile_time.sh，直接调编译器、不经 ccache/icecc；
# 此时再按农场容量设 -j 会把几十个编译全压到本机、丢掉 iceccd 的本机上限 → 强制本地并发。
case " ${PASS[*]:-} " in *" --output-compile-time "*)
  [ "$DIST" != off ] && echo " (检测到 --output-compile-time：计时 launcher 不经农场/ccache，强制本地 -j$JLOCAL)"; DIST=off;; esac
# review#2(P1)+r7#1 定案：容器内 thirdparty 路径恒为 /var/local/thirdparty，提取又 cp -a 保留时间戳；ninja 只看 mtime，
# 切回旧 digest 或新依赖文件更旧时会误判"无需重编"、残留旧产物（ccache 救不了：命令根本没跑）。按 digest 给 BE 构建树打戳：
#   有戳且 ≠ 当前 → 强制 --clean（交给 build.sh 删真实目录，不自己 rm 猜的路径）；
#   无戳但有树：目录外的 pending 记录存在 = 上次切依赖的 clean 构建被中断、树内容不可信 → 强制 --clean；
#              没有 pending = 早于此功能的历史树 → 采纳当前 digest 为基线（明确接受来源未知的风险，打印警告）。
# 戳写入规则在构建结束处（RC=0，或“探针被清掉且构建文件重新存在”证明真的清理并重配置过）。
if [ "$TARGET" != fe ] && [ -n "${SR_TPDIGEST:-}" ]; then
  STAMP=$TREE/.sr_tpdigest; PENDING=$TREE_BASE/.sr_pending_$(basename "$TREE")
  if [ -f "$STAMP" ]; then
    if [ "$(cat "$STAMP" 2>/dev/null)" != "$SR_TPDIGEST" ] && [ $CLEAN = 0 ]; then
      echo "   依赖 digest 变了（$(cat "$STAMP") -> $SR_TPDIGEST）→ 强制 --clean 全量，防时间戳误判残留旧产物"; CLEAN=1
    fi
  elif [ -f "$TREE/build.ninja" ] || [ -f "$TREE/Makefile" ]; then
    if [ -f "$PENDING" ]; then
      echo "   上次切依赖（→ $(cat "$PENDING" 2>/dev/null)）的 clean 构建被中断，树内容不可信 → 强制 --clean"; CLEAN=1
    else
      echo "   警告：该构建树没有依赖戳（早于此功能），本次采纳 $SR_TPDIGEST 为基线；若怀疑其来源请 sr build --clean"
    fi
  fi
fi
# review r7#3(P1)：state.env 只按白名单键解析、不再 source（曾可被替换后当 root 执行）；解析失败按无农场本地编译
load_farm_state(){ local k v; [ -f "$FARM_STATE" ] || return 1
  while IFS='=' read -r k v || [ -n "$k" ]; do v=${v%\"}; v=${v#\"}
    case "$k" in
      CLUSTER|NETNAME) [[ "$v" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || return 1;;
      CID|WORKERS|NCPU|SPORT|DPORT) [[ "$v" =~ ^[0-9]{1,10}$ ]] || return 1;;
      SCHED) [[ "$v" =~ ^[0-9.]{7,15}$ ]] || return 1;;
      NODES) [[ "$v" =~ ^[0-9.\ ]*$ ]] || return 1;;
      FARM_STATUS) case "$v" in initializing|running|degraded|suspended|releasing) ;; *) return 1;; esac;;
      ''|'#'*) continue;;
      *) return 1;;
    esac; printf -v "$k" '%s' "$v"; done < "$FARM_STATE"; }
# 只要状态文件在就加载（含 --dist off）：本地模式起 daemon 也要用它记的 scheduler/端口/netname，否则先本地后农场时 daemon 配置对不上
if [ -f "$FARM_STATE" ] && ! load_farm_state; then
  echo "!! $FARM_STATE 格式不符（可能损坏或被篡改），本次不用农场，本地 -j$JLOCAL"; DIST=off; FARM_NOTE="本地（state.env 解析失败）"
fi
# review r7#6：本地 iceccd 两种模式共用（原来只在农场分支里起，本地模式直连编译器、无跨树并发闸门）。起不来返回 1。
# 必须排除僵尸：pgrep 会匹配 <defunct> 的 iceccd；端口全机唯一，多 profile 容器只有第一个能 bind，其余共用同一 daemon。
iceccd_alive(){ local p st; for p in $(pgrep -x iceccd 2>/dev/null); do st=$(awk '{print $3}' /proc/$p/stat 2>/dev/null); [ "$st" != Z ] && return 0; done; return 1; }
port_taken(){ [ -n "$(ss -ltnH "sport = :${DPORT:-10245}" 2>/dev/null)" ]; }
ensure_local_daemon(){ local sopt=() p cl
  # 验证轮 #3：--dist off 先跑时没有农场状态，原来会起一个默认端口/默认 netname/无 -s 的 daemon，之后农场构建发现它活着就沿用，
  # 却连不上用户的 scheduler。这里优先用 state.env 加载到的值（上面无论 --dist 都会加载），没有农场时按与 sr-farm 完全相同的
  # 公式从 uid/用户名派生，两种模式起出来的 daemon 配置一致；scheduler 常驻本容器，地址就是本机 IP，没起也只是 daemon 后台重试。
  SCHED=${SCHED:-$(hostname -I 2>/dev/null | awk '{print $1}')}
  SPORT=${SPORT:-$(( 18700 + 2 * (${SR_UID:-0} % 250) ))}
  DPORT=${DPORT:-$(( 19700 + ${SR_UID:-0} % 500 ))}
  NETNAME=${NETNAME:-${SR_USER:-u}_farm}
  if { iceccd_alive || port_taken; }; then
    # daemon 已在：核对它启动时的 -n/-s 是否就是本次期望的配置。不一致只警告不重启——别的构建可能正在用它（重启由 sr down/up 完成）
    for p in $(pgrep -x iceccd 2>/dev/null); do
      cl="$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null) "
      [[ "$cl" == *iceccd* ]] || continue
      # 顺序无关的两段匹配（bash 实测：拼接两段引号的 case 双备选模式对完全相同的命令行也判不匹配，会每次误报）
      if ! [[ "$cl" == *" -n $NETNAME "* && "$cl" == *" -s $SCHED:$SPORT "* ]]; then
        echo "!! 常驻 iceccd 的配置与本次期望不同（期望 -n $NETNAME -s $SCHED:$SPORT）：$(echo "$cl" | grep -oE -- '-n [^ ]+|-s [^ ]+' | tr '\n' ' ')"
        echo "   它可能是在别的农场配置下启动的；农场构建会连不上 scheduler。空闲时 sr down && sr up 重建容器即可刷新。"
      fi
      break
    done
    return 0
  fi
  [ -n "${SCHED:-}" ] && sopt=(-s "$SCHED:$SPORT")
  mkdir -p /var/run/icecc
  # 8>&- 9>&-：daemon 常驻，不得继承农场锁/构建锁的 fd（踩过：锁被永久占住，编完再也拿不到锁）
  /usr/sbin/iceccd -d ${sopt[@]+"${sopt[@]}"} -n "${NETNAME:-srfarm}" -m $LOCALCAP -p "${DPORT:-10245}" \
    -N "$(hostname)-${SR_USER:-u}" -u nobody -l /tmp/iceccd.log </dev/null >/dev/null 2>&1 8>&- 9>&-
  sleep 3; { iceccd_alive || port_taken; }; }
if [ "$DIST" != off ]; then
  sr-farm _wd 2>/dev/null || true   # 容器重启后把看门狗拉回来
  # state.env 已在上面按白名单键解析进变量（SCHED / FARM_STATUS / WORKERS / NCPU…），不再 source（review r7#3）
  read -r N MANIFEST_DIRTY < <(edges); N=${N:-99999}; MANIFEST_DIRTY=${MANIFEST_DIRTY:-0}
  # 构建树不存在（首次 / --clean）时必然是大规模真编译，不必等 miss 攒够再唤醒；
  # 这样唤醒能和 cmake configure 那 30-60 秒重叠，而不是等到编译真开始才动。
  FRESH=0; { [ ! -f "$TREE/build.ninja" ] || [ $CLEAN = 1 ]; } && FRESH=1
  # 边数是在 build.sh 跑 cmake configure 之前数的。若编译器或 thirdparty 路径和 CMakeCache 里记的不同，
  # configure 会把所有边标脏，实际是全量——此时按"0 条边"选本地 -j16 就亏大了（踩过：换 base 后全量本地 22 分钟）
  if [ $FRESH = 0 ] && [ -f "$TREE/CMakeCache.txt" ]; then
    CC_CACHED=$(sed -n 's/^CMAKE_CXX_COMPILER:[A-Z]*=//p' "$TREE/CMakeCache.txt" | head -1)
    TP_CACHED=$(grep -oE '/tp/[0-9a-f]{12,64}|/var/local/thirdparty' "$TREE/CMakeCache.txt" | head -1)
    CC_NOW=${STARROCKS_GCC_HOME:-/opt/gcc-toolset-14}/bin/g++
    TP_NOW=${STARROCKS_THIRDPARTY:-/var/local/thirdparty}
    if { [ -n "$CC_CACHED" ] && [ "$(readlink -f "$CC_CACHED")" != "$(readlink -f "$CC_NOW")" ]; } \
       || { [ -n "$TP_CACHED" ] && [ "$TP_CACHED" != "${TP_NOW%/installed}" ]; }; then
      FRESH=1; echo "   (编译器或依赖路径与上次 configure 不同，视为全量重编)"
    fi
  fi
  THRESH=50; [ "${FARM_STATUS:-}" = suspended ] && THRESH=150
  [ $MANIFEST_DIRTY = 1 ] && echo "   (build.ninja 已过期，边数 ${N} 只是下限；按需要农场处理，睡着则边编边评估是否唤醒)"
  if [ "$DIST" = on ] || [ "$N" -gt "$THRESH" ] || [ $FRESH = 1 ] || [ $MANIFEST_DIRTY = 1 ]; then
    if [ "${FARM_STATUS:-}" = suspended ]; then
      # 不同步等那 29 秒。直接按「农场已就位」的并发开工：本地 daemon 会把真正在跑的
      # 编译卡在 -m 16，多出来的槽在 icecc 里排队；农场一醒，排队的立刻溢出到远端。
      # （依据：scheduler 故障注入实测，scheduler 死时本地仍稳在 16 并发、不 OOM、能编完）
      # 同时后台观察 15 秒——若 ccache 一路命中，说明这次根本不用编，就别吵醒农场。
      USE_FARM=1; ASYNC_WAKE=1
      if [ $FRESH = 1 ]; then
        FARM_NOTE="分布式 (农场休眠中，已开工并立即后台唤醒)"
      else
        FARM_NOTE="分布式 (农场休眠中，已开工并后台评估是否唤醒)"
      fi
    elif timeout 4 bash -c "echo > /dev/tcp/${SCHED}/${SPORT:-8765}" 2>/dev/null; then
      USE_FARM=1; FARM_NOTE="分布式 (scheduler ${SCHED}, ${WORKERS:-?} 台 worker)"
    else
      FARM_NOTE="本地（农场 ${SCHED} 连不上，已降级）"
    fi
  else
    FARM_NOTE="本地（本次仅重编约 ${N} 个 TU，未达外发阈值 ${THRESH}）"
  fi
fi
if [ $USE_FARM = 1 ]; then
  # 并发 = 远端总核 + 本机 16。写死 48 会在 worker 数变化时吃亏（5 台时容量其实是 56）
  # 总并发 = 每台 worker 的槽数(NCPU，init 时按节点核数或 SR_NODE_JOBS 写进 state.env) × 台数 + 本地。
  # 老的 state.env 没有 NCPU 时退回 8（旧农场都是 8 核，行为不变）。
  # 显式 -j N 是本次总并发上限（review extra2#1：原来 -j 只加在远端容量上，用户为省内存写 -j4 却仍 -j44 且本机可跑 16 个）
  export USE_ICECC=1; unset ICECC 2>/dev/null || true   # 显式清掉 ICECC=no：环境若继承了它，icecc 会禁掉外发（codex 第三轮）
  if [ "$JSET" = 1 ]; then J=$JLOCAL; else J=$(( ${WORKERS:-4} * ${NCPU:-8} + JLOCAL )); fi
  # icecc 拒绝符号链接，必须给真实文件；给错了会静默退回本地编译。
  # 单容器带多套 gcc，工具链包必须和当前 STARROCKS_GCC_HOME 配对——
  # 传错版本的包，worker 上就用错编译器编，产物 ABI 不一致且不报错。
  export ICECC_VERSION=$TOOLCHAIN     # 配对检查已在农场决策前做过，走到这里一定存在
  [ $CACHE = 1 ] && export CCACHE_PREFIX=icecc     # ccache 未命中时才外发，命中直接取 .o
  # 必须排除僵尸：pgrep 会匹配到 <defunct> 的 iceccd，让人误以为 daemon 还活着。
  # 后果很重：客户端连不上本地 daemon 时，icecc 会「无限制地」退回本地编译，
  # -j56 就变成 56 个 cc1plus 并发，48G 容器必被 OOM 杀（踩过，cgroup oom 计数 34）。
  iceccd_alive(){ local p st; for p in $(pgrep -x iceccd 2>/dev/null); do
      st=$(awk '{print $3}' /proc/$p/stat 2>/dev/null); [ "$st" != Z ] && return 0; done; return 1; }
  # 端口是全机唯一的：多 profile 容器各起一个 daemon，只有第一个能 bind 10245，
  # 后面的静默失败，客户端连不上就无限制本地并发 → OOM（踩过）。
  # 共享 /var/run/icecc 之后，所有容器的客户端都连同一个 daemon。
  port_taken(){ [ -n "$(ss -ltnH "sport = :${DPORT:-10245}" 2>/dev/null)" ]; }
  { iceccd_alive || port_taken; } || {
    mkdir -p /var/run/icecc
    # 9>&- 必须加：daemon 会继承持有构建锁的 fd 9，它常驻就把锁永久占住（踩过，
    # 症状是编译结束后再也拿不到锁、报「已有构建在进行」而 ps 里根本没有 sr-build）
    /usr/sbin/iceccd -d -s "$SCHED:${SPORT:-8765}" -n "${NETNAME:-srfarm}" -m $LOCALCAP \
      -p "${DPORT:-10245}" -N "$(hostname)-${SR_USER:-u}" -u nobody -l /tmp/iceccd.log </dev/null >/dev/null 2>&1 9>&-
    sleep 3; }
  # 兜底：daemon 没起来就绝不能用远端级别的并发，否则全落本地把容器撑爆
  { iceccd_alive || port_taken; } || { echo "!! 本地 iceccd 起不来，降级为本地编译 -j$JLOCAL"; \
                    USE_FARM=0; export USE_ICECC=0; J=$JLOCAL; ASYNC_WAKE=0; FARM_NOTE="本地（本地 iceccd 起不来，已降级）"; unset CCACHE_PREFIX ICECC_VERSION 2>/dev/null || true; }
else
  J=$JLOCAL
  # review r7#6：本地模式也经本机 iceccd。ICECC=no 让 icecc 客户端只在本机编、但仍占 daemon 的槽位（上游明确区分该路径与无 daemon 回退），
  # 于是 -m $LOCALCAP 成为跨源码树共享的本机并发闸门（原来直连编译器，两棵树各 -j16 会叠成 32 个 cc1plus），且绝不外发、不唤醒农场。
  if [ "$TARGET" != fe ] && ensure_local_daemon; then
    export USE_ICECC=1 ICECC=no; [ $CACHE = 1 ] && export CCACHE_PREFIX=icecc
    FARM_NOTE="$FARM_NOTE；本机并发经 iceccd 闸门(-m $LOCALCAP)"
  else
    export USE_ICECC=0; unset CCACHE_PREFIX ICECC 2>/dev/null || true
    [ "$TARGET" != fe ] && echo "!! 本地 iceccd 不可用，本机并发无跨树闸门（仅 ninja -j$J）"
  fi
fi

case $TARGET in
  be)  ARGS=(--be -j "$J") ;;
  fe)  ARGS=(--fe -j "$J") ;;
  all) ARGS=(--be --fe -j "$J") ;;
esac
[ "$TARGET" != fe ] && [ $JAVAEXT = 0 ] && ARGS+=(--without-java-ext)
# --clean 只传给 build.sh，由它删自己真正在用的目录。此处不再 rm 我们猜的 $TREE：
# 透传 --with-gcov 时 build.sh 用 build_Debug_gcov，猜 build_Debug 会把普通 Debug 产物误删（review latest#2）；
# 同时 SR_DRYRUN 也就不会再动任何产物（review latest#3）。
[ $CLEAN = 1 ] && ARGS+=(--clean)
[ ${#PASS[@]} -gt 0 ] && ARGS+=("${PASS[@]}")

echo "=========================================================="
echo " 目标: $TARGET$([ "$TARGET" = fe ] && echo "   (maven，农场/ccache 不参与)")"
[ "$TARGET" != fe ] && echo " 类型: $BT      生成器: $GEN      并发: -j$J"
echo " 模式: $FARM_NOTE"
[ -n "${SR_DRYRUN:-}" ] && { echo " (SR_DRYRUN=1：决策已打印，到此为止不编译)"; exit 0; }   # 测试钩子：验证农场/交互决策
echo " 版本: ${SR_VER:-未指定}   编译器: $(${STARROCKS_GCC_HOME:-/usr}/bin/gcc -dumpfullversion 2>/dev/null || echo ?)   依赖: ${STARROCKS_THIRDPARTY:-默认}"
echo " 源码树: $SR"
echo " 构建树: $TREE${TREE_NOTE:-}"
if [ $CACHE = 1 ]; then
  CS=$(ccache -s 2>/dev/null | sed -n 's/^Cache size (\{0,1\}[^)]*)\{0,1\}:[[:space:]]*//p' | head -1)
  [ -n "$CS" ] || CS=$(ccache -s 2>/dev/null | awk -F': *' '/Cache size/{print $2; exit}')
  echo " ccache: ${CS:-0} / 上限 $(ccache -k max_size 2>/dev/null || echo 75G)"
  [ -n "$REMOTE_NOTE" ] && echo " ccache 远端: $REMOTE_NOTE"
else
  echo " ccache: 已禁用 (--no-ccache)"
fi
echo " java-extensions: $([ $JAVAEXT = 1 ] && echo 构建 || echo 跳过'(产物将缺 jni-packages 等 jar)')"
echo "=========================================================="
# 心跳：容器是 root，宿主看门狗是普通用户，必须放宽权限双方才都能更新
mkdir -p /farm 2>/dev/null; : > /farm/last-build 2>/dev/null; chmod 666 /farm/last-build 2>/dev/null
# ---- OOM 观测 ----
# 三个互相独立的读数，不共用同一条链路（单一读数骗过自己太容易了）：
#   1) cgroup oom_kill 计数器 —— 内核的权威记账
#   2) 编译日志里 g++ 自报的 "Killed signal terminated program cc1plus"
#   3) memory.peak 距 memory.max 的余量 —— 就算没被杀也能看出贴没贴顶
CG=/sys/fs/cgroup
oomcnt(){ awk '/^oom_kill /{print $2}' $CG/memory.events 2>/dev/null \
          || cat $CG/memory/memory.failcnt 2>/dev/null || echo 0; }
g(){ awk -v n="$1" 'BEGIN{printf "%.1f", n/1073741824}'; }
OOM0=$(oomcnt)
HIT0=$(ccache -s 2>/dev/null | awk -F'[ /]+' '/^ *Hits:/{print $3; exit}'); HIT0=${HIT0:-0}
CALL0=$(ccache -s 2>/dev/null | awk -F'[ /]+' '/^Cacheable calls:/{print $3; exit}'); CALL0=${CALL0:-0}
# 不能用 memory.peak 判断内存紧不紧：它把 page cache 算在内，而编译要写 20G 构建树，
# 峰值必然贴满上限（实测 48.0/48.0G 但 oom_kill=0，全是可回收的 file cache）。
# 真正会撑爆的是 anon，所以自己采样 anon 峰值。
ANONF=/tmp/sr-build-anonpeak.$$   # 每次构建独立：并行构建共用一个文件会互相覆盖峰值（review#5）
PARENT=$$
( echo 0 > $ANONF
  while :; do
    # 双保险：trap 在 bash 等待前台 build.sh 时会被推迟执行，若有人只 kill 了 sr-build 本身，采样器要能自己发现父亡而退出，
    # 否则它会一直 touch /farm/last-build 让农场永远"忙"（review#5 复现的正是这个）
    kill -0 $PARENT 2>/dev/null || break
    a=$(awk '/^anon /{print $2}' $CG/memory.stat 2>/dev/null); [ -n "$a" ] || break
    m=$(cat $ANONF 2>/dev/null || echo 0); [ "$a" -gt "${m:-0}" ] && echo "$a" > $ANONF
    # 顺带打心跳：看门狗跨容器看不到编译进程，只能靠这个文件的 mtime 判断忙闲
    touch /farm/last-build 2>/dev/null
    sleep 5
  done ) >/dev/null 2>&1 9>&- &
SAMPLER=$!
# review#5：构建被 Ctrl+C/kill 时采样器原来会活下来继续 touch /farm/last-build，让农场永远"忙"而无法休眠。
# 用 trap 统一收尾（正常退出与 INT/TERM 都覆盖）；WAKER 在异步唤醒子 shell 起来后再补进来。
# review r7#7：EXIT 只清理；INT/TERM 要真正取消本次构建——杀构建自己的进程组、10s 宽限后仍有成员则 KILL、回收，再以 130/143 退出。
# 原来一个 trap 兼任两职且不 exit：只 kill 驱动时，bash 等前台管道结束才跑 trap，采样器停了、构建照跑还可能报成功。
HS=""   # 当前 run_build 的握手文件前缀；取消路径 on_signal 直接 exit，不会走到 run_build 末尾的清理，所以由 cleanup 兜底删
cleanup(){ kill $SAMPLER ${WAKER:-} 2>/dev/null; rm -f "$ANONF" "${RUNFLAG:-/nonexistent}" "${PROBE:-/nonexistent}" 2>/dev/null
  [ -n "$HS" ] && rm -f "$HS" "$HS.pgid" "$HS.ack" 2>/dev/null; }
on_signal(){ local sig=$1 i
  echo ""; echo "!! 收到 $sig，取消本次构建…"
  if [ -n "${BPGID:-}" ]; then kill -TERM -- "-$BPGID" 2>/dev/null
  elif [ -n "${BPID:-}" ]; then kill -TERM "$BPID" 2>/dev/null; fi        # 握手前只知道 wrapper 本体
  for i in $(seq 1 100); do [ -n "${BPGID:-}" ] && pgrep -g "$BPGID" >/dev/null 2>&1 || break; sleep 0.1; done
  [ -n "${BPGID:-}" ] && pgrep -g "$BPGID" >/dev/null 2>&1 && { echo "   组内仍有进程忽略 TERM，改发 KILL"; kill -KILL -- "-$BPGID" 2>/dev/null; }
  [ -n "${BPID:-}" ] && wait "$BPID" 2>/dev/null
  cleanup; if [ "$sig" = INT ]; then exit 130; else exit 143; fi; }
trap cleanup EXIT; trap 'on_signal INT' INT; trap 'on_signal TERM' TERM
# 构建包装：在新 session（自成进程组）里跑 build.sh|tee 并在里面取 PIPESTATUS，RC 由 setsid --wait 转发，不再跨后台管道用 PIPESTATUS。
# 每次调用独立握手文件；wrapper 先公布 pgid、收到父确认后才开工，父在此之前就知道该杀谁（codex 第三轮：启动窗口与重试残留）。
BPID=""; BPGID=""
run_build(){ local i
  HS=$(mktemp /tmp/sr-build.hs.XXXXXX); rm -f "$HS.pgid" "$HS.ack"
  # 只关 fd 8（农场锁），**保留 fd 9**：构建包装是有限生命周期，让它继承源码树锁，驱动被 SIGKILL 时仍在跑的构建才继续持锁，
  # 同树第二个构建拿不到锁（codex 验证轮 #1：原来连 9 也关了，驱动一死锁就放，会并发写 gensrc）。常驻 daemon 才关 9。
  # 握手 fail closed（验证轮 #2）：wrapper 30s 内没收到 ACK 就退出不开工；父 30s 内没拿到合法 pgid 就杀掉 wrapper，本次判失败。
  setsid --wait bash -c 'hs=$1; sr=$2; outf=$3; shift 3; echo $$ > "$hs.pgid"
      for i in $(seq 1 300); do [ -f "$hs.ack" ] && break; sleep 0.1; done
      [ -f "$hs.ack" ] || { echo "!! 构建包装 30s 未收到驱动确认，不开工" >&2; exit 250; }
      cd "$sr" && ( ./build.sh "$@" ) 2>&1 | tee -a "$outf"; exit "${PIPESTATUS[0]}"' _ "$HS" "$SR" "$OUTF" "$@" 8>&- &
  BPID=$!
  for i in $(seq 1 300); do [ -s "$HS.pgid" ] && break; sleep 0.1; done
  BPGID=$(cat "$HS.pgid" 2>/dev/null)
  if [[ "$BPGID" =~ ^[0-9]+$ ]]; then : > "$HS.ack"
  else echo "!! 构建包装 30s 内未公布进程组，握手失败，终止本次构建"; BPGID=""; kill -TERM "$BPID" 2>/dev/null; fi
  wait "$BPID"; RC=$?
  [ "$RC" = 250 ] && echo "!! 构建包装因握手超时未开工（rc=250）"
  rm -f "$HS" "$HS.pgid" "$HS.ack"; HS=""; BPID=""; BPGID=""; }

# 后台评估是否值得唤醒农场。ccache 命中一次只要 4-5ms，真编一个 TU 要几秒到几分钟，
# 两者差着三四个数量级，所以观察 15 秒的 miss 增量就足以分辨，不需要任何预测。
RUNFLAG=/tmp/sr-build.running.$$
misses(){ ccache -s 2>/dev/null | awk -F'[ /]+' '/^ *Misses:/{print $3; exit}'; }
if [ "${ASYNC_WAKE:-0}" = 1 ]; then
  : > $RUNFLAG
  # 不能用「开工后固定等 N 秒」来判断：build.sh 前 30-60 秒在跑 cmake configure 和 gensrc，
  # 一次编译都还没发生，miss 恒为 0，于是真编译也会被误判成全命中（踩过）。
  # 改成轮询累计 miss：一旦攒够 MISS_MIN 次就唤醒，攒不够就说明真全命中，让农场继续睡。
  ( if [ "${FRESH:-0}" = 1 ]; then
      # 全新构建树：不必等 miss，立刻唤醒，让 29 秒藏进 configure 阶段
      echo "   [农场] 全新构建树，必有大量真编译 -> 立即唤醒（与 configure 并行）"
      sr-farm resume >/dev/null 2>&1
      exit 0
    fi
    M0=$(misses); M0=${M0:-0}
    while [ -f $RUNFLAG ]; do
      sleep 5
      [ -f $RUNFLAG ] || break                     # 编译已结束，白唤醒没意义
      if [ $CACHE = 0 ]; then D=99999; else M1=$(misses); D=$(( ${M1:-0} - M0 )); fi
      if [ "$D" -ge "$MISS_MIN" ]; then
        echo "   [农场] 已累计 ${D} 次 ccache miss，确属真编译 -> 唤醒农场"
        sr-farm resume >/dev/null 2>&1
        exit 0
      fi
    done
    echo "   [农场] 全程仅 ${D:-0} 次 ccache miss，基本全命中 -> 未唤醒，农场继续睡" ) 9>&- &
  WAKER=$!   # 纳入 trap 收尾，构建被杀时异步唤醒循环不再独自活着
fi

S=$(date +%s)
# 输出文件必须每次构建独立：不同源码树可以在同一容器里并发编，共用一个 /tmp 文件会把两份输出搅在一起，
# 失败那次的报错被另一边的进度行冲掉（踩过：只剩 FAILED 一行，错误正文没了）
OUTF=$(mktemp /tmp/sr-build.XXXXXX)
# 调试钩子：SR_EXPLAIN=1 时在开工前让 ninja 解释哪些边为什么脏（排查"明明没改代码却全量"用）
[ -n "${SR_EXPLAIN:-}" ] && [ -f "$TREE/build.ninja" ] && { echo "== ninja explain（开工前，前 15 条）:"; ninja -C "$TREE" -n -d explain 2>&1 | grep "^ninja explain" | head -15 | cut -c1-220; }
# review r7#1：强制 clean 前在目录外记 pending（想切到的 digest），并在树内放唯一探针；结束后“探针消失 + 构建文件重新存在”才证明真的清过
PENDING=${PENDING:-$TREE_BASE/.sr_pending_$(basename "$TREE")}; PROBE=""
if [ "$TARGET" != fe ] && [ $CLEAN = 1 ] && [ -n "${SR_TPDIGEST:-}" ]; then
  echo "$SR_TPDIGEST" > "$PENDING" 2>/dev/null || true
  [ -d "$TREE" ] && { PROBE=$TREE/.sr_clean_probe.$RANDOM$$; : > "$PROBE" 2>/dev/null || PROBE=""; }
fi
run_build "${ARGS[@]}"
E=$(date +%s)
: > /farm/last-build 2>/dev/null; chmod 666 /farm/last-build 2>/dev/null

# 先读一遍 OOM 痕迹用于决定要不要重试；采样器不停——重试期间要继续采样（review #6），结束后再读最终值。
# grep -c 计数为 0 时退出码是 1，写 `|| echo 0` 会变成两行 "0\n0"，后面 [ "$KILLED" -gt 0 ] 就报 integer expression expected（踩过两次了）
OOM1=$(oomcnt)
KILLED=$(grep -c "Killed signal terminated program" "$OUTF" 2>/dev/null); KILLED=${KILLED:-0}
PEAK=$(cat $ANONF 2>/dev/null || echo 0); MAXM=$(cat $CG/memory.max 2>/dev/null || echo 0)

# 失败 + 有 OOM 痕迹 = 明确诊断，并自动降并发重试一次（ninja 是增量的，重试只补没编完的）
if [ $RC -ne 0 ] && { [ "${OOM1:-0}" -gt "${OOM0:-0}" ] || [ "${KILLED:-0}" -gt 0 ]; }; then
  echo ""
  echo "!! 编译失败是内存打爆导致的，不是代码问题："
  echo "   cgroup oom_kill: $OOM0 -> $OOM1   g++ 自报被杀: $KILLED 次"
  [ "${MAXM:-0}" != 0 ] && [ "$MAXM" != max ] && \
    echo "   anon 峰值 $(g ${PEAK:-0})G / 上限 $(g $MAXM)G"
  # review extra#4：重试并发绝不能高于原并发（用户为省内存手动 -j2，OOM 后原来会被抬到 4）；已是 -j1 无从再降就不重试
  RETRY=$(( J / 2 )); [ "$RETRY" -lt 1 ] && RETRY=1; [ "$RETRY" -ge "$J" ] && RETRY=$(( J > 1 ? J - 1 : 1 ))
  if [ "$J" -le 1 ]; then
    echo "   已是 -j1，无法再降并发重试；内存仍不够请减小容器内其它占用或换更大内存"
  else
  echo "   -> 自动降到 -j$RETRY 重试（ninja 增量，只补没编完的部分）"
  # 从原参数派生：只换并发、去掉 --clean（重试是增量）。目标（--fe/--all）和 -- 透传全部保留（review #5：
  # 原来重建成 --be 会把 FE 和透传丢掉，BE 重试成功还会把整体报成成功）。build.sh 只认 "-j N"，-jN 顺手也处理
  RARGS=(); skip=0
  for a in "${ARGS[@]}"; do
    [ $skip = 1 ] && { skip=0; continue; }
    case "$a" in -j) skip=1; continue;; -j[0-9]*) continue;; --clean) continue;; esac
    RARGS+=("$a")
  done
  RARGS+=(-j "$RETRY")
  echo "   重试: ./build.sh ${RARGS[*]}" | tee -a "$OUTF"
  run_build "${RARGS[@]}"   # 输出追加进同一份日志；复用同一包装，进程组/取消语义与首次一致（review r7#7）
  E=$(date +%s)
  fi
fi
# 依赖戳写入（review r7#1 定案）：RC=0 写；失败时只有“本次强制 clean 且探针已被清掉且生成器构建文件重新存在”才写——
# 这证明目录真的被清并重新配置过、树里已是新依赖的产物。写成功即删 pending。其它情况保留旧戳/pending，下次照样强制 clean（多清不漏清）。
# 原来无条件写戳：build.sh 因非法参数在 clean 前退出也会被记成新依赖，下次不再清理、旧对象残留。
if [ "$TARGET" != fe ] && [ -n "${SR_TPDIGEST:-}" ] && [ -d "$TREE" ]; then
  WS=0; [ $RC = 0 ] && WS=1
  if [ $WS = 0 ] && [ $CLEAN = 1 ] && [ -n "${PROBE:-}" ] && [ ! -e "$PROBE" ]; then
    BF=build.ninja; [ "$GEN" = make ] && BF=Makefile
    [ -f "$TREE/$BF" ] && WS=1
  fi
  if [ $WS = 1 ]; then echo "$SR_TPDIGEST" > "$TREE/.sr_tpdigest" 2>/dev/null && rm -f "${PENDING:-/nonexistent}"; fi
fi
rm -f "${PROBE:-/nonexistent}" 2>/dev/null
rm -f $RUNFLAG      # 采样与异步唤醒循环到这里才退出：重试期间也要继续采样、继续心跳
: > /farm/last-build 2>/dev/null; chmod 666 /farm/last-build 2>/dev/null
kill $SAMPLER 2>/dev/null
# 最终值覆盖两次尝试：峰值取采样器全程最大，oom/Killed 计数含重试
OOM1=$(oomcnt); KILLED=$(grep -c "Killed signal terminated program" "$OUTF" 2>/dev/null); KILLED=${KILLED:-0}
PEAK=$(cat $ANONF 2>/dev/null || echo 0)

printf "\n== 结束 rc=%d 用时 %dm%02ds ==\n" $RC $(( (E-S)/60 )) $(( (E-S)%60 ))
# 每次编译记一行概况到 /farm/builds.tsv（宿主机卷，sr history 看），完整输出另存一份
HIT1=$(ccache -s 2>/dev/null | awk -F'[ /]+' '/^ *Hits:/{print $3; exit}'); HIT1=${HIT1:-0}
CALL1=$(ccache -s 2>/dev/null | awk -F'[ /]+' '/^Cacheable calls:/{print $3; exit}'); CALL1=${CALL1:-0}
MODE_SHORT=本地; case "$FARM_NOTE" in 分布式*) MODE_SHORT=分布式;; esac
mkdir -p /farm/logs 2>/dev/null
LOGF=/farm/logs/$(date +%Y%m%d-%H%M%S)-$(basename "$SR")-${BT}.log
cp "$OUTF" "$LOGF" 2>/dev/null; chmod 666 "$LOGF" 2>/dev/null; ln -sfn "$LOGF" /tmp/sr-build-last.out; rm -f "$OUTF"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$(date '+%m-%d %H:%M:%S')" "${SR_USER:-?}" "$(basename "$SR")@${SR_BRANCH:-?}" "${SR_VER:-?}/${SR_TPDIGEST:-?}" \
  "$MODE_SHORT" "${N:-?}" "$RC" "$(( (E-S)/60 ))m$(( (E-S)%60 ))s" "$(g ${PEAK:-0})G" \
  "$(( HIT1 - ${HIT0:-0} ))/$(( CALL1 - ${CALL0:-0} ))" "$LOGF" >> /farm/builds.tsv 2>/dev/null; chmod 666 /farm/builds.tsv 2>/dev/null
# 报 anon 余量（不含 page cache）。ASAN 每槽约 2.04G、Debug 约 1.77G，贴到 85% 再加并发就危险了
if [ "${MAXM:-0}" != 0 ] && [ "$MAXM" != max ] && [ "${PEAK:-0}" != 0 ]; then
  PCT=$(awk -v a=$PEAK -v b=$MAXM 'BEGIN{printf "%.0f", a*100/b}')
  printf " anon 峰值 %sG / 上限 %sG (%s%%)   oom_kill %s->%s%s\n" \
    "$(g $PEAK)" "$(g $MAXM)" "$PCT" "$OOM0" "$OOM1" \
    "$([ "$PCT" -ge 85 ] && echo '  <- 余量偏紧，再加并发或换 ASAN 有 OOM 风险')"
fi
[ $CACHE = 1 ] && [ "$TARGET" != fe ] && ccache -s 2>/dev/null | grep -E 'Cacheable calls|Hits:|Uncacheable' | head -3   # 全局累计值，FE 不走 ccache 就不打

# 产物落点。build.sh 只会闷头打一句 OUTPUT DIR=，既不说二进制在哪也不说是不是这次新出的
if [ $RC -eq 0 ]; then
  echo ""
  if [ "$TARGET" = fe ] || [ "$TARGET" = all ]; then
    FOUT=$SR/output/fe
    echo " FE 产物: $FOUT"
    FJ=$(ls -1 "$FOUT/lib/"*.jar 2>/dev/null | wc -l)
    [ -d "$FOUT/lib" ] && echo "   lib/  $FJ 个 jar   bin/ conf/ webroot/"
    # FE 的真实开销在 maven reactor 摘要里。日志里可能有多段 reactor：--clean 会先单独跑一次 mvn clean（同样列出 fe-core，
    # 全是 0.0x s），java-extensions 也有一段（属 BE）。只取最后一段含 fe-core 的
    if [ -f "$LOGF" ]; then
      # 去掉颜色码和可能的时间戳前缀（MAVEN_OPTS 开了 showDateTime 时每行前面有 HH:mm:ss）
      FELOG=$(mktemp); tr '\r' '\n' < "$LOGF" | sed -E 's/\x1b\[[0-9;]*m//g; s/^[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)? //' > "$FELOG"
      awk '/Reactor Summary/{f=1; buf=""} f{buf=buf $0 "\n"} /BUILD (SUCCESS|FAILURE)/{if(f && buf ~ /fe-core/) last=buf; f=0} END{printf "%s", last}' "$FELOG" \
        | grep -E ' (SUCCESS|FAILURE) ' | sed -E 's/^\[INFO\] //; s/ \.{2,} / /' \
        | awk 'BEGIN{print " FE(maven) 各模块耗时:"} {t=$0; sub(/^.*\[ */,"",t); sub(/\]$/,"",t); printf "   %-22s %-8s %s\n", $1, $2, t}'
      # javac 到底重编了哪些模块：看 "Compiling N source file(s) to <dir>/target/classes" 自带的输出目录归属，-T 并行下各模块日志
      # 交错也不会错（review：全局阶段变量会被别的模块的 testCompile 覆盖而漏计，单数 "1 source file" 也没匹配）；只算 fe/ 下的
      # 主源码，测试编译进 test-classes 不算。"Nothing to compile" 那行没有路径归属不了，不再报"N 个模块已是最新"
      # 行形如 "[INFO] Compiling 4670 source files to /abs/fe/fe-core/target/classes"（compiler 3.13 会多一段 "with javac [...]"）
      MODS=$(sed -nE "s#^(\[INFO\] )?Compiling ([0-9]+) source files?( with javac \[[^]]*\])? to $SR/fe/(.+)/target/classes\$#\\4 \\2#p" "$FELOG" | sort -u)
      NM=$(printf '%s\n' "$MODS" | grep -c .)
      if [ "$NM" -gt 0 ]; then
        echo "   javac 重编 $NM 个模块：$(printf '%s\n' "$MODS" | awk '{printf "%s%s %s 文件", (NR>1?"，":""), $1, $2}')（maven 的增量粒度是整模块：fe-core 有一个文件变就整模块重编）"
      else echo "   javac 未识别到重编记录（日志里没匹配到 Compiling … to …/target/classes；可能确实没重编，也可能日志格式变了，不据此断言全新）"; fi
      rm -f "$FELOG"
    fi
  fi
  [ "$TARGET" = fe ] && exit $RC
  OUT=$SR/output/be
  BIN=$OUT/lib/starrocks_be
  echo " BE 产物: $OUT"
  if [ -f "$BIN" ]; then
    # 用 mtime 判断这次到底有没有重新产出，避免拿着上次的二进制以为是新的
    AGE=$(( $(date +%s) - $(stat -c %Y "$BIN") ))
    BINFRESH=$([ $AGE -le $((E-S+120)) ] && echo "本次生成" || echo "未更新，仍是 $((AGE/60)) 分钟前那份")
    printf "   %-46s %s  (%s)\n" "lib/starrocks_be" "$(du -h "$BIN"|cut -f1)" "$BINFRESH"
  else
    echo "   !! 没找到 lib/starrocks_be"
  fi
  NJ=$(ls -1 "$OUT/lib/jni-packages/" 2>/dev/null | wc -l)
  [ "$NJ" -gt 0 ] && echo "   lib/jni-packages/                              $NJ 个 jar"
  [ "$NJ" = 0 ] && [ $JAVAEXT = 0 ] && echo "   lib/jni-packages/  (空 —— 用了 --no-java-ext，Hive/Iceberg 等连接器运行时会失败)"
  echo "   bin/ conf/ www/"
fi
exit $RC
