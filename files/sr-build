      # Wake immediately for a new tree so farm startup overlaps configuration.
      echo "   [农场] 全新构建树，必有大量真编译 -> 立即唤醒（与 configure 并行）"
      sr-farm resume 6>&- >>/farm/watchdog.log 2>&1
      exit 0
    fi
    M0=$(misses); M0=${M0:-0}
    while [ -f $RUNFLAG ]; do
      sleep 5
      [ -f $RUNFLAG ] || break                     # The build has finished; waking the farm would be unnecessary.
      if [ $CACHE = 0 ]; then D=99999; else M1=$(misses); D=$(( ${M1:-0} - M0 )); fi
      if [ "$D" -ge "$MISS_MIN" ]; then
        echo "   [农场] 已累计 ${D} 次 ccache miss，确属真编译 -> 唤醒农场"
        sr-farm resume 6>&- >>/farm/watchdog.log 2>&1
        exit 0
      fi
    done
    echo "   [农场] 全程仅 ${D:-0} 次 ccache miss，基本全命中 -> 未唤醒，农场继续睡" ) 6>&- 9>&- &
  WAKER=$!   # Include the wakeup loop in trap cleanup so it cannot outlive a cancelled build.
fi

S=$(date +%s)
# Use separate output files for each build. Different source trees can compile
# concurrently in one container; a shared log would interleave output and hide errors.
OUTF=$(mktemp /tmp/sr-build.XXXXXX)
# The running sidecar shares the lock-file prefix and stores history fields,
# start time, and temporary log/sample paths. sr history tests the lock to ignore
# stale records left by SIGKILL. Normal exit and INT/TERM remove it through cleanup.
RUNF=${LOCK%.lock}.run
# Field 11 identifies the build/test phase. After compilation, history already
# contains the build result while the lock remains held for tests; marking the
# phase prevents one invocation from looking like two separate builds.
write_runf(){ printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%m-%d %H:%M:%S')" "${SR_USER:-?}" "$(basename "$SR")@${SR_BRANCH:-?}" \
  "${SR_VER:-?}/${SR_TPDIGEST:-?}" "$MODE_SHORT" "${N:-?}" "$TGT" "$1" "$OUTF" "$ANONF" "$2" > "$RUNF" 2>/dev/null; chmod 666 "$RUNF" 2>/dev/null; }
write_runf "$S" 编译
# SR_EXPLAIN=1 asks Ninja to explain dirty edges before building, for diagnosing unexpected full rebuilds.
[ -n "${SR_EXPLAIN:-}" ] && [ -f "$TREE/build.ninja" ] && { echo "== ninja explain（开工前，前 15 条）:"; ninja -C "$TREE" -n -d explain 2>&1 | grep "^ninja explain" | head -15 | cut -c1-220; }
# Before forced cleaning, record the target digest outside the tree and place a unique probe inside. Probe removal plus recreated build files proves cleaning occurred.
PENDING=${PENDING:-$TREE_BASE/.sr_pending_$(basename "$TREE")}; PROBE=""
if [ "$TARGET" != fe ] && [ $CLEAN = 1 ] && [ -n "${SR_TPDIGEST:-}" ]; then
  echo "$SR_TPDIGEST" > "$PENDING" 2>/dev/null || true
  [ -d "$TREE" ] && { PROBE=$TREE/.sr_clean_probe.$RANDOM$$; : > "$PROBE" 2>/dev/null || PROBE=""; }
fi
run_build "${ARGS[@]}"
E=$(date +%s)
: > /farm/last-build 2>/dev/null; chmod 666 /farm/last-build 2>/dev/null

# Diagnose compiler signal termination without automatically retrying. Lowering
# Ninja -j may leave iceccd slots and linker concurrency unchanged, repeating the
# same resource failure while silently occupying the shared host. Users can rerun
# explicitly; Ninja will still rebuild only unfinished work.
#
# Detect both Terminated and Killed compiler messages. Host earlyoom may send
# SIGTERM before SIGKILL without incrementing the container's oom_kill counter.
# A signal alone does not identify its sender, so report termination without
# asserting that earlyoom or OOM caused it.
# grep -c prints zero with status 1; do not append another zero on failure.
OOM1=$(oomcnt)
KILLED=$(grep -c "signal terminated program" "$OUTF" 2>/dev/null); KILLED=${KILLED:-0}
PEAK=$(cat $ANONF 2>/dev/null || echo 0); MAXM=$(cat $CG/memory.max 2>/dev/null || echo 0)

if [ $RC -ne 0 ] && { [ "${OOM1:-0}" -gt "${OOM0:-0}" ] || [ "${KILLED:-0}" -gt 0 ]; }; then
  echo ""
  echo "!! 本次失败是编译器进程被信号终止，不是代码问题："
  echo "   g++ 自报被信号终止 $KILLED 次   cgroup oom_kill: $OOM0 -> $OOM1"
  [ "${MAXM:-0}" != 0 ] && [ "$MAXM" != max ] && \
    echo "   anon 峰值 $(g ${PEAK:-0})G / 上限 $(g $MAXM)G"
  # Attribute OOM only when the cgroup oom_kill counter increases. SIGTERM/SIGKILL
  # can also come from manual cancellation, timeouts, or host earlyoom.
  if [ "${OOM1:-0}" -gt "${OOM0:-0}" ]; then
    echo "   cgroup oom_kill 增加了 -> 本容器内存打爆，这是硬证据。"
  else
    echo "   cgroup oom_kill 没动 -> 不是本容器 OOM。常见来源是宿主机 earlyoom（按全机可用内存挑 cc1plus/ld"
    echo "   下手，先 SIGTERM 再 SIGKILL），但也可能是别的 kill；要坐实得拿宿主机日志对上 PID 和时间。"
  fi
  echo "   不自动重试。ninja 是增量的，直接重跑同一条命令只会补没编完的部分；"
  echo "   本地构建可用 SR_LOCAL_JOBS=<较小并发> SR_LINK_JOBS=1 临时覆盖后重跑，无需重建容器。"
  echo "   分布式的本机上限还受常驻 iceccd 槽位影响；不要为单次构建重启正在使用的容器。"
fi
# Write the dependency stamp after success. On failure, write it only if this
# forced-clean attempt removed the probe and recreated generator build files,
# proving that the tree was cleaned and reconfigured. Remove pending only after
# stamping succeeds; otherwise preserve old markers so the next build cleans again.
# An early argument error must not mark untouched old objects as using new dependencies.
if [ "$TARGET" != fe ] && [ -n "${SR_TPDIGEST:-}" ] && [ -d "$TREE" ]; then
  WS=0; [ $RC = 0 ] && WS=1
  if [ $WS = 0 ] && [ $CLEAN = 1 ] && [ -n "${PROBE:-}" ] && [ ! -e "$PROBE" ]; then
    BF=build.ninja; [ "$GEN" = make ] && BF=Makefile
    [ -f "$TREE/$BF" ] && WS=1
  fi
  if [ $WS = 1 ]; then echo "$SR_TPDIGEST" > "$TREE/.sr_tpdigest" 2>/dev/null && rm -f "${PENDING:-/nonexistent}"; fi
fi
rm -f "${PROBE:-/nonexistent}" 2>/dev/null
rm -f $RUNFLAG      # Keep sampling and heartbeat updates active until the build finishes, then stop background helpers.
: > /farm/last-build 2>/dev/null; chmod 666 /farm/last-build 2>/dev/null
kill $SAMPLER 2>/dev/null
# Report the sampler's peak and termination counters across the entire build.
OOM1=$(oomcnt); KILLED=$(grep -c "signal terminated program" "$OUTF" 2>/dev/null); KILLED=${KILLED:-0}   # Count both Terminated and Killed messages.
PEAK=$(cat $ANONF 2>/dev/null || echo 0)

printf "\n== 结束 rc=%d 用时 %dm%02ds ==\n" $RC $(( (E-S)/60 )) $(( (E-S)%60 ))
# Append one build summary to host-mounted /farm/builds.tsv for sr history and save the full log separately.
HIT1=$(ccache -s 2>/dev/null | awk -F'[ /]+' '/^ *Hits:/{print $3; exit}'); HIT1=${HIT1:-0}
CALL1=$(ccache -s 2>/dev/null | awk -F'[ /]+' '/^Cacheable calls:/{print $3; exit}'); CALL1=${CALL1:-0}
mkdir -p /farm/logs 2>/dev/null
# Construct the log suffix as one string. Multiple echo calls inside command
# substitution leave embedded newlines that corrupt filenames and history records.
SUF=$BT; [ "$TARGET" = ut ] && SUF=ut_$BT; [ $FEUT = 1 ] && SUF=feut
LOGF=/farm/logs/$(date +%Y%m%d-%H%M%S)-$(basename "$SR")-$SUF.log
cp "$OUTF" "$LOGF" 2>/dev/null; chmod 666 "$LOGF" 2>/dev/null; ln -sfn "$LOGF" /tmp/sr-build-last.out; rm -f "$OUTF"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$(date '+%m-%d %H:%M:%S')" "${SR_USER:-?}" "$(basename "$SR")@${SR_BRANCH:-?}" "${SR_VER:-?}/${SR_TPDIGEST:-?}" \
  "$MODE_SHORT" "${N:-?}" "$RC" "$(( (E-S)/60 ))m$(( (E-S)%60 ))s" "$(g ${PEAK:-0})G" \
  "$(( HIT1 - ${HIT0:-0} ))/$(( CALL1 - ${CALL0:-0} ))" "$LOGF" "$TGT" >> /farm/builds.tsv 2>/dev/null; chmod 666 /farm/builds.tsv 2>/dev/null
# Report anonymous-memory headroom, excluding page cache. Measured per-slot usage was about 2.04 GB for ASAN and 1.77 GB for Debug; avoid adding jobs near 85% usage.
if [ "${MAXM:-0}" != 0 ] && [ "$MAXM" != max ] && [ "${PEAK:-0}" != 0 ]; then
  PCT=$(awk -v a=$PEAK -v b=$MAXM 'BEGIN{printf "%.0f", a*100/b}')
  printf " anon 峰值 %sG / 上限 %sG (%s%%)   oom_kill %s->%s%s\n" \
    "$(g $PEAK)" "$(g $MAXM)" "$PCT" "$OOM0" "$OOM1" \
    "$([ "$PCT" -ge 85 ] && echo '  <- 余量偏紧，再加并发或换 ASAN 有 OOM 风险')"
fi
[ $CACHE = 1 ] && [ "$TARGET" != fe ] && ccache -s 2>/dev/null | grep -E 'Cacheable calls|Hits:|Uncacheable' | head -3   # Global cumulative statistics; omit for FE, which does not use ccache.

# After compdb configuration, run code generation so clangd can resolve generated
# headers such as gen_cpp/xxx.h. Build only these two targets, without compiling C++ units.
if [ "$TARGET" = compdb ] && [ $RC = 0 ]; then
  if [ -f "$TREE/build.ninja" ]; then
    echo ""
    echo "== 生成 thrift / proto 代码（clangd 要靠它解析 gen_cpp 里的头文件）…"
    CGT=""
    for t in be_thrift_codegen be_proto_codegen; do
      grep -q "^build $t: phony" "$TREE/build.ninja" 2>/dev/null && CGT="$CGT $t"
    done
    if [ -n "$CGT" ]; then
      if ninja -C "$TREE" $CGT 2>&1 | tail -3; then :; else RC=1; echo "!! 代码生成失败，compile_commands.json 仍在，但 clangd 会报生成头文件找不到"; fi
    else
      echo "   (这个分支的 build.ninja 里没有 be_thrift_codegen / be_proto_codegen 目标，跳过)"
    fi
    echo "   gensrc 下生成头文件 $(find "$TREE/gensrc" -name '*.h' 2>/dev/null | wc -l) 个"
  else
    echo "!! $TREE/build.ninja 不存在，configure 可能没成功"; RC=1
  fi
fi

# Symlink the selected tree's compile_commands.json at the source root so clangd
# can find it without per-build-type configuration. The last selected tree wins.
# Upstream already ignores this root-level filename. Use a relative target so
# moving the checkout preserves the link. Never overwrite a regular file: update
# only a missing path or an existing symlink.
if [ "$TARGET" != fe ] && [ "${SR_CC_LINK:-1}" != 0 ] && [ -f "$TREE/compile_commands.json" ]; then
  CCL=$SR/compile_commands.json
  case "$TREE/" in "$SR"/*) CCREL=${TREE#"$SR"/}/compile_commands.json;; *) CCREL=$TREE/compile_commands.json;; esac
  if [ -e "$CCL" ] && [ ! -L "$CCL" ]; then
    echo "   (根目录已有真实的 compile_commands.json，没有动它；要用软链接请先把它删掉，或设 SR_CC_LINK=0 关掉这个功能)"
  elif [ "$(readlink "$CCL" 2>/dev/null)" = "$CCREL" ]; then
    : # Already points to the selected tree; no change needed.
  else
    CCTMP=$SR/.compile_commands.json.sr.$$
    if ln -s "$CCREL" "$CCTMP" 2>/dev/null && mv -Tf "$CCTMP" "$CCL" 2>/dev/null; then
      echo " clangd: compile_commands.json -> $CCREL"
    else
      rm -f "$CCTMP" 2>/dev/null
      echo "   (没能在 $SR 下建 compile_commands.json 软链接，clangd 需自行指定路径)"
    fi
  fi
fi

[ "$TARGET" = compdb ] && exit $RC   # Configure-only has no artifacts to report and does not need linker-gate verification.

# Verify both link gates in generated Ninja files; older env.sh versions may
# ignore CUSTOM_CMAKE and silently omit injection. CMake writes pool assignments
# in build.ninja and the linker launcher in CMakeFiles/rules.ninja, so check both.
if [ "$TARGET" != fe ] && [ -f "$TREE/build.ninja" ]; then
  gate_ok=1
  grep -q 'pool = link' "$TREE/build.ninja" 2>/dev/null || { gate_ok=0; echo "!! ninja 链接池没进 $TREE/build.ninja"; }
  grep -q linkgate "$TREE/CMakeFiles/rules.ninja" 2>/dev/null || { gate_ok=0; echo "!! 容器级链接闸门没进 $TREE/CMakeFiles/rules.ninja"; }
  [ $gate_ok = 1 ] || {
    echo "   多半是这个分支的 env.sh 不认 CUSTOM_CMAKE，注入落空了。大规模链接（尤其 ASAN 单测）可能撞内存上限。"; }
fi

# Report artifact paths and whether this build updated them. FE tests have no
# artifact summary here; their result is in Maven/Surefire output.
[ $FEUT = 1 ] && exit $RC
if [ $RC -eq 0 ]; then
  echo ""
  if [ "$TARGET" = fe ] || [ "$TARGET" = all ]; then
    FOUT=$SR/output/fe
    echo " FE 产物: $FOUT"
    FJ=$(ls -1 "$FOUT/lib/"*.jar 2>/dev/null | wc -l)
    [ -d "$FOUT/lib" ] && echo "   lib/  $FJ 个 jar   bin/ conf/ webroot/"
    # Use the last Maven reactor summary containing fe-core. Earlier summaries may
    # come from mvn clean or BE Java extensions and do not represent the FE build cost.
    if [ -f "$LOGF" ]; then
      # Strip ANSI colors and optional HH:mm:ss prefixes added by Maven showDateTime.
      FELOG=$(mktemp); tr '\r' '\n' < "$LOGF" | sed -E 's/\x1b\[[0-9;]*m//g; s/^[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)? //' > "$FELOG"
      awk '/Reactor Summary/{f=1; buf=""} f{buf=buf $0 "\n"} /BUILD (SUCCESS|FAILURE)/{if(f && buf ~ /fe-core/) last=buf; f=0} END{printf "%s", last}' "$FELOG" \
        | grep -E ' (SUCCESS|FAILURE) ' | sed -E 's/^\[INFO\] //; s/ \.{2,} / /' \
        | awk 'BEGIN{print " FE(maven) 各模块耗时:"} {t=$0; sub(/^.*\[ */,"",t); sub(/\]$/,"",t); printf "   %-22s %-8s %s\n", $1, $2, t}'
      # Attribute javac work by each Compiling line's output directory, which remains
      # reliable when parallel reactor logs interleave. Count main sources under fe/
      # ending in target/classes, excluding test-classes. Handle singular source file
      # and newer with javac [...] output. Nothing to compile has no module path,
      # so it cannot reliably identify an up-to-date module.
      MODS=$(sed -nE "s#^(\[INFO\] )?Compiling ([0-9]+) source files?( with javac \[[^]]*\])? to $SR/fe/(.+)/target/classes\$#\\4 \\2#p" "$FELOG" | sort -u)
      NM=$(printf '%s\n' "$MODS" | grep -c .)
      if [ "$NM" -gt 0 ]; then
        echo "   javac 重编 $NM 个模块：$(printf '%s\n' "$MODS" | awk '{printf "%s%s %s 文件", (NR>1?"，":""), $1, $2}')（maven 的增量粒度是整模块：fe-core 有一个文件变就整模块重编）"
      else echo "   javac 未识别到重编记录（日志里没匹配到 Compiling … to …/target/classes；可能确实没重编，也可能日志格式变了，不据此断言全新）"; fi
      rm -f "$FELOG"
    fi
  fi
  [ "$TARGET" = fe ] && exit $RC
  if [ "$TARGET" = ut ]; then
    UTB=$TREE/test
    echo " 单测产物: $UTB"
    # Split symbols only when no debuglink exists; honor explicit
    # --without-debug-symbol-split. Avoid readelf | grep -q under pipefail because
    # SIGPIPE can make a valid match appear false.
    NOSPLIT=0; case " ${PASS[*]:-} " in *" --without-debug-symbol-split "*) NOSPLIT=1;; esac
    # Use .gnu_debuglink alone for idempotence, not mtime. A previous failed build
    # may have linked a binary but never reached splitting; a later incremental build
    # will not relink it, so an mtime filter would skip it forever. Reading section
    # headers is inexpensive even for large binaries.
    split_fresh(){ local b=$1 d
      [ -f "$b" ] || return 0
      [ -n "$(readelf -S "$b" 2>/dev/null | grep -F .gnu_debuglink)" ] && return 0
      d=$b.debuginfo
      # Announce splitting before objcopy: large ASAN binaries can take several minutes
      # without intermediate output and otherwise appear to hang after compilation.
      local t0=$(date +%s) why="本次重新链接"
      # Explain one-time catch-up splitting for an older binary. Its earlier build may
      # have failed after linking but before cleanup; adding debuglink prevents repeat work.
      [ "$(stat -c %Y "$b" 2>/dev/null || echo 0)" -ge "$S" ] || why="此前没拆过（链接它的那次构建多半失败了），补拆一次，之后不再拆"
      echo "   拆分调试符号: $(basename "$b") ($(du -h "$b" | cut -f1)) —— $why"
      echo "   需要几分钟，请稍候…"
      # Keep the original binary intact until every split step succeeds. First write
      # .debuginfo at its final name, then strip a binary copy and add debuglink to it,
      # then atomically replace the original. objcopy records the symbol file's basename,
      # so a temporary symbol filename would leave a broken link after renaming.
      # On any failure, the original still contains full symbols and partial outputs
      # can be removed without losing debugging information.
      local bt=$b.split.$$
      SPLIT_TMP="$bt"        # Track only the binary copy for cleanup, never .debuginfo; see cleanup above.
      if objcopy --only-keep-debug "$b" "$d" \
         && cp -p "$b" "$bt" && strip --strip-debug "$bt" && objcopy --add-gnu-debuglink="$d" "$bt" \
         && mv -f "$bt" "$b"; then
        SPLIT_TMP=""          # After mv, bt no longer exists; an interrupted cleanup's rm -f is harmless.
        echo "   已拆分 -> $(basename "$d")（用时 $(( ($(date +%s) - t0) / 60 ))m$(( ($(date +%s) - t0) % 60 ))s）"
      else
        rm -f "$bt" "$d" 2>/dev/null; SPLIT_TMP=""   # The original binary is untouched on this path, so removing partial outputs is safe.
        echo "   !! 拆分 $(basename "$b") 的调试符号失败（盘满？），原二进制未改动，仍带完整符号，只是加载慢些"
      fi; }
    for tb in starrocks_test starrocks_dw_test; do
      B=$UTB/$tb; [ -f "$B" ] || continue
      [ $NOSPLIT = 0 ] && split_fresh "$B"
      AGE=$(( $(date +%s) - $(stat -c %Y "$B") ))
      printf "   %-46s %s  (%s)\n" "test/$tb" "$(du -h "$B"|cut -f1)" "$([ $AGE -le $((E-S+120)) ] && echo 本次生成 || echo "未更新，仍是 $((AGE/60)) 分钟前那份")"
    done
    [ -f "$UTB/starrocks_test" ] || echo "   !! 没找到 test/starrocks_test"
    # Per-module *test binaries, matching upstream starrocks_collect_test_binaries.
    NT=$(find "$UTB" -type f -perm -111 -name '*test' 2>/dev/null | grep -v -e starrocks_test -e starrocks_dw_test -e bench_test -e builtin_functions_fuzzy_test | wc -l)
    [ "$NT" -gt 0 ] && echo "   另有 $NT 个模块独立测试二进制"
    if [ $RUN = 0 ]; then
      echo ""
      echo " 跑单测: sr be-ut                                 全部"
      echo "         sr be-ut --test CompactionUtilsTest      某个测试（前缀匹配）"
      echo "         sr be-ut --gtest_filter 'A*:B*'          gtest 过滤表达式"
      echo "         sr be-ut --module storage                某个模块的独立二进制"
      echo "   (测试二进制不能直接执行：它动态依赖 libjvm.so 和 thirdparty 下的一堆 .so，还要 CLASSPATH、"
      echo "    UDF_RUNTIME_DIR、ASAN_OPTIONS、conf/be_test.conf 里导出的变量——这些都由 run-be-ut.sh 现场准备。"
      echo "    直接跑会报 error while loading shared libraries: libjvm.so。也别直接跑 ./run-be-ut.sh：它会用"
      echo "    另一套 launcher/构建目录重新 configure，等于从头本地全编一遍。)"
      exit $RC
    fi
    # ---- Phase two: run tests using local parallelism; Ninja should have no work.
    # Keep configuration-affecting options identical to phase one to avoid a full
    # rebuild. The compiler, cache, type, and build-prefix environment are unchanged.
    # Sampling and farm heartbeats have stopped so long-running tests do not prevent
    # idle suspension, but retain the source-tree lock to protect test binaries.
    # Reconstruct arguments from driver options and the original user arguments. Keep
    # an explicit user --dry-run, which requests listing tests without executing them.
    # Preserve --without-java-ext and other relevant options, but remove --clean so
    # the test phase cannot trigger another full build after monitoring has stopped.
    RARGS=(-j "$JLOCAL" --without-debug-symbol-split)
    [ $DYNLIB = 1 ] && RARGS+=(--with-dynamic)   # Keep configuration options identical across phases to avoid reconfiguration and a full rebuild.
    [ $JAVAEXT = 0 ] && RARGS+=(--without-java-ext)
    write_runf "$(date +%s)" 跑测试   # Update the sidecar to the test phase so sr history uses this phase's start time and duration.
    for a in ${PASS[@]+"${PASS[@]}"}; do
      case "$a" in --clean) continue;; esac
      RARGS+=("$a")
    done
    # BE requires at least 60000 file descriptors before opening the storage engine.
    # Raise the soft limit to min(hard limit, 65536), inherited by run-be-ut.sh.
    # Warn without aborting if the limit cannot be raised.
    UTNOF=$(ulimit -Hn 2>/dev/null)
    case "$UTNOF" in unlimited) UTNOF=65536;; ''|*[!0-9]*) UTNOF=0;; esac
    [ "$UTNOF" -gt 65536 ] && UTNOF=65536
    if [ "$UTNOF" -ge 60000 ] && ulimit -n "$UTNOF" 2>/dev/null; then
      echo "   fd 上限已抬到 $(ulimit -Sn)（BE storage engine 要求 >= 60000）"
    else
      echo "   !! fd 上限抬不到 60000（软 $(ulimit -Sn) / 硬 $(ulimit -Hn)），BE 打开 storage engine 会失败。"
      echo "      空闲时 sr down && sr up 重建容器（新容器带 --ulimit nofile=655350）。"
    fi
    UTLOG=${LOGF%.log}.ut.log
    echo ""
    echo "== 开始跑单测: ./run-be-ut.sh ${RARGS[*]}"
    echo "   (它会先再过一遍 maven/gensrc/cmake，ninja 应无事可做，约 1 分钟后进入测试；输出同时记到 $UTLOG)"
    US=$(date +%s)
    # Use run_build's separate process group and signal forwarding for tests too.
    # A foreground pipeline delays Bash traps and would leave cancellation without
    # a known group to stop after phase one cleared BPGID.
    : > "$UTLOG"; chmod 666 "$UTLOG" 2>/dev/null
    RB_OUT=$UTLOG run_build "${RARGS[@]}"; URC=$RC
    UE=$(date +%s)
    printf "\n== 单测结束 rc=%d 用时 %dm%02ds  日志 %s ==\n" "$URC" $(( (UE-US)/60 )) $(( (UE-US)%60 )) "$UTLOG"
    exit $URC
  fi
  OUT=$SR/output/be
  BIN=$OUT/lib/starrocks_be
  echo " BE 产物: $OUT"
  if [ -f "$BIN" ]; then
    # Use mtime to distinguish newly produced artifacts from binaries left by earlier builds.
    AGE=$(( $(date +%s) - $(stat -c %Y "$BIN") ))
    BINFRESH=$([ $AGE -le $((E-S+120)) ] && echo "本次生成" || echo "未更新，仍是 $((AGE/60)) 分钟前那份")
    printf "   %-46s %s  (%s)\n" "lib/starrocks_be" "$(du -h "$BIN"|cut -f1)" "$BINFRESH"
  else
    echo "   !! 没找到 lib/starrocks_be"
  fi
  NJ=$(ls -1 "$OUT/lib/jni-packages/" 2>/dev/null | wc -l)
  [ "$NJ" -gt 0 ] && echo "   lib/jni-packages/                              $NJ 个 jar"
  [ "$NJ" = 0 ] && [ $JAVAEXT = 0 ] && echo "   lib/jni-packages/  (空 —— 用了 --no-java-ext，Hive/Iceberg 等连接器运行时会失败)"
  echo "   bin/ conf/ www/"
fi
exit $RC
