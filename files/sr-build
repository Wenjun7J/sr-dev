#!/bin/bash
# sr-build: accelerated StarRocks BE build driver for use inside the container.
# Default to local Ninja + ccache; use the farm when available and enough work misses cache.
# Defaults are based on measurements; see --why.
set -uo pipefail

# Find the StarRocks root by walking up from PWD and checking build.sh, env.sh, and
# be/src. A fixed path would select the wrong repository when using multiple worktrees.
find_root(){ local d; d=$(pwd -P)   # Use the physical path so symlinks and real paths share one source-tree lock.
  while [ "$d" != / ]; do
    [ -f "$d/build.sh" ] && [ -f "$d/env.sh" ] && [ -d "$d/be/src" ] && { echo "$d"; return 0; }
    d=$(dirname "$d")
  done; return 1; }
FARM_STATE=${FARM_STATE:-/farm/state.env}
# Keep per-source-tree locks on the shared /farm volume so profile containers see
# each other. Serialize builds in one tree because gensrc outputs are shared.
# Different trees may build concurrently; the local iceccd limits local compiler
# slots while the scheduler sends other jobs to the farm.
LOCK=""   # Computed after selecting the source tree below.

# Default local parallelism to the container CPU quota: cgroup v2 cpu.max contains
# quota and period (800000 100000 means 8 CPUs). For max, fall back to nproc.
# A fixed job count can exceed memory limits after the container quota is reduced.
quota_cores(){ local q p; [ -r /sys/fs/cgroup/cpu.max ] && read -r q p < /sys/fs/cgroup/cpu.max 2>/dev/null || { nproc 2>/dev/null; return; }
  [ "$q" = max ] && { nproc 2>/dev/null; return; }; echo $(( (q + p - 1) / p )); }
JDEF=$(quota_cores); case "$JDEF" in ''|*[!0-9]*|0) JDEF=16;; esac
BT=Release ; DIST=auto ; JAVAEXT=1 ; CLEAN=0 ; GEN=ninja ; JLOCAL=$JDEF ; VERBOSE=0 ; CACHE=1   # Recalculate JLOCAL from SR_LOCAL_JOBS after loading configuration.
BTSET=0 ; RUN=0 ; RUNSET=0 ; FEUT=0 ; BPFX="" ; DYNLIB=1 ; DYNPCH="" ; BSCRIPT=build.sh   # DYNLIB defaults BE tests to shared libraries (measured 3.36x faster linking, 1/5 memory); BTSET tracks explicit build type; BSCRIPT selects the upstream driver.
# Calculate LOCALCAP, the persistent local iceccd slot limit, after loading site
# configuration so SR_LOCAL_JOBS from srdev.conf takes effect.
TARGET=all  # be | fe | all | ut | compdb; default all builds BE+FE. --be-ut uses upstream run-be-ut.sh.
usage(){ cat <<'U'
用法: sr-build [源码目录] [选项] [-- 透传给 build.sh 的参数]
  不给源码目录就从当前目录上溯找 StarRocks 根
  --be | --fe | --all            编译目标（默认 all=BE+FE；FE 走原生 maven，不经农场/ccache）
  --be-ut                        编 BE 单测（run-be-ut.sh，产物在 ut_build_<类型>/test/），同样走农场+ccache，编完接着跑
                                 sr 不认识的参数原样交给 run-be-ut.sh，不用写 --：
                                   sr be-ut --test CompactionUtilsTest / --gtest_filter 'A*:B*' / --module storage
                                   sr be-ut --module storage --no-run  （只编不跑）
  --fe-ut                        跑 FE 单测（run-fe-ut.sh，纯 maven，农场和 ccache 都不参与）
                                 同样原样透传给 run-fe-ut.sh：sr fe-ut --test com.starrocks.utframe.Demo
  --compdb                       只生成 compile_commands.json（build.sh --configure-only + 跑一遍代码生成），不编译
  --no-run                       与 --be-ut 搭配：只编不跑（--run 是默认行为，仍可显式写）
  --build-prefix DIR             换一棵构建树（默认 be/nj）。做 A/B 对照时用，免得把实验配置写进主树；
                                 也可用 SR_BUILD_PREFIX。指定的树若已有冲突配置会拒绝而不是覆盖
  --no-dynlib                    BE 单测默认把各模块编成 .so（上游 --with-dynamic），用它关掉、回到静态链接。
                                 为什么默认开：链接实测 408s -> 121s（快 3.36 倍）、anon 峰值 38G -> 7.6G，
                                 而单测不在意运行性能。验收过：树外启动依赖 0 未解析、315 个测试套与静态树完全一致。
                                 产物依赖构建树里的 .so，只适合本机跑单测；默认落在 be/nj-dyn，不碰静态树
  --no-dynlib-pch                .so 模式下 sr 默认给各模块补挂上游漏掉的 PCH（与静态模式同一份 starrocks_pch.h），
                                 用它退回只补 -include vector。也可用 SR_DYNLIB_PCH=0。切换会让该树全部 TU 重编。
                                 实测（1588 TU）：本地编译 PCH 快约 5%（小 TU 最多快 1/3），改 .cpp/改项目头/ccache 命中
                                 都无害；分布式下远端拿不到 .gch，没有收益（单轮略慢，在噪声内）。codex 五轮评审后定的默认。
  --debug | --release | --asan   构建类型（默认 release，单测默认 asan；仅对 be/ut 生效）
  --dist auto|on|off             是否用编译农场（默认 auto）
  --no-java-ext                  跳过 java-extensions（默认构建；跳过则产物缺 jni-packages 等 jar）
  --clean                        清空该类型的构建树后重建
  --make                         回退到 Unix Makefiles（默认 ninja）
  --no-ccache                    绕过 ccache（仅用于做纯编译计时对比）
  --why                          打印各默认值背后的实测依据
U
}
why(){ cat <<'W'
默认值的实测依据（StarRocks main@f2cedbb2c2f，16 核封顶开发机，机内对比）:
  ninja 而非 make      : 全量 2768s -> 1933s (1.43x)，CPU 利用率 56% -> 84%
  ccache sloppiness    : BE 开 WITH_PCH=ON，默认令 78.4% 的编译绕过缓存；
                         解开后回退/切分支场景 1825s -> 392s (4.66x)
  本地并发=容器CPU配额 : 16 核容器时实测 -j16 峰值内存 28.3GB(Debug) / 32.7GB(ASAN)；容器缩到 8c24g 后本地 8 槽
  分布式并发自适应     : worker数×8 + 本地16。写死 48 会在 worker 变化时吃亏
                         纯本地 -j16 1308s -> 4 worker 778s(1.68x) -> 5 worker 678s(1.93x)
  scheduler 放本容器   : 它只占 3.2MB/0.5%CPU（预处理源码和产物都是 client<->worker 直连，
                         不过它），省下的那台机当 worker，32->40 核，快 14.8%
  农场异步唤醒         : 不等那 29 秒，直接按满并发开工，后台边编边判断要不要唤醒；
                         轮询累计 ccache miss，攒够 8 次才唤醒（全命中的编译不吵醒农场）
  客户端 iceccd -m 16  : 预处理只占编译成本 8.8%，无需为它留核；
                         压到 -m4 实测反而慢 44% (820s -> 1180s)
  --dist auto 阈值     : 农场醒着 >50 条边；睡着 >150 条边(唤醒需 29 秒)
                         实测改 1 个 TU 走农场亏 1.9%，改 377 个赚 45%
  默认建 java-extensions: 热 .m2 下仅 5.8 秒，而跳过会导致
                         output/be/lib/jni-packages 缺 jar，Hive/Iceberg 等连接器运行时失败
  链接闸门按 CPU 定    : 2026-09-23 空载实测（16核64G 容器，24 个真实 UT 链接目标，预热后每档两次）
                         24 目标 并发 3: 65s/15G  6: 64s/23G  10: 69s/31G  16: 75s/45G
                         全 56 目标 并发 3: 408s/38G  并发 4: 426s/42G（调大是负收益）
                         并发越高越慢而内存线性涨 —— 并发 3 已吃掉 13.2/16 核(83%)，lld 自身多线程，
                         CPU 是主要瓶颈。内存侧全量串行实测最坏单条 anon 14.70G(starrocks_dw_test，产物 3164M)，
                         与产物大小线性(1MB 产物≈4.7MB anon)；3 条最坏同时跑约 44G/64G，余量很薄，内存也是约束
  mold 不用            : 同组实测并发 3/6/12 墙钟 45.9/47.6/45.3s，几乎不随并发变化(单条就吃满 16 核)，
                         anon 是 lld 的 2.2~2.5 倍。单条虽快(5.1s vs 7.0s)，但构建本身已有链接级并行，优势归零
W
}
PASS=(); SRARG=""
# In BE test mode, pass unrecognized options unchanged to run-be-ut.sh without
# requiring --. Detect this mode first because --be-ut may appear after an option
# whose bare argument would otherwise look like a source directory.
# Stop scanning at --, after which all arguments are forwarded together.
ORIGARGS=("$@")   # Preserve the original arguments to distinguish explicit --dynlib from its default.
UTMODE=0; UTS=""; for a in "$@"; do [ "$a" = -- ] && break
  case "$a" in --be-ut) UTMODE=1; UTS=run-be-ut.sh; break;; --fe-ut) UTMODE=1; UTS=run-fe-ut.sh; break;; esac; done
while [ $# -gt 0 ]; do case "$1" in
  --be) TARGET=be; shift;; --fe) TARGET=fe; shift;; --all) TARGET=all; shift;;
  --be-ut) TARGET=ut; shift;;
  --compdb) TARGET=compdb; shift;;
  --build-prefix) [ $# -ge 2 ] || { echo "!! --build-prefix 需要一个目录" >&2; exit 2; }; BPFX=$2; shift 2;;
  --dynlib) DYNLIB=1; shift;; --no-dynlib) DYNLIB=0; shift;;
  --dynlib-pch) DYNPCH=1; shift;; --no-dynlib-pch) DYNPCH=0; shift;;
  --run) RUN=1; RUNSET=1; shift;; --no-run) RUN=0; RUNSET=1; shift;;
  # Keep TARGET=fe for FE tests so BE-only setup stays disabled: no farm, ccache,
  # PCH, build tree, or dependency stamp changes. Use run-fe-ut.sh and FEUT handling.
  --fe-ut) TARGET=fe; FEUT=1; shift;;
  --debug) BT=Debug; BTSET=1; shift;; --release) BT=Release; BTSET=1; shift;; --asan) BT=ASAN; BTSET=1; shift;;
  --dist) [ $# -ge 2 ] || { echo "!! --dist 需要 auto、on 或 off" >&2; exit 2; }; DIST=$2; case "$DIST" in auto|on|off) ;; *) echo "!! --dist 只接受 auto、on 或 off（收到: ${DIST}）" >&2; exit 2;; esac; shift 2;; --no-java-ext) JAVAEXT=0; shift;;
  --clean) CLEAN=1; shift;; --make) GEN=make; shift;; --no-ccache) CACHE=0; shift;;
  # The -j option was removed: in distributed mode it controls total in-flight
  # Ninja jobs, not local memory use, which is bounded by iceccd -m. Local builds
  # use SR_LOCAL_JOBS, and FE uses its upstream defaults.
  -j|-j[0-9]*) echo "!! -j 已移除：分布式下它管不了本机并发（派几个回本机由 scheduler 决定，上限是 iceccd -m）。"
       echo "   本次本地构建可用 SR_LOCAL_JOBS=<并发> sr ... --dist off；常驻 iceccd/worker 槽位需在空闲时另行调整。"; exit 1;;
  --why) why; exit 0;;
  -h|--help) usage
    # Include upstream test options in help. Upstream usage() exits with 1 and may
    # print Python/Maven banners first, so ignore its status and start at Usage:.
    if [ "$UTMODE" = 1 ] && [ -n "$UTS" ]; then
      HR=$(find_root 2>/dev/null) || HR=""
      if [ -n "$HR" ] && [ -f "$HR/$UTS" ]; then
        echo ""
        echo "以下是上游 $UTS 自己的选项（sr 不认识的参数原样传给它）:"
        ( cd "$HR" && ./"$UTS" --help 2>&1 | sed -n '/^Usage:/,$p' | sed 's/^/  /' )
      else
        echo ""
        echo "（当前目录不在源码树里，或树中没有 ${UTS}，无法列出它的选项）"
      fi
    fi
    exit 0;;
  -v) VERBOSE=1; shift;;
  --) shift; PASS+=("$@"); break;;
  # A directory positional argument selects the source tree in any position.
  # In test mode, require a real source root so values such as --module storage
  # are not mistaken for a source directory just because that subdirectory exists.
  *) if [ -z "$SRARG" ] && [ -d "$1" ] && { [ "$UTMODE" = 0 ] || [ -f "$1/build.sh" ]; }; then
       SRARG=$(cd "$1" && pwd -P); shift   # pwd -P makes symlinks and real paths share the same lock.
     elif [ "$UTMODE" = 1 ]; then PASS+=("$1"); shift
     else echo "未知参数: $1"; usage; exit 1; fi;;
esac; done
# BE tests run after building by default unless --run/--no-run is explicit.
# Use RUNSET for option-conflict checks so the default does not reject FE tests
# or ordinary builds.
[ "$TARGET" = ut ] && [ $RUNSET = 0 ] && RUN=1

# Hold the dependency-root lock through builds and tests, including if the host
# Docker client exits. Build children inherit fd 6; persistent services must close it.
# Pure FE builds do not use thirdparty.
if [ "$TARGET" != fe ] && [ -d /tp ]; then
  { exec 6</tp; } && flock -s 6 || { echo '!! 无法锁定依赖目录'; exit 1; }
  if [ -n "${SR_TPDIGEST_FULL:-}" ]; then
    [[ "$SR_TPDIGEST_FULL" =~ ^[0-9a-f]{64}$ ]] && [ -f "/tp/$SR_TPDIGEST_FULL/.ready" ] \
      || { echo '!! 依赖缓存不可用，请通过宿主 sr 重新解析并提取'; exit 1; }
  fi
fi

# Use an explicit source directory, otherwise walk up from PWD.
if [ -n "$SRARG" ]; then
  SR=$SRARG
  { [ -f "$SR/build.sh" ] && [ -d "$SR/be/src" ]; } || { echo "!! $SR 不像 StarRocks 源码树（缺 build.sh 或 be/src）"; exit 1; }
else
  SR=$(find_root) || { echo "!! 当前目录 $PWD 不在任何 StarRocks 源码树里。"
                       echo "   进到某个 worktree 再跑，或者显式指定：sr build /path/to/starrocks [选项]"; exit 1; }
fi

# Upstream run-be-ut.sh accepts CCACHE, CMAKE_BUILD_PREFIX, BUILD_TYPE,
# STARROCKS_GCC_HOME, and -j, so the same farm/cache/dependency setup applies.
# Its trees are named ut_build_<type> and include source and test compilation.
# Use --dry-run for build-only mode: it builds everything and lists tests without running them.
if [ "$FEUT" = 1 ]; then
  BSCRIPT=run-fe-ut.sh
  [ -f "$SR/$BSCRIPT" ] || { echo "!! $SR 里没有 run-fe-ut.sh，跑不了 FE 单测"; exit 1; }
  [ "$RUNSET" = 1 ] && { echo "!! --run/--no-run 只对 --be-ut 有意义；FE 单测本来就是直接跑"; exit 1; }
elif [ "$TARGET" = compdb ]; then
  # Configure only to produce compile_commands.json; no compilation or farm is needed.
  DIST=off
  grep -q CMAKE_BUILD_PREFIX "$SR/build.sh" 2>/dev/null || {
    echo "!! 这个分支的 build.sh 不支持 CMAKE_BUILD_PREFIX，compdb 只能和真实构建共用一棵树。"
    echo "   而 --configure-only 会把 WITH_PCH=OFF 写进 CMakeCache，那样下次编译会全量重来，得不偿失。"
    echo "   请改用 sr build --be（编完同样会更新根目录的 compile_commands.json 软链接）。"; exit 1; }
  grep -q '\-\-configure-only' "$SR/build.sh" 2>/dev/null || {
    echo "!! 这个分支的 build.sh 没有 --configure-only，生成不了 compile_commands.json。请用 sr build --be。"; exit 1; }
elif [ "$TARGET" = ut ]; then
  BSCRIPT=run-be-ut.sh
  [ -f "$SR/$BSCRIPT" ] || { echo "!! $SR 里没有 run-be-ut.sh，编不了 BE 单测"; exit 1; }
  [ $BTSET = 1 ] || BT=ASAN     # Match upstream run-be-ut.sh's ASAN default; the main BE still defaults to Release.
elif [ $RUNSET = 1 ]; then echo "!! --run/--no-run 只能和 --be-ut 搭配"; exit 1; fi
# --dynlib applies only to BE tests. Reject an explicit request for another target,
# but silently disable the default for regular BE/FE builds: release artifacts
# must not depend on the test shared-library layout.
if [ "$TARGET" != ut ]; then
  case " ${ORIGARGS[*]-} " in *" --dynlib "*) echo "!! --dynlib 只能和 --be-ut 搭配（BE 主程序要发布，产物不能依赖一堆 .so）"; exit 1;; esac
  DYNLIB=0
fi
LOCK=/farm/sr-build.$(printf %s "$SR" | md5sum | cut -c1-12).lock
command -v flock >/dev/null && exec 9>$LOCK && flock -n 9 || {
  echo "!! 这棵源码树已有构建在进行：$SR"
  echo "   同一棵树的 gensrc 产物是共享的，并发会互相覆盖，故串行。"
  echo "   等它结束，或换一棵 worktree（不同树可以并行）。"; exit 1; }
chmod 666 $LOCK 2>/dev/null
printf '%s\n' "$SR" > "$LOCK.tree" 2>/dev/null; chmod 666 "$LOCK.tree" 2>/dev/null
# Publish dependency records only after acquiring the source-tree lock; rejected concurrent builds must not change IDE references.
if [ -n "${SR_VERSION_KEY:-}" ]; then
  [[ "$SR_VERSION_KEY" =~ ^[0-9a-f]{12}$ ]] && [[ "${SR_TPDIGEST_FULL:-}" =~ ^[0-9a-f]{64}$ ]] \
    || { echo '!! 非法的依赖版本记录'; exit 1; }
  mkdir -p /farm/versions || exit 1
  VTMP=$(mktemp /farm/versions/.version.XXXXXX) || exit 1
  if ! { printf '%s %s\n' "$SR_VER" "$SR_TPDIGEST_FULL" > "$VTMP" && chmod 644 "$VTMP" && mv -f "$VTMP" "/farm/versions/$SR_VERSION_KEY"; }; then
    rm -f "$VTMP"; echo '!! 发布依赖版本记录失败'; exit 1
  fi
fi

export STARROCKS_HOME=$SR
# Use separate build trees when supported by the upstream script. Older branches
# may ignore CMAKE_BUILD_PREFIX, which would otherwise make tree reporting, edge
# counts, and --clean point at the wrong directory.
if grep -q CMAKE_BUILD_PREFIX "$SR/$BSCRIPT" 2>/dev/null; then
  # Ninja and Make cannot share a CMake build directory. Give each generator a
  # separate prefix when supported; upstream still appends build_$BT below it.
  export CMAKE_BUILD_PREFIX=$SR/be/nj; [ "$GEN" = make ] && export CMAKE_BUILD_PREFIX=$SR/be/nj-make
  # Use a separate compdb tree: build.sh --configure-only forces WITH_PCH=OFF in
  # CMakeCache. Running it in the real build tree would change every compile command
  # and trigger a full rebuild with cache misses.
  [ "$TARGET" = compdb ] && export CMAKE_BUILD_PREFIX=$SR/be/nj-compdb
  # Allow --build-prefix / SR_BUILD_PREFIX to isolate experimental configurations.
  # Resolve relative paths from the source root, not PWD. Dynamic and static test
  # outputs are incompatible, so --dynlib gets a separate default tree.
  # An explicit --build-prefix takes precedence.
  [ $DYNLIB = 1 ] && [ -z "$BPFX" ] && [ -z "${SR_BUILD_PREFIX:-}" ] && BPFX=$SR/be/nj-dyn
  BPFX=${BPFX:-${SR_BUILD_PREFIX:-}}
  if [ -n "$BPFX" ]; then
    case "$BPFX" in /*) ;; *) BPFX=$SR/$BPFX;; esac
    export CMAKE_BUILD_PREFIX=$BPFX
    echo "   构建树改用 $BPFX（--build-prefix / SR_BUILD_PREFIX）"
  fi
  TREE_BASE=$CMAKE_BUILD_PREFIX
else
  TREE_BASE=$SR/be                          # Older branches require their native path; generator isolation is unavailable (see conflict checks below).
  TREE_NOTE="  (该分支 $BSCRIPT 不支持 CMAKE_BUILD_PREFIX，用原生位置)"
fi
# Upstream build.sh uses CCACHE as CMAKE_CXX_COMPILER_LAUNCHER. Set ccache as the
# launcher and CCACHE_PREFIX=icecc so caching and distributed compilation compose.
# ccache-pch also writes .gch.sum for pch_external_checksum; see its header comment.
if [ $CACHE = 1 ]; then export CCACHE=/usr/local/bin/ccache-pch; else export CCACHE=/usr/local/bin/cxxlaunch; export CCACHE_DISABLE=1; fi
export CCACHE_DIR=${SR_CCACHE_DIR:-/ccache}   # SR_CCACHE_DIR selects a separate cache for controlled comparisons.
# Make cache keys independent of checkout location by using the source root as
# base_dir. ccache hashes and passes relative source, include, and PCH paths to the
# compiler. thirdparty and GCC stay at shared absolute paths outside the source tree.
# A same-commit build at a different path hit 1639/1640 remote entries in 1m28s.
export CCACHE_BASEDIR=$SR
# Optional remote cache: SR_CCACHE_REMOTE_BUCKET enables the container's OSS HTTP
# proxy. Local hits avoid the network; remote hits populate the local cache.
# Derive the proxy port from UID and use each user's OSS credentials via SR_OSSCFG.
# Measured full-main builds: remote hits with an empty local cache took 1m51s,
# local hits 1m32s, and compilation 8-11 minutes; one Debug baseline used 3.2 GB.
# Prefer synchronized /farm/srdev.conf. The legacy /etc/srdev.conf file mount can
# pin a stale inode after edits and is only a compatibility fallback.
# Preserve nonempty concurrency overrides from the host across this source operation.
SR_BUILD_OVERRIDES=()
for sr_build_var in SR_LOCAL_JOBS SR_FE_UT_JOBS SR_LINK_JOBS SR_LINK_MEM_GB; do
  [ -z "${!sr_build_var:-}" ] || SR_BUILD_OVERRIDES+=("$sr_build_var=${!sr_build_var}")
done
SRCONF=/farm/srdev.conf; [ -f "$SRCONF" ] || SRCONF=/etc/srdev.conf
[ -f "$SRCONF" ] && { set -a; . "$SRCONF"; set +a; }
for sr_build_override in ${SR_BUILD_OVERRIDES[@]+"${SR_BUILD_OVERRIDES[@]}"}; do export "$sr_build_override"; done
unset SR_BUILD_OVERRIDES sr_build_var sr_build_override
# Calculate the persistent iceccd slot cap after loading configuration. It takes
# effect at daemon startup; do not restart a daemon used by other builds to change it.
# Use the same value for local Ninja jobs and the local share of distributed jobs,
# so SR_LOCAL_JOBS controls both. Invalid values fall back to 16.
# Normalize decimal values before checking positivity so 00 cannot become -m 0.
LOCALCAP=${SR_LOCAL_JOBS:-$JDEF}
case "$LOCALCAP" in ''|*[!0-9]*) LOCALCAP=$JDEF;; *) LOCALCAP=$((10#$LOCALCAP)); [ "$LOCALCAP" -gt 0 ] || LOCALCAP=$JDEF;; esac
JLOCAL=$LOCALCAP
# Default FE test parallelism to the local job count, with a separate override
# because each Maven reactor thread may fork another test JVM. Invalid values
# fall back to JLOCAL.
FEUTJ=${SR_FE_UT_JOBS:-$JLOCAL}
case "$FEUTJ" in ''|*[!0-9]*) FEUTJ=$JLOCAL;; *) FEUTJ=$((10#$FEUTJ)); [ "$FEUTJ" -gt 0 ] || FEUTJ=$JLOCAL;; esac
# Give link edges a separate Ninja pool injected by cmake-linkpool. Linking does
# not pass through icecc, so total distributed parallelism cannot safely limit
# local linker memory. Compute the pool after configuration; SR_LINK_JOBS overrides it.
MEMGB=$(cat /sys/fs/cgroup/memory.max 2>/dev/null)
case "$MEMGB" in ''|max|*[!0-9]*) MEMGB=$(free -g 2>/dev/null | awk '/^Mem:/{print $2}');; *) MEMGB=$(( MEMGB / 1073741824 ));; esac
# Link benchmarks on a 16-CPU/64-GB container, after warming caches, showed little
# benefit from more concurrent multithreaded lld processes:
#   24 targets, jobs 3: 65.1/64.6s, anon 14.9/15.1 GB
#               jobs 6: 62.8/65.8s, anon 23.0/22.7 GB
#              jobs 10: 69.0/68.8s, anon 31.2/30.4 GB
#              jobs 16: 75.6/74.5s, anon 44.2/45.7 GB
