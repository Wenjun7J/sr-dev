#!/bin/bash
# CMAKE_CXX_COMPILER_LAUNCHER used instead of ccache-pch with --no-ccache.
# USE_ICECC=1 sends compilations to the icecc farm.
#
# Delete the matching .sum before regenerating PCH. With pch_external_checksum,
# ccache identifies PCH by <gch>.sum rather than .gch bytes. This launcher does not
# write checksums; retaining an old one could silently reuse invalid objects when
# ccache is enabled again. Abort if removal fails.
out=""; prev=""
for a in "$@"; do [ "$prev" = -o ] && out=$a; prev=$a; done
case " $* " in
  *" -x c++-header "*|*" -x c-header "*) ispch=1;;
  *) case "$out" in *.gch) ispch=1;; *) ispch=0;; esac;;
esac
if [ "$ispch" = 1 ] && [ -n "$out" ] && [ -e "$out.sum" ]; then
  rm -f -- "$out.sum" || { echo "cxxlaunch: 删不掉旧的 $out.sum，中止（留着它会让后续 ccache 按错误的校验和命中）" >&2; exit 1; }
fi
if [ "${USE_ICECC:-0}" = "1" ]; then
  exec icecc "$@"
else
  exec "$@"
fi
