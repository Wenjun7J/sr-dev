# Site configuration: copy to srdev.conf and fill in local values. Never commit it.
# The host sr sources this file and copies it to ~/farm/srdev.conf (0600) on each call;
# container helpers read /farm/srdev.conf, so changes do not require a container rebuild.
# A single-file bind mount would retain the old inode when an editor replaces the file.

# Image sources
SR_BASE_IMAGE=REGISTRY_HOST:5000/starrocks/toolchains-ubuntu:main-20260707   # Base for sr image: the official toolchains image, not dev-env.
SR_APT_MIRROR=                     # Optional replacement for archive.ubuntu.com, e.g. mirrors.cloud.aliyuncs.com; empty keeps the default.
# SR_REGISTRIES=/path/to/registries.conf   # Version lookup table; defaults to registries.conf beside sr.
# SR_TP_REPO=REGISTRY_HOST:5000/starrocks/dev-env-ubuntu   # Temporary override: bypass registries.conf; remove to restore normal lookup.

# Host settings
SR_TPDIR=/srv/srdev/thirdparty     # Host-wide thirdparty cache keyed by digest; falls back to ~/thirdparty if not writable.
# CPUS=16                           # Container CPU limit.
# MEM=64g                           # Container memory limit.
# IMG=my-sr-dev:custom              # Optional image; defaults to sr-dev:<build-input fingerprint>.

# Compilation farm: cloud nodes provisioned by sr farm init.
SR_NODE_USER=sr                    # SSH user on worker nodes.
SR_NODE_PASSWORD=                  # Initial SSH password, used only to install the dedicated ~/farm/ssh/id_farm key.
WORKERS=5                          # Total machines requested, including the platform's FE node; all serve as workers.
# SR_LOCAL_JOBS=8                   # Local iceccd -m limit and Ninja share; defaults to the container CPU quota.
                                   # Ninja reads this on every build; a running iceccd only reads -m at startup. User-level -j is removed.
                                   # Nonempty SR_LOCAL_JOBS / SR_FE_UT_JOBS / SR_LINK_JOBS / SR_LINK_MEM_GB environment values override this file.
                                   # Example: SR_LOCAL_JOBS=6 SR_LINK_JOBS=1 sr -v main be-ut --dist off; no config edit or rebuild needed.
# SR_FE_UT_JOBS=8                   # Maven -T for FE tests; defaults to SR_LOCAL_JOBS and controls reactor concurrency.
                                   # The number of test JVMs also depends on Surefire fork settings; it is not equal to reactor concurrency.
# SR_DYNLIB_PCH=1                   # Add PCH in BE shared-library tests (1), or only -include vector (0); about 5% faster locally in the benchmark.
                                   # No distributed-build benefit was observed. Changing this rebuilds all TUs; --[no-]dynlib-pch takes precedence.
# SR_FE_HEAP=2g                     # FE heap for sr deploy; the upstream 8g default competes with builds.
# SR_PORT_BASE=28000                # FE/BE base; new deployments use 24000+(uid%300)*20, existing ones retain saved ports.
# SR_FE_DEBUG_PORT=28008            # FE debugger defaults to base+8; starlet uses base+9.
# SR_LINK_JOBS=2                    # min(CPU quota/5, (memory GiB-5)/SR_LINK_MEM_GB), clamped to 1..8.
# SR_LINK_MEM_GB=15                 # Historical estimate per linker, not a hard bound; warn and run serially if even one does not fit.
# SR_CC_LINK=0                      # Disable the source-root compile_commands.json symlink; enabled by default for clangd.

# Ports derive from UID modulo arithmetic. UIDs differing by 250 can collide on
# SPORT; differences of 500 can collide on DPORT and the cache proxy.
# sr farm init reports conflicts; use these overrides to assign distinct ports.
# SPORT=18740                        # icecc scheduler; SPORT+1 is its text management port.
# DPORT=19740                        # Local iceccd.
# SR_CCACHE_PROXY_PORT=20740         # OSS-backed ccache proxy.

# sr pack creates a tar.gz matching the official daily-build layout and can upload
# it to OSS using the user's ~/.ossutilconfig credentials.
# SR_PKG_BUCKET=<bucket-name>        # Required for --upload; local packaging works without it.
# SR_PKG_PREFIX=packages/main/Release/  # Object prefix; include the trailing slash.
# SR_PKG_DIR=/path/to/pkg            # Defaults to ~/pkg; allow space for packages larger than 4 GB.
ITYPE=8c32g                        # Instance type identifier recognized by the platform.
# SR_NODE_JOBS=                     # Per-worker icecc -m; total concurrency is worker count times this value plus local capacity.
                                   # Empty derives the limit from each node's CPU count. Reduce it on memory-limited
                                   # nodes: ASAN can use about 2 GB per slot, so six slots are safer than eight on 8c16g.
                                   # Recreate the farm with sr farm down/init after changing this setting.
# TSP_REGION=cn-zhangjiakou         # Platform provisioning parameters.
# TSP_CSP=aliyun

# Optional remote ccache: setting a bucket enables it. Query remote storage after
# a local miss and populate the local cache on a remote hit; users share one prefix.
# Credentials come from ~/.ossutilconfig. The proxy runs in the container on a UID-derived port.
# Cross-host PCH reuse requires the .sum hashing enabled by pch_external_checksum.
# SR_CCACHE_REMOTE_BUCKET=<bucket-name>  # Use the ossutil endpoint, preferably its internal address.
# SR_CCACHE_REMOTE_PREFIX=ccache/         # Prefix inside the bucket.
