# srdev 站点配置。复制为 srdev.conf 按环境填写；srdev.conf 在 .gitignore 里，不要提交。
# 宿主机的 sr 直接 source 它，并在每次调用时把它同步为 ~/farm/srdev.conf（0600），容器内的 sr-build/sr-farm 读 /farm/srdev.conf——
# 所以改完立刻生效，不用重建容器。（早先是把文件 bind mount 到 /etc/srdev.conf：单文件挂载钉 inode，编辑器保存后容器读到的仍是旧内容。）

## 镜像来源
SR_BASE_IMAGE=REGISTRY_HOST:5000/starrocks/toolchains-ubuntu:main-20260707   # sr image 的 base：官方 toolchains 镜像（不是 dev-env）
SR_APT_MIRROR=                     # 建镜像/装节点时替换 archive.ubuntu.com 的源，如 mirrors.cloud.aliyuncs.com；留空不换
#SR_REGISTRIES=/path/to/registries.conf   # 版本号解析表，默认与 sr 同目录的 registries.conf
#SR_TP_REPO=REGISTRY_HOST:5000/starrocks/dev-env-ubuntu   # 临时开关：非空则忽略 registries.conf，一律用这个仓库解析依赖镜像（某命名空间发布断了时用；撤销即删）

## 宿主机
SR_TPDIR=/srv/srdev/thirdparty     # 各版本 thirdparty 的公共目录（按 digest 存、全机共享）；不可写时退回 ~/thirdparty
#CPUS=16                           # 容器 CPU 限额
#MEM=32g                           # 容器内存限额
#IMG=sr-dev:single                 # 镜像名

## 编译农场（sr farm init 申请的云上节点）
SR_NODE_USER=sr                    # 节点上的 ssh 用户
SR_NODE_PASSWORD=                  # 节点初始密码，仅首次铺 ssh 密钥用；之后全走专用密钥 ~/farm/ssh/id_farm
WORKERS=5                          # 申请的机器总数（全部当 worker；平台自带的 1 台 FE 也算在内，写 5 就开 5 台）
#SR_LOCAL_JOBS=16                  # 常驻本机 iceccd 的并发上限（全局、只在首次启动生效）。单次构建限本机内存请用 sr build -j N（总并发上限）
ITYPE=8c32g                        # 节点规格（平台侧的名字）
#SR_NODE_JOBS=                     # 每台 worker 的编译并发（icecc -m，也决定总 -j=台数×此值+本地）。
                                   # 留空=按节点实际 CPU 核数自动定；内存受限时压低（8c16g 编 ASAN 每槽~2G，
                                   # 8 并发超 16G，设 6 更稳）。改了要 sr farm down 再 init 才生效。
#TSP_REGION=cn-zhangjiakou         # 平台申请参数
#TSP_CSP=aliyun

## ccache 远端（可选）：配了桶名即启用。本地 miss 才查远端、命中回填本地；所有人共享同一前缀。
## 凭据用各人自己的 ~/.ossutilconfig（ossutil 的配置），代理随容器起，端口按 uid。
## 能跨机共享的前提是 PCH 走 .sum 哈希（ccache.conf 已开 pch_external_checksum）。
#SR_CCACHE_REMOTE_BUCKET=<桶名>       # 与 ossutil 配置同一 endpoint（建议内网端点）
#SR_CCACHE_REMOTE_PREFIX=ccache/       # 桶内前缀
